{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jxsuite.com/schemas/connector/TableInsert.class.json",
  "title": "TableInsert",
  "description": "Insert action: POST a row to /_jx/data/<table> from a form submit (FormData merged under literal values); lowered to an inline Function handler in compiled sites",
  "$prototype": "Class",
  "extends": "Object",
  "$implementation": "./table-insert.js",

  "$studio": {
    "stateDefaults": { "timing": "client" }
  },

  "$defs": {
    "parameters": {
      "table": {
        "identifier": "table",
        "type": { "type": "string" },
        "description": "Name of a `data` section table"
      },
      "values": {
        "identifier": "values",
        "type": { "type": "object" },
        "description": "Literal payload columns merged over the submitting form's FormData"
      }
    },
    "constructor": {
      "role": "constructor",
      "parameters": [
        { "$ref": "#/$defs/parameters/table" },
        { "$ref": "#/$defs/parameters/values" }
      ],
      "body": ["this.config = config;"]
    },
    "methods": {
      "resolve": {
        "role": "method",
        "scope": "instance",
        "identifier": "resolve",
        "returnType": { "type": "object" },
        "description": "An event handler performing the insert and bumping state._v"
      },
      "lower": {
        "role": "lower",
        "$prototype": "Function",
        "access": "public",
        "scope": "static",
        "identifier": "lower",
        "timing": ["compiler"],
        "parameters": [
          { "identifier": "def", "type": { "type": "object" } },
          { "identifier": "context", "type": { "type": "object" } }
        ],
        "returnType": { "type": "object" },
        "description": "Rewrite into an inline Function def fetching POST /_jx/data/<table>"
      }
    }
  }
}
