{
  "name": "@jxsuite/parser",
  "version": "0.31.1",
  "description": "Jx markdown parser and external class integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/parser"
  },
  "files": [
    "src/",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/md.ts",
    "./content": "./src/content.ts",
    "./markdown": "./src/markdown.ts",
    "./csv": "./src/csv.ts",
    "./serialize": "./src/serialize.ts",
    "./ContentCollection.class.json": "./src/ContentCollection.class.json",
    "./ContentEntry.class.json": "./src/ContentEntry.class.json",
    "./MarkdownCollection.class.json": "./src/MarkdownCollection.class.json",
    "./Markdown.class.json": "./src/Markdown.class.json",
    "./Csv.class.json": "./src/Csv.class.json",
    "./transpile": "./src/transpile.ts",
    "./html-to-jx": "./src/html-to-jx.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepare": "bun build src/content.ts src/markdown.ts src/csv.ts src/serialize.ts --outdir=dist --format=esm --target=node",
    "build": "bun run prepare",
    "build:metafile": "bun build src/content.ts src/markdown.ts src/csv.ts src/serialize.ts --outdir=dist --format=esm --target=node --metafile=metafile.json",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bunx npm-check-updates -u && bun install"
  },
  "dependencies": {
    "@jxsuite/schema": "workspace:^",
    "glob": "^13.0.6",
    "hast-util-from-html": "^2.0.3",
    "hast-util-whitespace": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "property-information": "^7.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-parse-frontmatter": "^1.0.3",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@jxsuite/runtime": "workspace:^",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4"
  }
}
