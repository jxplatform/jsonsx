{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentCollection",
  "description": "Query a project content type with filter, sort, and limit",
  "$prototype": "Class",
  "extends": "Object",
  "$implementation": "../dist/content.js",

  "$defs": {
    "parameters": {
      "contentType": {
        "identifier": "contentType",
        "type": { "type": "string", "enum": { "$ref": "#/$context/contentTypes" } },
        "description": "Content type to query"
      },
      "filter": {
        "identifier": "filter",
        "type": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": { "$ref": "#/$context/contentTypes/{@contentType}/schema/properties" }
              },
              "op": {
                "type": "string",
                "enum": [
                  "==",
                  "!=",
                  ">",
                  "<",
                  ">=",
                  "<=",
                  "contains",
                  "not contains",
                  "empty",
                  "not empty"
                ]
              },
              "value": {}
            },
            "required": ["field", "op"]
          }
        },
        "description": "Filter rules"
      },
      "sort": {
        "identifier": "sort",
        "type": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "enum": { "$ref": "#/$context/contentTypes/{@contentType}/schema/properties" }
              },
              "order": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
            },
            "required": ["field"]
          }
        },
        "description": "Sort rules"
      },
      "limit": {
        "identifier": "limit",
        "type": { "type": "integer", "minimum": 1, "default": null },
        "description": "Maximum entries to return"
      }
    },

    "fields": {
      "config": {
        "role": "field",
        "access": "private",
        "scope": "instance",
        "identifier": "config",
        "type": { "type": "object" },
        "description": "Raw configuration object passed to the constructor"
      }
    },

    "constructor": {
      "role": "constructor",
      "$prototype": "Function",
      "parameters": [
        { "$ref": "#/$defs/parameters/contentType" },
        { "$ref": "#/$defs/parameters/filter" },
        { "$ref": "#/$defs/parameters/sort" },
        { "$ref": "#/$defs/parameters/limit" }
      ],
      "body": ["this.config = config;"],
      "description": "Stores the configuration for deferred resolution"
    },

    "methods": {
      "resolve": {
        "role": "method",
        "$prototype": "Function",
        "access": "public",
        "scope": "instance",
        "identifier": "resolve",
        "parameters": [],
        "returns": { "type": "array" },
        "description": "Query the content type entries with filter, sort, and limit"
      }
    }
  }
}
