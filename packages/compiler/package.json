{
  "name": "@jxsuite/compiler",
  "version": "4.0.0",
  "description": "Jx static HTML compiler, island detector, and site builder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/compiler"
  },
  "bin": {
    "jx": "./bin/jx.js"
  },
  "files": [
    "bin/",
    "src/",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/compiler.ts",
    "./asset-mounts": "./src/site/asset-mounts.ts",
    "./format-host": "./src/site/format-host.ts",
    "./project-sections": "./src/site/project-sections.ts",
    "./schema-command": "./src/site/schema-command.ts",
    "./context-injection": "./src/site/context-injection.ts",
    "./head-merger": "./src/site/head-merger.ts",
    "./layout-resolver": "./src/site/layout-resolver.ts",
    "./pages-discovery": "./src/site/pages-discovery.ts",
    "./site": "./src/site/site-build.ts",
    "./site-loader": "./src/site/site-loader.ts",
    "./types": "./src/types.ts",
    "./db-push": "./src/site/db-push.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepare": "bun build src/compiler.ts src/cli.ts --outdir=dist --format=esm --minify --target=node",
    "build": "bun run prepare",
    "build:metafile": "bun build src/compiler.ts src/cli.ts --outdir=dist --format=esm --minify --target=node --metafile=metafile.json",
    "build:site": "bun src/cli.ts build",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bun update --latest && bun install"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.1",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/runtime": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/site": "workspace:^",
    "@vue/reactivity": "3.5.42",
    "esbuild": "^0.28.2",
    "lit-html": "^3.3.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.2",
    "@jxsuite/connector": "workspace:^",
    "@jxsuite/parser": "workspace:^",
    "@types/mdast": "^4.0.4"
  }
}
