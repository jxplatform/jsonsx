{
  "name": "@jxsuite/runtime",
  "version": "0.28.4",
  "description": "JSON-native reactive web component runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/runtime"
  },
  "files": [
    "src/",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/runtime.ts",
    "./expression": "./src/expression.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build ./src/runtime.ts --outdir dist --target browser --sourcemap=linked",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bunx npm-check-updates -u && bun install"
  },
  "dependencies": {
    "@jxsuite/schema": "workspace:^",
    "@vue/reactivity": "^3.5.38"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2"
  }
}
