{
  "$schema": "./project.schema.json",
  "name": "Content Fixture",
  "content": {
    "docs": {
      "source": "./content/docs/",
      "format": "Markdown",
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": ["title"]
      }
    }
  },
  "extensions": ["@jxsuite/parser"]
}
