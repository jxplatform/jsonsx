{
  "tagName": "main",
  "state": {
    "$docs": {
      "$prototype": "ContentCollection",
      "contentType": "docs",
      "sort": { "field": "order", "order": "asc" }
    }
  },
  "children": [
    {
      "tagName": "h1",
      "children": ["Docs"]
    },
    {
      "tagName": "ul",
      "children": [
        {
          "$prototype": "Array",
          "items": { "$ref": "#/state/$docs" },
          "map": {
            "tagName": "li",
            "children": ["${$map.item.data.title}"]
          }
        }
      ]
    }
  ]
}
