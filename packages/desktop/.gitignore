# Generated by preBuild — do not commit
assets/

# Electrobun build output
build/
artifacts/

# Hutch's generated SDK sysroot — copied out of the pinned Electrobun core archive by
# `electrobun prepare`, replaced whenever the selected release or target changes, and never edited or
# committed. tsconfig.json `paths` point into it; `electrobun/*` imports resolve through it.
.hutch/

# Scratch Hutch writes while running the build hooks and the config loader under Cottontail. Left
# behind after a build, so without this every local build dirties the tree — which `docs:verify`
# refuses to run against.
.cottontail-tmp/

# Scratch project tree that tests/data-session.test.ts builds beside itself. Left behind on a
# failed or interrupted run, so without this it dirties the tree — which docs:verify refuses to
# run against.
tests/__test-data-session__/
