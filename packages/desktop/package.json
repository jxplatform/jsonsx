{
  "name": "@jxsuite/desktop",
  "version": "0.23.2",
  "description": "Jx Studio — standalone desktop application built with Electrobun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "scripts": {
    "build": "bunx electrobun build",
    "build:msix": "bunx electrobun build --env=stable && bun run scripts/build-msix.ts",
    "build:release": "bunx electrobun build --env=canary",
    "build:stable": "bunx electrobun build --env=stable && bun run scripts/build-msi.ts",
    "chromium": "bun run scripts/pre-build-rpc.ts && bun run src/chromium/index.ts",
    "dev": "bunx electrobun dev",
    "sign:cert": "bun run scripts/sign-cert.ts",
    "sign:trust": "powershell -ExecutionPolicy Bypass -File scripts/trust-cert.ps1",
    "upgrade": "bunx npm-check-updates -u && bun install",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@anthropic-ai/sdk": "^0.100.1",
    "@jxsuite/server": "workspace:^",
    "@jxsuite/studio": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dbus-ts": "^0.0.7",
    "electrobun": "latest",
    "lit-html": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jxsuite/server": "workspace:^",
    "rcedit": "^5.0.2"
  }
}
