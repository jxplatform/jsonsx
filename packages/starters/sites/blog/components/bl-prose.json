{
  "tagName": "bl-prose",
  "style": {
    "display": "block",
    "fontFamily": "var(--font-body)",
    "fontSize": "1.2rem",
    "lineHeight": "1.8",
    "color": "var(--color-text-primary)",
    "& p": {
      "margin": "0 0 1.5rem"
    },
    "& > p:first-of-type::first-letter": {
      "float": "left",
      "fontFamily": "var(--font-heading)",
      "fontWeight": "900",
      "fontSize": "4.6rem",
      "lineHeight": "0.78",
      "paddingRight": "0.7rem",
      "paddingTop": "0.35rem",
      "color": "var(--color-primary)"
    },
    "& h2": {
      "fontFamily": "var(--font-heading)",
      "fontSize": "1.9rem",
      "fontWeight": "700",
      "lineHeight": "1.15",
      "letterSpacing": "-0.015em",
      "margin": "3rem 0 1rem"
    },
    "& h3": {
      "fontFamily": "var(--font-heading)",
      "fontSize": "1.45rem",
      "fontWeight": "600",
      "margin": "2.25rem 0 0.85rem"
    },
    "& a": {
      "color": "var(--color-primary)",
      "textDecoration": "underline",
      "textUnderlineOffset": "3px",
      "textDecorationThickness": "1px"
    },
    "& blockquote": {
      "margin": "2.5rem 0",
      "padding": "0.25rem 0 0.25rem 1.75rem",
      "borderLeft": "2px solid var(--color-primary)",
      "fontFamily": "var(--font-heading)",
      "fontStyle": "italic",
      "fontWeight": "400",
      "fontSize": "1.55rem",
      "lineHeight": "1.45",
      "color": "var(--color-text-primary)"
    },
    "& ul": {
      "margin": "0 0 1.5rem",
      "padding": "0 0 0 1.4rem"
    },
    "& ol": {
      "margin": "0 0 1.5rem",
      "padding": "0 0 0 1.4rem"
    },
    "& li": {
      "margin": "0 0 0.5rem"
    },
    "& img": {
      "width": "100%",
      "height": "auto",
      "margin": "2.5rem 0"
    },
    "& strong": {
      "fontWeight": "600"
    },
    "& em": {
      "fontStyle": "italic"
    },
    "& code": {
      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "fontSize": "0.85em",
      "backgroundColor": "var(--color-bg-cream)",
      "padding": "0.15em 0.4em"
    },
    "& hr": {
      "border": "none",
      "borderTop": "1px solid var(--color-border)",
      "width": "4rem",
      "margin": "3rem auto"
    }
  },
  "children": [{ "tagName": "slot" }]
}
