{
  "tagName": "bl-cta",
  "state": {
    "heading": "",
    "text": "",
    "cta": "Subscribe",
    "ctaHref": "/contact/"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-dark)",
    "color": "var(--color-text-white)",
    "padding": "clamp(3.5rem, 8vw, 5.5rem) 1.5rem",
    "textAlign": "center"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "maxWidth": "var(--max-width-narrow)", "margin": "0 auto" },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "clamp(2rem, 5vw, 3.25rem)",
            "fontWeight": "700",
            "lineHeight": "1.05",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontStyle": "italic",
            "fontSize": "1.2rem",
            "lineHeight": "1.6",
            "opacity": "0.8",
            "margin": "0 auto 2rem",
            "maxWidth": "46ch"
          },
          "textContent": "${state.text}"
        },
        {
          "tagName": "a",
          "attributes": { "href": "${state.ctaHref}" },
          "style": {
            "display": "inline-block",
            "color": "var(--color-text-white)",
            "fontFamily": "var(--font-body)",
            "fontSize": "0.82rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.18em",
            "textDecoration": "none",
            "borderBottom": "1.5px solid var(--color-primary)",
            "paddingBottom": "0.35rem",
            "transition": "opacity 0.15s",
            ":hover": { "opacity": "0.65" }
          },
          "textContent": "${state.cta} →"
        }
      ]
    }
  ]
}
