{
  "tagName": "bl-footer",
  "state": {
    "brand": "The Long Field",
    "tagline": "Essays and field notes on design, technology, and the craft of making things well.",
    "email": "hello@thelongfield.co",
    "cadence": "A new essay most Sundays."
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-dark)",
    "color": "var(--color-text-white)",
    "padding": "3.5rem 1.5rem 2rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "2fr 1fr 1fr",
        "gap": "2.5rem",
        "@--md": { "gridTemplateColumns": "1fr" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "1.4rem",
                "fontWeight": "600",
                "marginBottom": "0.75rem"
              },
              "textContent": "${state.brand}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "opacity": "0.75", "maxWidth": "40ch" },
              "textContent": "${state.tagline}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "fontSize": "0.75rem",
                "opacity": "0.6",
                "marginBottom": "0.75rem"
              },
              "textContent": "Read"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none",
                "marginBottom": "0.35rem"
              },
              "textContent": "Writing"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none",
                "marginBottom": "0.35rem"
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none"
              },
              "textContent": "Subscribe"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "fontSize": "0.75rem",
                "opacity": "0.6",
                "marginBottom": "0.75rem"
              },
              "textContent": "Elsewhere"
            },
            {
              "tagName": "p",
              "style": { "margin": "0 0 0.35rem", "opacity": "0.85" },
              "textContent": "${state.email}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "opacity": "0.85" },
              "textContent": "${state.cadence}"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "2.5rem auto 0",
        "paddingTop": "1.5rem",
        "borderTop": "1px solid rgba(255, 255, 255, 0.15)",
        "fontSize": "0.85rem",
        "opacity": "0.6"
      },
      "children": [
        {
          "tagName": "p",
          "style": { "margin": "0" },
          "textContent": "© The Long Field. Built with Jx."
        }
      ]
    }
  ]
}
