{
  "tagName": "bl-masthead",
  "state": {
    "edition": "Field Notes · Vol. IV · Published most Sundays",
    "heading": "The Long Field",
    "subheading": "Slow essays on design, technology, and the craft of making things well — written by hand, one at a time.",
    "colophon": "Est. 2021 · Set in Fraunces & Newsreader · Marren Oda, editor",
    "cta": "Read the latest",
    "ctaHref": "#latest"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-paper)",
    "padding": "clamp(2rem, 5vw, 3.5rem) 1.5rem clamp(2.5rem, 6vw, 4rem)"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "maxWidth": "var(--max-width)", "margin": "0 auto" },
      "children": [
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.25rem",
            "marginBottom": "clamp(1.25rem, 3vw, 2rem)"
          },
          "children": [
            {
              "tagName": "span",
              "style": { "flex": "1", "height": "1px", "backgroundColor": "var(--color-rule)" }
            },
            {
              "tagName": "span",
              "style": {
                "fontFamily": "var(--font-body)",
                "fontSize": "0.74rem",
                "fontWeight": "500",
                "textTransform": "uppercase",
                "letterSpacing": "0.22em",
                "color": "var(--color-text-muted)",
                "textAlign": "center",
                "whiteSpace": "nowrap",
                "@--sm": { "whiteSpace": "normal", "letterSpacing": "0.14em" }
              },
              "textContent": "${state.edition}"
            },
            {
              "tagName": "span",
              "style": { "flex": "1", "height": "1px", "backgroundColor": "var(--color-rule)" }
            }
          ]
        },
        {
          "tagName": "h1",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontWeight": "900",
            "fontSize": "clamp(3.2rem, 15vw, 11rem)",
            "lineHeight": "0.9",
            "letterSpacing": "-0.035em",
            "textAlign": "center",
            "margin": "0",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "div",
          "style": {
            "marginTop": "clamp(1.5rem, 3vw, 2.25rem)",
            "paddingTop": "clamp(1.5rem, 3vw, 2.25rem)",
            "borderTop": "3px double var(--color-rule)",
            "display": "flex",
            "flexDirection": "column",
            "alignItems": "center",
            "gap": "1.1rem"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontStyle": "italic",
                "fontWeight": "400",
                "fontSize": "clamp(1.3rem, 3vw, 1.9rem)",
                "lineHeight": "1.4",
                "textAlign": "center",
                "maxWidth": "30ch",
                "margin": "0",
                "color": "var(--color-text-primary)"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "p",
              "style": {
                "fontFamily": "var(--font-body)",
                "fontSize": "0.76rem",
                "fontWeight": "500",
                "textTransform": "uppercase",
                "letterSpacing": "0.16em",
                "color": "var(--color-text-muted)",
                "textAlign": "center",
                "margin": "0"
              },
              "textContent": "${state.colophon}"
            },
            {
              "tagName": "a",
              "attributes": { "href": "${state.ctaHref}" },
              "style": {
                "marginTop": "0.5rem",
                "fontFamily": "var(--font-body)",
                "fontSize": "0.8rem",
                "fontWeight": "600",
                "textTransform": "uppercase",
                "letterSpacing": "0.16em",
                "color": "var(--color-primary)",
                "textDecoration": "none",
                "borderBottom": "1px solid var(--color-primary)",
                "paddingBottom": "0.15rem",
                "transition": "opacity 0.15s",
                ":hover": { "opacity": "0.6" }
              },
              "textContent": "${state.cta} ↓"
            }
          ]
        }
      ]
    }
  ]
}
