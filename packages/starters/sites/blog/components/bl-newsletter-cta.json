{
  "tagName": "bl-newsletter-cta",
  "state": {
    "eyebrow": "The Sunday Dispatch",
    "heading": "One essay, most Sundays.",
    "text": "Field notes on design, technology, and craft — sent when there's something worth saying. No noise, unsubscribe anytime.",
    "placeholder": "you@example.com",
    "cta": "Subscribe",
    "note": "Demo form — wire it to your email provider in components/bl-newsletter-cta.json."
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-ink)",
    "color": "var(--color-text-white)",
    "padding": "clamp(2.5rem, 6vw, 4rem) clamp(1.5rem, 5vw, 3.5rem)"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "maxWidth": "var(--max-width-narrow)", "margin": "0 auto", "textAlign": "center" },
      "children": [
        {
          "tagName": "p",
          "style": {
            "display": "${state.eyebrow ? 'block' : 'none'}",
            "fontFamily": "var(--font-body)",
            "fontSize": "0.74rem",
            "fontWeight": "500",
            "textTransform": "uppercase",
            "letterSpacing": "0.24em",
            "color": "var(--color-text-white)",
            "opacity": "0.6",
            "margin": "0 0 1.25rem"
          },
          "textContent": "${state.eyebrow}"
        },
        {
          "tagName": "h2",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontWeight": "700",
            "fontSize": "clamp(2rem, 5vw, 3.2rem)",
            "lineHeight": "1.05",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontStyle": "italic",
            "fontSize": "1.2rem",
            "lineHeight": "1.6",
            "opacity": "0.8",
            "margin": "0 auto 2rem",
            "maxWidth": "48ch"
          },
          "textContent": "${state.text}"
        },
        {
          "tagName": "form",
          "attributes": { "action": "#", "method": "post" },
          "style": {
            "display": "flex",
            "gap": "0",
            "maxWidth": "440px",
            "margin": "0 auto",
            "borderBottom": "1.5px solid rgba(246, 241, 231, 0.5)",
            "@--sm": { "flexDirection": "column", "gap": "1rem", "borderBottom": "none" }
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "email",
                "name": "email",
                "placeholder": "${state.placeholder}",
                "required": "true",
                "aria-label": "Email address"
              },
              "style": {
                "flex": "1",
                "padding": "0.75rem 0.25rem",
                "border": "none",
                "borderBottom": "1.5px solid transparent",
                "backgroundColor": "transparent",
                "color": "var(--color-text-white)",
                "fontSize": "1.05rem",
                "fontFamily": "var(--font-heading)",
                "outline": "none",
                "@--sm": {
                  "borderBottom": "1.5px solid rgba(246, 241, 231, 0.5)",
                  "textAlign": "center"
                }
              }
            },
            {
              "tagName": "button",
              "attributes": { "type": "submit" },
              "style": {
                "backgroundColor": "transparent",
                "color": "var(--color-text-white)",
                "padding": "0.75rem 0.5rem",
                "border": "none",
                "fontFamily": "var(--font-body)",
                "fontSize": "0.8rem",
                "fontWeight": "600",
                "textTransform": "uppercase",
                "letterSpacing": "0.16em",
                "cursor": "pointer",
                "whiteSpace": "nowrap",
                "transition": "opacity 0.15s",
                ":hover": { "opacity": "0.6" }
              },
              "textContent": "${state.cta} →"
            }
          ]
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.note ? 'block' : 'none'}",
            "fontSize": "0.75rem",
            "opacity": "0.5",
            "margin": "1.5rem 0 0"
          },
          "textContent": "${state.note}"
        }
      ]
    }
  ]
}
