{
  "tagName": "bl-nav",
  "style": {
    "position": "sticky",
    "top": "0",
    "zIndex": "50",
    "display": "block",
    "backgroundColor": "var(--color-paper)",
    "borderBottom": "1.5px solid var(--color-rule)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "0.55rem 1.5rem",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "gap": "1rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontWeight": "700",
            "fontSize": "1.05rem",
            "letterSpacing": "0.01em",
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "whiteSpace": "nowrap"
          },
          "textContent": "The Long Field"
        },
        {
          "tagName": "nav",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.75rem",
            "fontFamily": "var(--font-body)",
            "fontSize": "0.72rem",
            "fontWeight": "500",
            "textTransform": "uppercase",
            "letterSpacing": "0.16em",
            "@--sm": { "gap": "1.1rem" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/#latest" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "Essays"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "color": "var(--color-primary)",
                "textDecoration": "none",
                "transition": "opacity 0.15s",
                ":hover": { "opacity": "0.65" }
              },
              "textContent": "Subscribe"
            }
          ]
        }
      ]
    }
  ]
}
