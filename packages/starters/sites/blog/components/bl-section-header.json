{
  "tagName": "bl-section-header",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": ""
  },
  "style": {
    "display": "block",
    "maxWidth": "var(--max-width)",
    "margin": "0 auto 2rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "alignItems": "baseline",
        "justifyContent": "space-between",
        "gap": "1.5rem",
        "flexWrap": "wrap",
        "borderBottom": "1.5px solid var(--color-rule)",
        "paddingBottom": "0.9rem"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "clamp(1.7rem, 3.5vw, 2.4rem)",
            "fontWeight": "700",
            "lineHeight": "1.05",
            "letterSpacing": "-0.02em",
            "margin": "0",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "span",
          "style": {
            "display": "${state.eyebrow ? 'block' : 'none'}",
            "fontFamily": "var(--font-body)",
            "fontSize": "0.74rem",
            "fontWeight": "500",
            "textTransform": "uppercase",
            "letterSpacing": "0.18em",
            "color": "var(--color-text-muted)",
            "whiteSpace": "nowrap"
          },
          "textContent": "${state.eyebrow}"
        }
      ]
    },
    {
      "tagName": "p",
      "style": {
        "display": "${state.subheading ? 'block' : 'none'}",
        "fontFamily": "var(--font-heading)",
        "fontStyle": "italic",
        "fontSize": "1.2rem",
        "lineHeight": "1.5",
        "color": "var(--color-text-muted)",
        "margin": "1rem 0 0",
        "maxWidth": "54ch"
      },
      "textContent": "${state.subheading}"
    }
  ]
}
