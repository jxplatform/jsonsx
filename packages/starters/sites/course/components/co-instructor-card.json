{
  "tagName": "co-instructor-card",
  "state": {
    "name": "",
    "role": "",
    "bio": "",
    "image": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "grid",
    "gridTemplateColumns": "auto 1fr",
    "gap": "clamp(1.5rem, 4vw, 2.5rem)",
    "alignItems": "center",
    "maxWidth": "var(--max-width-narrow)",
    "margin": "0 auto",
    "padding": "clamp(1.75rem, 4vw, 2.5rem)",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "boxShadow": "0 12px 40px rgba(15,23,42,0.06)",
    "@--sm": { "gridTemplateColumns": "1fr", "textAlign": "center", "justifyItems": "center" }
  },
  "children": [
    {
      "tagName": "img",
      "attributes": {
        "src": "${state.image}",
        "alt": "${state.name}",
        "loading": "lazy"
      },
      "style": {
        "width": "140px",
        "height": "140px",
        "objectFit": "cover",
        "borderRadius": "50%",
        "border": "4px solid rgba(37,99,235,0.15)",
        "display": "block"
      }
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.5rem",
            "fontWeight": "800",
            "margin": "0 0 0.25rem"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "div",
          "style": {
            "color": "var(--color-primary)",
            "fontWeight": "600",
            "fontSize": "0.95rem",
            "marginBottom": "0.85rem"
          },
          "textContent": "${state.role}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0",
            "color": "var(--color-text-muted)",
            "fontSize": "1rem",
            "lineHeight": "1.7"
          },
          "textContent": "${state.bio}"
        }
      ]
    }
  ]
}
