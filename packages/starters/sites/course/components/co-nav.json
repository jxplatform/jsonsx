{
  "tagName": "co-nav",
  "state": {
    "brand": "Craft & Code Academy"
  },
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "50",
    "backgroundColor": "rgba(255, 255, 255, 0.9)",
    "backdropFilter": "blur(8px)",
    "borderBottom": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "1rem 1.5rem",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "gap": "1.5rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "0.6rem",
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.3rem",
            "fontWeight": "800",
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "letterSpacing": "-0.02em"
          },
          "children": [
            {
              "tagName": "span",
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "justifyContent": "center",
                "width": "1.9rem",
                "height": "1.9rem",
                "borderRadius": "0.55rem",
                "backgroundColor": "var(--color-primary)",
                "color": "var(--color-text-white)",
                "fontSize": "0.95rem",
                "fontWeight": "800"
              },
              "textContent": "</>"
            },
            { "tagName": "span", "textContent": "${state.brand}" }
          ]
        },
        {
          "tagName": "nav",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.75rem",
            "@--sm": { "gap": "1rem" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/curriculum/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.95rem",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "Curriculum"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.95rem",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/enroll/" },
              "style": {
                "display": "inline-block",
                "backgroundColor": "var(--color-primary)",
                "color": "var(--color-text-white)",
                "padding": "0.55rem 1.4rem",
                "borderRadius": "var(--radius)",
                "textDecoration": "none",
                "fontWeight": "700",
                "fontSize": "0.95rem",
                "transition": "background-color 0.15s",
                ":hover": { "backgroundColor": "var(--color-primary-hover)" }
              },
              "textContent": "Enroll"
            }
          ]
        }
      ]
    }
  ]
}
