{
  "tagName": "co-mentor",
  "state": {
    "name": "",
    "role": "",
    "initials": ""
  },
  "style": {
    "display": "flex",
    "alignItems": "center",
    "gap": "0.95rem",
    "padding": "1.1rem 1.25rem",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "transition": "border-color 0.15s",
    ":hover": { "borderColor": "var(--color-primary-light)" }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "flex": "none",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "3rem",
        "height": "3rem",
        "borderRadius": "0.7rem",
        "backgroundColor": "var(--color-indigo-050)",
        "border": "1px solid var(--color-indigo-line)",
        "color": "var(--color-primary)",
        "fontFamily": "var(--font-mono)",
        "fontWeight": "700",
        "fontSize": "1rem"
      },
      "textContent": "${state.initials}"
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "div",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.02rem",
            "fontWeight": "700",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "div",
          "style": {
            "fontFamily": "var(--font-mono)",
            "fontSize": "0.78rem",
            "color": "var(--color-text-muted)",
            "marginTop": "0.15rem"
          },
          "textContent": "${state.role}"
        }
      ]
    }
  ]
}
