{
  "tagName": "co-footer",
  "state": {
    "brand": "Craft & Code Academy",
    "tagline": "A project-based web development bootcamp with live mentorship and a portfolio-ready capstone.",
    "email": "admissions@craftcode.academy",
    "phone": "(555) 240-7788"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-ink)",
    "color": "var(--color-text-white)",
    "borderTop": "1px solid var(--color-terminal-line)",
    "padding": "3.5rem 1.5rem 2rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "2fr 1fr 1fr",
        "gap": "2.5rem",
        "@--md": { "gridTemplateColumns": "1fr" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.6rem",
                "marginBottom": "0.9rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "width": "1.9rem",
                    "height": "1.9rem",
                    "borderRadius": "0.5rem",
                    "backgroundColor": "var(--color-primary)",
                    "color": "var(--color-text-white)",
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8rem",
                    "fontWeight": "700"
                  },
                  "textContent": "</>"
                },
                {
                  "tagName": "span",
                  "style": {
                    "fontFamily": "var(--font-heading)",
                    "fontSize": "1.3rem",
                    "fontWeight": "800",
                    "letterSpacing": "-0.02em"
                  },
                  "textContent": "${state.brand}"
                }
              ]
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "color": "rgba(255,255,255,0.6)",
                "maxWidth": "40ch",
                "lineHeight": "1.65"
              },
              "textContent": "${state.tagline}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.75rem",
                "color": "var(--color-accent)",
                "marginBottom": "0.9rem"
              },
              "textContent": "// admissions"
            },
            {
              "tagName": "a",
              "attributes": { "href": "mailto:admissions@craftcode.academy" },
              "style": {
                "display": "block",
                "color": "rgba(255,255,255,0.82)",
                "textDecoration": "none",
                "marginBottom": "0.4rem",
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.85rem",
                ":hover": { "color": "var(--color-text-white)" }
              },
              "textContent": "${state.email}"
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "color": "rgba(255,255,255,0.82)",
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.85rem"
              },
              "textContent": "${state.phone}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.75rem",
                "color": "var(--color-accent)",
                "marginBottom": "0.9rem"
              },
              "textContent": "// explore"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/curriculum/" },
              "style": {
                "display": "block",
                "color": "rgba(255,255,255,0.82)",
                "textDecoration": "none",
                "marginBottom": "0.4rem",
                ":hover": { "color": "var(--color-text-white)" }
              },
              "textContent": "Curriculum"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "display": "block",
                "color": "rgba(255,255,255,0.82)",
                "textDecoration": "none",
                "marginBottom": "0.4rem",
                ":hover": { "color": "var(--color-text-white)" }
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/enroll/" },
              "style": {
                "display": "block",
                "color": "rgba(255,255,255,0.82)",
                "textDecoration": "none",
                ":hover": { "color": "var(--color-text-white)" }
              },
              "textContent": "Enroll"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "2.5rem auto 0",
        "paddingTop": "1.5rem",
        "borderTop": "1px solid var(--color-terminal-line)",
        "fontFamily": "var(--font-mono)",
        "fontSize": "0.8rem",
        "color": "rgba(255,255,255,0.5)"
      },
      "children": [
        {
          "tagName": "p",
          "style": { "margin": "0" },
          "children": [
            { "tagName": "span", "style": { "color": "var(--color-accent)" }, "textContent": "$ " },
            { "tagName": "span", "textContent": "echo \"© Craft & Code Academy — built with Jx\"" }
          ]
        }
      ]
    }
  ]
}
