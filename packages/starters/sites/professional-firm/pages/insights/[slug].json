{
  "$layout": "./layouts/article.json",
  "$paths": { "contentType": "insights", "param": "slug", "field": "id" },
  "title": "${state.entry.data.title} — Meridian Advisory",
  "state": {
    "entry": {
      "$prototype": "ContentEntry",
      "$src": "@jxsuite/parser/ContentEntry.class.json",
      "contentType": "insights",
      "field": "id",
      "id": { "$ref": "#/$params/slug" }
    }
  },
  "children": [
    {
      "tagName": "article",
      "children": [
        {
          "tagName": "pf-article-header",
          "$props": {
            "eyebrow": "${state.entry.data.category}",
            "title": "${state.entry.data.title}",
            "date": "${state.entry.data.date}",
            "author": "${state.entry.data.author}",
            "readingTime": "${state.entry._meta.readingTime}"
          }
        },
        {
          "tagName": "div",
          "style": {
            "fontFamily": "var(--font-serif)",
            "fontSize": "1.2rem",
            "lineHeight": "1.8",
            "color": "var(--color-ink)",
            "& p:first-of-type::first-letter": {
              "float": "left",
              "fontFamily": "var(--font-serif)",
              "fontSize": "3.6em",
              "lineHeight": "0.82",
              "fontWeight": "600",
              "padding": "0.02em 0.14em 0 0",
              "color": "var(--color-accent)"
            }
          },
          "children": {
            "$prototype": "Array",
            "items": { "$ref": "#/state/entry/$children" },
            "map": {
              "tagName": "p",
              "style": { "margin": "0 0 1.5rem" },
              "textContent": "${item.textContent}"
            }
          }
        },
        {
          "tagName": "div",
          "style": {
            "marginTop": "2.5rem",
            "paddingTop": "1.5rem",
            "borderTop": "1px solid var(--color-hairline)",
            "fontFamily": "var(--font-sans)",
            "fontSize": "0.78rem",
            "textTransform": "uppercase",
            "letterSpacing": "0.12em",
            "color": "var(--color-muted)"
          },
          "textContent": "Written by ${state.entry.data.author} · Meridian Advisory"
        },
        {
          "tagName": "div",
          "style": {
            "marginTop": "2.5rem",
            "backgroundColor": "var(--color-ink-deep)",
            "color": "var(--color-text-white)",
            "borderTop": "3px solid var(--color-accent)",
            "padding": "2rem",
            "display": "flex",
            "flexWrap": "wrap",
            "alignItems": "center",
            "justifyContent": "space-between",
            "gap": "1.25rem"
          },
          "children": [
            {
              "tagName": "div",
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-serif)",
                    "fontSize": "1.35rem",
                    "fontWeight": "500",
                    "marginBottom": "0.3rem"
                  },
                  "textContent": "Have a question this raised?"
                },
                {
                  "tagName": "div",
                  "style": { "color": "rgba(244,241,233,0.75)", "fontSize": "0.95rem" },
                  "textContent": "Book a free consultation with a Meridian advisor."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "display": "inline-block",
                "backgroundColor": "var(--color-accent)",
                "color": "var(--color-ink-deep)",
                "padding": "0.85rem 1.75rem",
                "fontFamily": "var(--font-sans)",
                "fontSize": "0.76rem",
                "fontWeight": "600",
                "textTransform": "uppercase",
                "letterSpacing": "0.14em",
                "textDecoration": "none",
                "whiteSpace": "nowrap",
                "transition": "background-color 0.15s",
                ":hover": { "backgroundColor": "#b0904c" }
              },
              "textContent": "Book a consultation"
            }
          ]
        }
      ]
    }
  ]
}
