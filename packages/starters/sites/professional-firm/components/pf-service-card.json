{
  "tagName": "pf-service-card",
  "state": {
    "icon": "",
    "title": "",
    "text": "",
    "link": "",
    "linkHref": "/services/"
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "padding": "2rem",
    "backgroundColor": "var(--color-bg-white)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "boxShadow": "0 4px 20px rgba(15,23,42,0.04)",
    "transition": "box-shadow 0.15s, border-color 0.15s",
    ":hover": {
      "boxShadow": "0 12px 32px rgba(15,23,42,0.10)",
      "borderColor": "var(--color-primary)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "width": "3rem",
        "height": "3rem",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "borderRadius": "var(--radius)",
        "backgroundColor": "var(--color-bg-cream)",
        "fontSize": "1.5rem",
        "lineHeight": "1",
        "marginBottom": "1.25rem"
      },
      "textContent": "${state.icon}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.3rem",
        "fontWeight": "600",
        "margin": "0 0 0.6rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65",
        "flex": "1"
      },
      "textContent": "${state.text}"
    },
    {
      "tagName": "a",
      "attributes": { "href": "${state.linkHref}" },
      "style": {
        "display": "${state.link ? 'inline-block' : 'none'}",
        "marginTop": "1.25rem",
        "color": "var(--color-primary)",
        "fontWeight": "600",
        "fontSize": "0.95rem",
        "textDecoration": "none",
        ":hover": { "color": "var(--color-primary-hover)" }
      },
      "textContent": "${state.link}"
    }
  ]
}
