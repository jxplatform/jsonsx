{
  "tagName": "pf-feature",
  "state": {
    "step": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "padding": "1.75rem",
    "backgroundColor": "var(--color-bg-cream)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "${state.step ? 'inline-flex' : 'none'}",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "2.25rem",
        "height": "2.25rem",
        "borderRadius": "999px",
        "backgroundColor": "var(--color-primary)",
        "color": "var(--color-text-white)",
        "fontFamily": "var(--font-heading)",
        "fontWeight": "700",
        "fontSize": "1rem",
        "marginBottom": "1rem"
      },
      "textContent": "${state.step}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.2rem",
        "fontWeight": "600",
        "margin": "0 0 0.5rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
