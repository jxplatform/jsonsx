{
  "tagName": "pf-stat",
  "state": {
    "number": "",
    "label": ""
  },
  "style": {
    "display": "block",
    "textAlign": "center",
    "padding": "1rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "clamp(2.5rem, 5vw, 3.5rem)",
        "fontWeight": "700",
        "lineHeight": "1",
        "letterSpacing": "-0.02em",
        "color": "var(--color-primary)"
      },
      "textContent": "${state.number}"
    },
    {
      "tagName": "div",
      "style": {
        "marginTop": "0.6rem",
        "fontSize": "0.95rem",
        "color": "var(--color-text-muted)",
        "textTransform": "uppercase",
        "letterSpacing": "0.08em"
      },
      "textContent": "${state.label}"
    }
  ]
}
