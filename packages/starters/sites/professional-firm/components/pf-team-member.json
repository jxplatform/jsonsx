{
  "tagName": "pf-team-member",
  "state": {
    "photo": { "type": "string", "format": "image", "default": "" },
    "name": "",
    "role": "",
    "bio": ""
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "overflow": "hidden",
    "boxShadow": "0 4px 20px rgba(15,23,42,0.05)"
  },
  "children": [
    {
      "tagName": "img",
      "attributes": {
        "src": "${state.photo}",
        "alt": "${state.name}",
        "loading": "lazy"
      },
      "style": {
        "width": "100%",
        "aspectRatio": "4 / 5",
        "objectFit": "cover",
        "display": "block"
      }
    },
    {
      "tagName": "div",
      "style": { "padding": "1.5rem" },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.25rem",
            "fontWeight": "600",
            "margin": "0 0 0.2rem"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "div",
          "style": {
            "color": "var(--color-primary)",
            "fontWeight": "600",
            "fontSize": "0.9rem",
            "marginBottom": "0.75rem"
          },
          "textContent": "${state.role}"
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.bio ? 'block' : 'none'}",
            "margin": "0",
            "color": "var(--color-text-muted)",
            "fontSize": "0.95rem",
            "lineHeight": "1.65"
          },
          "textContent": "${state.bio}"
        }
      ]
    }
  ]
}
