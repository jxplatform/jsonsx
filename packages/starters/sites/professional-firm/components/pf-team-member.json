{
  "tagName": "pf-team-member",
  "state": {
    "photo": { "type": "string", "format": "image", "default": "" },
    "name": "",
    "role": "",
    "bio": ""
  },
  "style": {
    "display": "block"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "borderTop": "1px solid var(--color-rule)",
        "paddingTop": "1.25rem"
      },
      "children": [
        {
          "tagName": "img",
          "attributes": {
            "src": "${state.photo}",
            "alt": "${state.name}",
            "loading": "lazy"
          },
          "style": {
            "width": "100%",
            "aspectRatio": "4 / 5",
            "objectFit": "cover",
            "display": "block",
            "filter": "grayscale(1) contrast(1.02)",
            "transition": "filter 0.3s"
          }
        },
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-serif)",
            "fontSize": "1.3rem",
            "fontWeight": "500",
            "margin": "1.1rem 0 0.15rem",
            "color": "var(--color-ink)"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "div",
          "style": {
            "fontFamily": "var(--font-sans)",
            "fontSize": "0.7rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.14em",
            "color": "var(--color-accent)",
            "marginBottom": "0.75rem"
          },
          "textContent": "${state.role}"
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.bio ? 'block' : 'none'}",
            "margin": "0",
            "color": "var(--color-muted)",
            "fontSize": "0.95rem",
            "lineHeight": "1.6"
          },
          "textContent": "${state.bio}"
        }
      ]
    }
  ]
}
