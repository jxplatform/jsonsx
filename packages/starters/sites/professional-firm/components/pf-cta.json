{
  "tagName": "pf-cta",
  "state": {
    "eyebrow": "Consultation",
    "heading": "",
    "text": "",
    "cta": "Book a consultation",
    "ctaHref": "/contact/"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-ink-deep)",
    "color": "var(--color-text-white)",
    "borderTop": "3px solid var(--color-accent)",
    "padding": "clamp(3.5rem, 8vw, 6rem) 1.5rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width-narrow)",
        "margin": "0 auto",
        "textAlign": "center"
      },
      "children": [
        {
          "tagName": "p",
          "style": {
            "display": "${state.eyebrow ? 'block' : 'none'}",
            "fontFamily": "var(--font-sans)",
            "fontSize": "0.72rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.2em",
            "color": "var(--color-accent)",
            "margin": "0 0 1.25rem"
          },
          "textContent": "${state.eyebrow}"
        },
        {
          "tagName": "h2",
          "style": {
            "fontFamily": "var(--font-serif)",
            "fontSize": "clamp(2rem, 4.5vw, 3rem)",
            "fontWeight": "500",
            "lineHeight": "1.14",
            "letterSpacing": "-0.02em",
            "margin": "0 auto 1.25rem",
            "maxWidth": "18ch"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "1.1rem",
            "lineHeight": "1.7",
            "color": "rgba(244,241,233,0.78)",
            "margin": "0 auto 2.25rem",
            "maxWidth": "52ch"
          },
          "textContent": "${state.text}"
        },
        {
          "tagName": "a",
          "attributes": { "href": "${state.ctaHref}" },
          "style": {
            "display": "inline-block",
            "backgroundColor": "var(--color-accent)",
            "color": "var(--color-ink-deep)",
            "padding": "0.9rem 2rem",
            "fontFamily": "var(--font-sans)",
            "fontSize": "0.78rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.14em",
            "textDecoration": "none",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "#b0904c" }
          },
          "textContent": "${state.cta}"
        }
      ]
    }
  ]
}
