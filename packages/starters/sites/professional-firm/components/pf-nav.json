{
  "tagName": "pf-nav",
  "state": {
    "brand": "Meridian",
    "sub": "Advisory"
  },
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "50",
    "backgroundColor": "var(--color-paper)",
    "borderTop": "3px solid var(--color-accent)",
    "borderBottom": "1px solid var(--color-rule)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "0.9rem 1.5rem",
        "display": "flex",
        "alignItems": "baseline",
        "justifyContent": "space-between",
        "gap": "1.5rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "display": "inline-flex",
            "alignItems": "baseline",
            "gap": "0.6rem",
            "textDecoration": "none",
            "color": "var(--color-ink)"
          },
          "children": [
            {
              "tagName": "span",
              "style": {
                "fontFamily": "var(--font-serif)",
                "fontSize": "1.5rem",
                "fontWeight": "600",
                "letterSpacing": "-0.01em",
                "lineHeight": "1"
              },
              "textContent": "${state.brand}"
            },
            {
              "tagName": "span",
              "style": {
                "fontFamily": "var(--font-sans)",
                "fontSize": "0.68rem",
                "fontWeight": "600",
                "textTransform": "uppercase",
                "letterSpacing": "0.28em",
                "color": "var(--color-accent)"
              },
              "textContent": "${state.sub}"
            }
          ]
        },
        {
          "tagName": "nav",
          "style": {
            "display": "flex",
            "alignItems": "baseline",
            "gap": "2rem",
            "fontFamily": "var(--font-sans)",
            "fontSize": "0.72rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.16em",
            "@--sm": { "gap": "1.15rem" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/services/" },
              "style": {
                "color": "var(--color-ink)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-accent)" }
              },
              "textContent": "Practice"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/insights/" },
              "style": {
                "color": "var(--color-ink)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-accent)" }
              },
              "textContent": "Insights"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/team/" },
              "style": {
                "color": "var(--color-ink)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-accent)" }
              },
              "textContent": "People"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "color": "var(--color-ink)",
                "textDecoration": "none",
                "border": "1px solid var(--color-rule)",
                "padding": "0.5rem 0.9rem",
                "transition": "background-color 0.15s, color 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-ink)",
                  "color": "var(--color-paper)"
                }
              },
              "textContent": "Consult"
            }
          ]
        }
      ]
    }
  ]
}
