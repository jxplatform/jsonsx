{
  "tagName": "pf-article-header",
  "state": {
    "eyebrow": "Insight",
    "title": "",
    "date": "",
    "author": "",
    "readingTime": ""
  },
  "style": {
    "display": "block",
    "marginBottom": "clamp(2rem, 4vw, 3rem)"
  },
  "children": [
    {
      "tagName": "p",
      "style": {
        "fontFamily": "var(--font-sans)",
        "textTransform": "uppercase",
        "letterSpacing": "0.2em",
        "fontSize": "0.72rem",
        "fontWeight": "600",
        "color": "var(--color-accent)",
        "paddingBottom": "1rem",
        "borderBottom": "1px solid var(--color-rule)",
        "margin": "0 0 1.5rem"
      },
      "textContent": "${state.eyebrow}"
    },
    {
      "tagName": "h1",
      "style": {
        "fontFamily": "var(--font-serif)",
        "fontSize": "clamp(2.1rem, 5vw, 3.2rem)",
        "fontWeight": "500",
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em",
        "margin": "0 0 1.5rem",
        "color": "var(--color-ink)"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "flexWrap": "wrap",
        "alignItems": "center",
        "gap": "0.6rem",
        "paddingTop": "1.25rem",
        "borderTop": "1px solid var(--color-hairline)",
        "fontFamily": "var(--font-sans)",
        "fontSize": "0.8rem",
        "textTransform": "uppercase",
        "letterSpacing": "0.1em",
        "color": "var(--color-muted)"
      },
      "children": [
        {
          "tagName": "span",
          "style": { "fontWeight": "600", "color": "var(--color-ink)" },
          "textContent": "${state.author}"
        },
        {
          "tagName": "span",
          "style": { "color": "var(--color-hairline)" },
          "textContent": "/"
        },
        {
          "tagName": "span",
          "style": { "fontVariantNumeric": "tabular-nums" },
          "textContent": "${state.date}"
        },
        {
          "tagName": "span",
          "style": {
            "display": "${state.readingTime ? 'inline' : 'none'}",
            "color": "var(--color-hairline)"
          },
          "textContent": "/"
        },
        {
          "tagName": "span",
          "style": {
            "display": "${state.readingTime ? 'inline' : 'none'}",
            "fontVariantNumeric": "tabular-nums"
          },
          "textContent": "${state.readingTime} min read"
        }
      ]
    }
  ]
}
