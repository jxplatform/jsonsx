{
  "$schema": "./project.schema.json",
  "name": "Meridian Advisory",
  "url": "https://example.com",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Meridian Advisory is a boutique CPA and advisory firm for founders and growing companies — tax, assurance, and fractional CFO counsel, published as a quarterly of practical financial thinking."
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.svg"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.googleapis.com"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.gstatic.com",
        "crossorigin": ""
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Archivo:wght@400;500;600;700&display=swap"
      }
    }
  ],
  "$media": {
    "--": "1200px",
    "--lg": "(max-width: 1024px)",
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 640px)"
  },
  "style": {
    "--color-ink": "#161a2c",
    "--color-ink-deep": "#0d101d",
    "--color-navy": "#1d2748",
    "--color-paper": "#f4f1e9",
    "--color-paper-2": "#ece7da",
    "--color-surface": "#fbf9f3",
    "--color-accent": "#9a7b3c",
    "--color-accent-deep": "#7c6230",
    "--color-muted": "#605e55",
    "--color-rule": "#161a2c",
    "--color-hairline": "#d5cdba",
    "--color-primary": "#161a2c",
    "--color-primary-hover": "#242c4a",
    "--color-bg-dark": "#0d101d",
    "--color-bg-cream": "#ece7da",
    "--color-bg-white": "#fbf9f3",
    "--color-text-primary": "#161a2c",
    "--color-text-white": "#f4f1e9",
    "--color-text-muted": "#605e55",
    "--color-border": "#d5cdba",
    "--font-serif": "'Spectral', Georgia, 'Times New Roman', serif",
    "--font-sans": "'Archivo', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "--font-heading": "'Spectral', Georgia, 'Times New Roman', serif",
    "--max-width": "1180px",
    "--max-width-narrow": "720px",
    "--measure": "660px",
    "--radius": "0",
    "margin": "0",
    "padding": "0",
    "fontFamily": "var(--font-sans)",
    "fontSize": "17px",
    "lineHeight": "1.6",
    "color": "var(--color-ink)",
    "backgroundColor": "var(--color-paper)"
  },
  "images": {
    "optimize": true,
    "widths": [320, 640, 960, 1280, 1920],
    "formats": ["webp", "avif"],
    "quality": {
      "webp": 80,
      "avif": 65,
      "jpeg": 80,
      "png": 80
    },
    "sizes": "(max-width: 768px) 100vw, 50vw",
    "lazyLoad": true
  },
  "content": {
    "insights": {
      "source": "./content/insights/",
      "format": "Markdown",
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": ["title", "excerpt", "date"]
      }
    }
  },
  "build": {
    "outDir": "./dist",
    "format": "directory",
    "trailingSlash": "always"
  },
  "extensions": ["@jxsuite/parser"]
}
