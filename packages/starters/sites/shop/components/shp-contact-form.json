{
  "tagName": "shp-contact-form",
  "state": {
    "heading": "Send us a message"
  },
  "style": {
    "display": "block"
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.6rem",
        "margin": "0 0 1.25rem"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Email address",
            "required": "true",
            "aria-label": "Email address"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem"
          }
        },
        {
          "tagName": "div",
          "style": { "display": "grid", "gridTemplateColumns": "1fr 1fr", "gap": "1rem" },
          "children": [
            {
              "tagName": "select",
              "attributes": { "name": "topic", "aria-label": "What can we help with?" },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem",
                "backgroundColor": "var(--color-bg-white)"
              },
              "children": [
                {
                  "tagName": "option",
                  "attributes": { "value": "sales" },
                  "textContent": "Buying a bike"
                },
                {
                  "tagName": "option",
                  "attributes": { "value": "service" },
                  "textContent": "Book a service"
                },
                {
                  "tagName": "option",
                  "attributes": { "value": "fit" },
                  "textContent": "Bike fitting"
                },
                {
                  "tagName": "option",
                  "attributes": { "value": "other" },
                  "textContent": "Something else"
                }
              ]
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "date",
                "name": "date",
                "aria-label": "Preferred service date"
              },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem"
              }
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "3",
            "placeholder": "Tell us about your bike or what you're after…",
            "aria-label": "Notes"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "inherit"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Send Message",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.85rem 1.5rem",
            "border": "none",
            "borderRadius": "999px",
            "fontSize": "1rem",
            "fontWeight": "600",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": { "fontSize": "0.85rem", "color": "var(--color-text-muted)", "margin": "0" },
          "textContent": "This is a demo form. Wire it to your booking provider or email in pages/contact.md."
        }
      ]
    }
  ]
}
