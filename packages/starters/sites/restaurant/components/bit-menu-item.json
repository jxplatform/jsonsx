{
  "tagName": "bit-menu-item",
  "state": {
    "name": "",
    "price": "",
    "description": ""
  },
  "style": {
    "display": "block",
    "padding": "1rem 0",
    "borderBottom": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "justifyContent": "space-between",
        "alignItems": "baseline",
        "gap": "1rem"
      },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.15rem",
            "fontWeight": "600",
            "margin": "0"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "span",
          "style": {
            "fontWeight": "700",
            "color": "var(--color-primary)",
            "whiteSpace": "nowrap"
          },
          "textContent": "${state.price}"
        }
      ]
    },
    {
      "tagName": "p",
      "style": {
        "display": "${state.description ? 'block' : 'none'}",
        "margin": "0.35rem 0 0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.95rem",
        "lineHeight": "1.6",
        "maxWidth": "60ch"
      },
      "textContent": "${state.description}"
    }
  ]
}
