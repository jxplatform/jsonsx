{
  "tagName": "bit-gallery",
  "state": {
    "img1": { "type": "string", "format": "image", "default": "" },
    "img2": { "type": "string", "format": "image", "default": "" },
    "img3": { "type": "string", "format": "image", "default": "" },
    "img4": { "type": "string", "format": "image", "default": "" },
    "alt": "Gallery photo from the restaurant"
  },
  "style": {
    "display": "grid",
    "gridTemplateColumns": "repeat(4, 1fr)",
    "gap": "0.75rem",
    "maxWidth": "var(--max-width)",
    "margin": "0 auto",
    "padding": "0 1.5rem",
    "@--md": { "gridTemplateColumns": "repeat(2, 1fr)" }
  },
  "children": [
    {
      "tagName": "img",
      "attributes": { "src": "${state.img1}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "aspectRatio": "1 / 1",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img2}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "aspectRatio": "1 / 1",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img3}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "aspectRatio": "1 / 1",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img4}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "aspectRatio": "1 / 1",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    }
  ]
}
