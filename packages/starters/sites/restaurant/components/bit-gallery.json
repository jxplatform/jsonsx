{
  "tagName": "bit-gallery",
  "state": {
    "img1": { "type": "string", "format": "image", "default": "" },
    "img2": { "type": "string", "format": "image", "default": "" },
    "img3": { "type": "string", "format": "image", "default": "" },
    "img4": { "type": "string", "format": "image", "default": "" },
    "alt": "Dishes and the dining room"
  },
  "style": {
    "display": "grid",
    "gridTemplateColumns": "1.5fr 1fr 1fr",
    "gridAutoRows": "clamp(150px, 19vw, 250px)",
    "gap": "0.85rem",
    "maxWidth": "var(--max-width-wide)",
    "margin": "0 auto",
    "padding": "0 1.5rem",
    "@--md": {
      "gridTemplateColumns": "1fr 1fr",
      "gridAutoRows": "clamp(150px, 42vw, 230px)"
    }
  },
  "children": [
    {
      "tagName": "img",
      "attributes": { "src": "${state.img1}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "gridColumn": "1",
        "gridRow": "span 2",
        "width": "100%",
        "height": "100%",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block",
        "@--md": { "gridColumn": "1 / 3", "gridRow": "auto" }
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img2}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "height": "100%",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img3}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "width": "100%",
        "height": "100%",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block"
      }
    },
    {
      "tagName": "img",
      "attributes": { "src": "${state.img4}", "alt": "${state.alt}", "loading": "lazy" },
      "style": {
        "gridColumn": "2 / 4",
        "width": "100%",
        "height": "100%",
        "objectFit": "cover",
        "borderRadius": "var(--radius)",
        "display": "block",
        "@--md": { "gridColumn": "auto" }
      }
    }
  ]
}
