{
  "tagName": "bit-intro",
  "state": {
    "image": { "type": "string", "format": "image", "default": "" },
    "imageAlt": "",
    "kicker": "",
    "reverse": false
  },
  "style": {
    "display": "block",
    "padding": "clamp(3.5rem, 8vw, 6.5rem) 1.5rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "5fr 6fr",
        "gap": "clamp(2rem, 5vw, 4.5rem)",
        "alignItems": "center",
        "@--md": { "gridTemplateColumns": "1fr", "gap": "2.25rem" }
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "order": "${state.reverse ? '2' : '1'}",
            "position": "relative"
          },
          "children": [
            {
              "tagName": "img",
              "attributes": {
                "src": "${state.image}",
                "alt": "${state.imageAlt}",
                "loading": "lazy"
              },
              "style": {
                "width": "100%",
                "height": "auto",
                "display": "block",
                "borderRadius": "var(--radius)",
                "boxShadow": "0 24px 60px -30px rgba(30,21,15,0.55)"
              }
            },
            {
              "tagName": "span",
              "style": {
                "position": "absolute",
                "top": "0.85rem",
                "left": "0.85rem",
                "right": "0.85rem",
                "bottom": "0.85rem",
                "border": "1px solid rgba(246,236,219,0.45)",
                "borderRadius": "var(--radius)",
                "pointerEvents": "none"
              }
            }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "order": "${state.reverse ? '1' : '2'}",
            "fontFamily": "var(--font-body)",
            "fontSize": "1.1rem",
            "lineHeight": "1.85",
            "color": "var(--color-text-muted)",
            "& p": { "margin": "0 0 1.15rem" },
            "& p:first-of-type::first-letter": {
              "float": "left",
              "fontFamily": "var(--font-heading)",
              "fontSize": "3.6rem",
              "lineHeight": "0.8",
              "fontWeight": "700",
              "color": "var(--color-primary)",
              "margin": "0.35rem 0.6rem 0 0"
            },
            "& h3": {
              "fontFamily": "var(--font-heading)",
              "fontSize": "clamp(1.6rem, 3vw, 2.25rem)",
              "fontWeight": "700",
              "lineHeight": "1.15",
              "letterSpacing": "-0.01em",
              "color": "var(--color-text-primary)",
              "margin": "0 0 1.25rem"
            }
          },
          "children": [{ "tagName": "slot" }]
        }
      ]
    }
  ]
}
