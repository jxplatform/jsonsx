{
  "tagName": "bit-section-header",
  "state": {
    "eyebrow": "",
    "heading": "",
    "headingAccent": "",
    "subheading": "",
    "align": "center"
  },
  "style": {
    "display": "block",
    "maxWidth": "var(--max-width-narrow)",
    "margin": "0 auto 2.75rem",
    "textAlign": "${state.align}"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "${state.eyebrow ? 'flex' : 'none'}",
        "alignItems": "center",
        "gap": "0.85rem",
        "justifyContent": "${state.align === 'center' ? 'center' : 'flex-start'}",
        "marginBottom": "1.1rem"
      },
      "children": [
        {
          "tagName": "span",
          "style": {
            "width": "2.25rem",
            "height": "1px",
            "backgroundColor": "var(--color-primary)"
          }
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0",
            "fontFamily": "var(--font-body)",
            "textTransform": "uppercase",
            "letterSpacing": "0.22em",
            "fontSize": "0.74rem",
            "fontWeight": "700",
            "color": "var(--color-primary)"
          },
          "textContent": "${state.eyebrow}"
        },
        {
          "tagName": "span",
          "style": {
            "display": "${state.align === 'center' ? 'block' : 'none'}",
            "width": "2.25rem",
            "height": "1px",
            "backgroundColor": "var(--color-primary)"
          }
        }
      ]
    },
    {
      "tagName": "h2",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "clamp(2rem, 4.4vw, 3rem)",
        "fontWeight": "700",
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em",
        "margin": "0",
        "color": "var(--color-text-primary)"
      },
      "children": [
        { "tagName": "span", "textContent": "${state.heading}" },
        {
          "tagName": "span",
          "style": {
            "display": "${state.headingAccent ? 'inline' : 'none'}",
            "fontStyle": "italic",
            "fontWeight": "500",
            "color": "var(--color-primary)"
          },
          "textContent": " ${state.headingAccent}"
        }
      ]
    },
    {
      "tagName": "p",
      "style": {
        "display": "${state.subheading ? 'block' : 'none'}",
        "fontFamily": "var(--font-body)",
        "fontSize": "1.1rem",
        "lineHeight": "1.7",
        "color": "var(--color-text-muted)",
        "margin": "1.1rem auto 0",
        "maxWidth": "56ch"
      },
      "textContent": "${state.subheading}"
    }
  ]
}
