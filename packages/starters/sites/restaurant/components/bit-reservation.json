{
  "tagName": "bit-reservation",
  "state": {
    "heading": "Request a table",
    "intro": "Tell us when you'd like to come in and we'll confirm by email within a day."
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "padding": "clamp(1.75rem, 3.5vw, 2.75rem)",
    "boxShadow": "0 24px 60px -40px rgba(30,21,15,0.5)",
    "& input": {
      "width": "100%",
      "padding": "0.8rem 0.95rem",
      "border": "1px solid var(--color-border-strong)",
      "borderRadius": "var(--radius)",
      "fontSize": "1rem",
      "fontFamily": "var(--font-body)",
      "backgroundColor": "var(--color-bg-paper)",
      "color": "var(--color-text-primary)"
    },
    "& input:focus": {
      "outline": "none",
      "borderColor": "var(--color-primary)"
    },
    "& textarea:focus": {
      "outline": "none",
      "borderColor": "var(--color-primary)"
    }
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "clamp(1.65rem, 3vw, 2rem)",
        "fontWeight": "700",
        "letterSpacing": "-0.01em",
        "margin": "0 0 0.5rem",
        "color": "var(--color-text-primary)"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0 0 1.5rem",
        "fontFamily": "var(--font-heading)",
        "fontStyle": "italic",
        "fontSize": "1.05rem",
        "color": "var(--color-text-muted)"
      },
      "textContent": "${state.intro}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Email address",
            "required": "true",
            "aria-label": "Email address"
          }
        },
        {
          "tagName": "div",
          "style": { "display": "grid", "gridTemplateColumns": "1fr 1fr", "gap": "1rem" },
          "children": [
            {
              "tagName": "input",
              "attributes": { "type": "date", "name": "date", "aria-label": "Preferred date" }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "number",
                "name": "party",
                "min": "1",
                "max": "20",
                "placeholder": "Party size",
                "aria-label": "Party size"
              }
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "3",
            "placeholder": "Anything we should know?",
            "aria-label": "Notes"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.95rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "var(--font-body)",
            "backgroundColor": "var(--color-bg-paper)",
            "color": "var(--color-text-primary)"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Request a Table",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.9rem 1.75rem",
            "border": "none",
            "borderRadius": "999px",
            "fontFamily": "var(--font-body)",
            "fontSize": "0.85rem",
            "fontWeight": "700",
            "textTransform": "uppercase",
            "letterSpacing": "0.14em",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.85rem",
            "color": "var(--color-text-muted)",
            "margin": "0"
          },
          "textContent": "This is a demo form. Wire it to your booking provider or email in pages/contact.md."
        }
      ]
    }
  ]
}
