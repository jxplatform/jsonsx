{
  "tagName": "ev-session-row",
  "state": {
    "time": "",
    "title": "",
    "track": "",
    "speaker": ""
  },
  "style": {
    "display": "grid",
    "gridTemplateColumns": "4.2rem 1.6rem 1fr",
    "gap": "0",
    "marginBottom": "0.9rem",
    "@--sm": { "gridTemplateColumns": "3.4rem 1.2rem 1fr" }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "paddingTop": "1.15rem",
        "textAlign": "right",
        "paddingRight": "0.15rem",
        "fontFamily": "var(--font-heading)",
        "fontSize": "0.98rem",
        "fontWeight": "700",
        "fontVariantNumeric": "tabular-nums",
        "background": "var(--grad)",
        "backgroundClip": "text",
        "webkitBackgroundClip": "text",
        "webkitTextFillColor": "transparent",
        "color": "var(--color-accent)"
      },
      "textContent": "${state.time}"
    },
    {
      "tagName": "div",
      "style": { "position": "relative" },
      "children": [
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "0",
            "bottom": "-0.9rem",
            "width": "2px",
            "transform": "translateX(-50%)",
            "background": "var(--grad)",
            "opacity": "0.4"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "left": "50%",
            "top": "1.5rem",
            "width": "0.85rem",
            "height": "0.85rem",
            "borderRadius": "50%",
            "transform": "translate(-50%, -50%)",
            "border": "3px solid var(--color-bg)",
            "background": "${state.track === 'Design' ? '#ff6bb0' : state.track === 'Workshops' ? 'var(--color-lime)' : 'var(--color-accent)'}",
            "boxShadow": "0 0 12px ${state.track === 'Design' ? 'rgba(255,61,154,0.7)' : state.track === 'Workshops' ? 'rgba(198,255,77,0.7)' : 'rgba(34,224,255,0.7)'}"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "flexWrap": "wrap",
        "alignItems": "center",
        "justifyContent": "space-between",
        "gap": "0.75rem",
        "padding": "1rem 1.25rem",
        "borderRadius": "0.85rem",
        "backgroundColor": "var(--color-bg-elev)",
        "border": "1px solid var(--color-border)",
        "transition": "border-color 0.18s, transform 0.18s",
        ":hover": { "borderColor": "rgba(255,61,154,0.4)", "transform": "translateX(3px)" }
      },
      "children": [
        {
          "tagName": "div",
          "style": { "flex": "1", "minWidth": "14rem" },
          "children": [
            {
              "tagName": "h3",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "1.1rem",
                "fontWeight": "700",
                "margin": "0 0 0.2rem",
                "lineHeight": "1.3",
                "color": "var(--color-text-primary)"
              },
              "textContent": "${state.title}"
            },
            {
              "tagName": "p",
              "style": {
                "display": "${state.speaker ? 'block' : 'none'}",
                "margin": "0",
                "fontSize": "0.9rem",
                "color": "var(--color-text-muted)"
              },
              "textContent": "with ${state.speaker}"
            }
          ]
        },
        {
          "tagName": "span",
          "style": {
            "whiteSpace": "nowrap",
            "fontSize": "0.74rem",
            "fontWeight": "700",
            "letterSpacing": "0.03em",
            "textTransform": "uppercase",
            "padding": "0.32rem 0.8rem",
            "borderRadius": "999px",
            "color": "${state.track === 'Design' ? '#ff6bb0' : state.track === 'Workshops' ? 'var(--color-lime)' : 'var(--color-accent)'}",
            "backgroundColor": "${state.track === 'Design' ? 'rgba(255,61,154,0.14)' : state.track === 'Workshops' ? 'rgba(198,255,77,0.14)' : 'rgba(34,224,255,0.14)'}",
            "border": "1px solid ${state.track === 'Design' ? 'rgba(255,61,154,0.35)' : state.track === 'Workshops' ? 'rgba(198,255,77,0.35)' : 'rgba(34,224,255,0.35)'}"
          },
          "textContent": "${state.track}"
        }
      ]
    }
  ]
}
