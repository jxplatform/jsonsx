{
  "tagName": "ev-speaker-card",
  "state": {
    "name": "",
    "title": "",
    "topic": "",
    "photo": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "backgroundColor": "var(--color-bg-elev)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "transition": "transform 0.2s, box-shadow 0.2s, border-color 0.2s",
    ":hover": {
      "transform": "translateY(-5px)",
      "borderColor": "rgba(255,61,154,0.55)",
      "boxShadow": "0 26px 60px -22px var(--glow)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "aspectRatio": "4 / 5",
        "overflow": "hidden",
        "backgroundColor": "var(--color-bg-elev2)"
      },
      "children": [
        {
          "tagName": "img",
          "attributes": {
            "src": "${state.photo}",
            "alt": "${state.name}",
            "width": "1000",
            "height": "1400",
            "loading": "lazy"
          },
          "style": {
            "position": "absolute",
            "inset": "0",
            "width": "100%",
            "height": "100%",
            "objectFit": "cover",
            "display": "block",
            "filter": "saturate(1.05) contrast(1.02)",
            "transition": "transform 0.35s ease",
            ":hover": { "transform": "scale(1.06)" }
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "background": "linear-gradient(180deg, rgba(34,224,255,0.18) 0%, transparent 30%, rgba(10,7,17,0.15) 55%, rgba(10,7,17,0.9) 100%)",
            "pointerEvents": "none"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "left": "0",
            "right": "0",
            "bottom": "0",
            "height": "3px",
            "background": "var(--grad)",
            "pointerEvents": "none"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "style": { "padding": "1.3rem 1.4rem 1.6rem" },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.3rem",
            "fontWeight": "700",
            "letterSpacing": "-0.01em",
            "margin": "0 0 0.3rem",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0 0 0.75rem",
            "fontSize": "0.9rem",
            "fontWeight": "600",
            "background": "var(--grad)",
            "backgroundClip": "text",
            "webkitBackgroundClip": "text",
            "webkitTextFillColor": "transparent",
            "color": "var(--color-accent)"
          },
          "textContent": "${state.title}"
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.topic ? 'flex' : 'none'}",
            "gap": "0.5rem",
            "alignItems": "baseline",
            "margin": "0",
            "fontSize": "0.94rem",
            "lineHeight": "1.55",
            "color": "var(--color-text-muted)"
          },
          "children": [
            {
              "tagName": "span",
              "style": { "color": "var(--color-lime)", "fontWeight": "700" },
              "textContent": "▸"
            },
            { "tagName": "span", "textContent": "${state.topic}" }
          ]
        }
      ]
    }
  ]
}
