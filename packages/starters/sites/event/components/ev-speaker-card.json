{
  "tagName": "ev-speaker-card",
  "state": {
    "name": "",
    "title": "",
    "topic": "",
    "photo": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "transition": "transform 0.15s, box-shadow 0.15s",
    ":hover": {
      "transform": "translateY(-4px)",
      "boxShadow": "0 20px 45px rgba(124, 58, 237, 0.16)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": { "position": "relative", "aspectRatio": "1 / 1", "overflow": "hidden" },
      "children": [
        {
          "tagName": "img",
          "attributes": { "src": "${state.photo}", "alt": "${state.name}", "loading": "lazy" },
          "style": {
            "width": "100%",
            "height": "100%",
            "objectFit": "cover",
            "display": "block"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "background": "linear-gradient(180deg, transparent 55%, rgba(20, 11, 46, 0.55) 100%)"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "style": { "padding": "1.25rem 1.4rem 1.6rem" },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.25rem",
            "fontWeight": "700",
            "margin": "0 0 0.25rem"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0 0 0.75rem",
            "fontSize": "0.9rem",
            "fontWeight": "500",
            "color": "var(--color-primary)"
          },
          "textContent": "${state.title}"
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.topic ? 'block' : 'none'}",
            "margin": "0",
            "fontSize": "0.95rem",
            "lineHeight": "1.6",
            "color": "var(--color-text-muted)"
          },
          "textContent": "${state.topic}"
        }
      ]
    }
  ]
}
