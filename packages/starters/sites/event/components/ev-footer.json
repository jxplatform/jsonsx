{
  "tagName": "ev-footer",
  "state": {
    "brand": "Horizon Conf",
    "tagline": "One day. Two stages. The people building what's next.",
    "date": "June 12, 2026",
    "venue": "The Foundry, Portland OR"
  },
  "style": {
    "display": "block",
    "position": "relative",
    "backgroundColor": "var(--color-bg-dark)",
    "color": "var(--color-text-white)",
    "borderTop": "1px solid var(--color-border)",
    "padding": "clamp(3rem, 6vw, 4.5rem) 1.5rem 2.25rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "absolute",
        "top": "0",
        "left": "0",
        "right": "0",
        "height": "2px",
        "background": "var(--grad)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "2fr 1fr 1fr",
        "gap": "2.5rem",
        "@--md": { "gridTemplateColumns": "1fr" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.6rem",
                "marginBottom": "0.9rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "width": "1.7rem",
                    "height": "1.7rem",
                    "borderRadius": "0.55rem",
                    "background": "var(--grad-btn)",
                    "boxShadow": "0 0 18px var(--glow)",
                    "color": "#ffffff",
                    "fontSize": "0.9rem",
                    "fontWeight": "800",
                    "fontFamily": "var(--font-heading)"
                  },
                  "textContent": "H"
                },
                {
                  "tagName": "span",
                  "style": {
                    "fontFamily": "var(--font-heading)",
                    "fontSize": "1.4rem",
                    "fontWeight": "800",
                    "letterSpacing": "-0.02em"
                  },
                  "textContent": "${state.brand}"
                }
              ]
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "color": "var(--color-text-muted)",
                "maxWidth": "34ch",
                "lineHeight": "1.7"
              },
              "textContent": "${state.tagline}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.12em",
                "fontSize": "0.72rem",
                "fontWeight": "700",
                "color": "var(--color-accent)",
                "marginBottom": "0.85rem"
              },
              "textContent": "When & where"
            },
            {
              "tagName": "p",
              "style": { "margin": "0 0 0.35rem", "color": "var(--color-text-primary)" },
              "textContent": "${state.date}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "color": "var(--color-text-muted)" },
              "textContent": "${state.venue}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.12em",
                "fontSize": "0.72rem",
                "fontWeight": "700",
                "color": "var(--color-accent)",
                "marginBottom": "0.85rem"
              },
              "textContent": "Explore"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/schedule/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-muted)",
                "textDecoration": "none",
                "marginBottom": "0.4rem",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-text-primary)" }
              },
              "textContent": "Schedule"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/speakers/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-muted)",
                "textDecoration": "none",
                "marginBottom": "0.4rem",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-text-primary)" }
              },
              "textContent": "Speakers"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/tickets/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-muted)",
                "textDecoration": "none",
                "transition": "color 0.15s",
                ":hover": { "color": "var(--color-text-primary)" }
              },
              "textContent": "Tickets"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "2.75rem auto 0",
        "paddingTop": "1.5rem",
        "borderTop": "1px solid var(--color-border)",
        "fontSize": "0.85rem",
        "color": "var(--color-text-muted)"
      },
      "children": [
        {
          "tagName": "p",
          "style": { "margin": "0" },
          "textContent": "© Horizon Conf 2026. Built with Jx."
        }
      ]
    }
  ]
}
