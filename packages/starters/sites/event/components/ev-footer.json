{
  "tagName": "ev-footer",
  "state": {
    "brand": "Horizon Conf 2026",
    "tagline": "One day. Two stages. The people building what's next.",
    "date": "June 12, 2026",
    "venue": "The Foundry, Portland OR"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-dark)",
    "color": "var(--color-text-white)",
    "padding": "3.5rem 1.5rem 2rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "grid",
        "gridTemplateColumns": "2fr 1fr 1fr",
        "gap": "2.5rem",
        "@--md": { "gridTemplateColumns": "1fr" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "1.4rem",
                "fontWeight": "700",
                "marginBottom": "0.75rem"
              },
              "textContent": "${state.brand}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "opacity": "0.75", "maxWidth": "34ch" },
              "textContent": "${state.tagline}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "fontSize": "0.75rem",
                "opacity": "0.6",
                "marginBottom": "0.75rem"
              },
              "textContent": "When & where"
            },
            {
              "tagName": "p",
              "style": { "margin": "0 0 0.35rem", "opacity": "0.85" },
              "textContent": "${state.date}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "opacity": "0.85" },
              "textContent": "${state.venue}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "fontSize": "0.75rem",
                "opacity": "0.6",
                "marginBottom": "0.75rem"
              },
              "textContent": "Explore"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/schedule/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none",
                "marginBottom": "0.35rem"
              },
              "textContent": "Schedule"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/speakers/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none",
                "marginBottom": "0.35rem"
              },
              "textContent": "Speakers"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/tickets/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.85",
                "textDecoration": "none"
              },
              "textContent": "Tickets"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "2.5rem auto 0",
        "paddingTop": "1.5rem",
        "borderTop": "1px solid rgba(255, 255, 255, 0.15)",
        "fontSize": "0.85rem",
        "opacity": "0.6"
      },
      "children": [
        {
          "tagName": "p",
          "style": { "margin": "0" },
          "textContent": "© Horizon Conf 2026. Built with Jx."
        }
      ]
    }
  ]
}
