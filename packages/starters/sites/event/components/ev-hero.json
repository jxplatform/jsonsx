      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "gap": "0.55rem",
                "padding": "0.4rem 0.95rem",
                "borderRadius": "999px",
                "border": "1px solid var(--color-border)",
                "background": "rgba(255,255,255,0.04)",
                "backdropFilter": "blur(4px)",
                "fontSize": "0.82rem",
                "fontWeight": "600",
                "letterSpacing": "0.02em",
                "marginBottom": "1.5rem",
                "color": "var(--color-text-primary)"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "width": "0.5rem",
                    "height": "0.5rem",
                    "borderRadius": "999px",
                    "background": "var(--color-lime)",
                    "boxShadow": "0 0 10px var(--color-lime)"
                  }
                },
                { "tagName": "span", "textContent": "${state.eyebrow}" }
              ]
            },
            {
              "tagName": "h1",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "clamp(2.9rem, 7.5vw, 5.6rem)",
                "fontWeight": "800",
                "lineHeight": "0.98",
                "margin": "0 0 1.3rem",
                "letterSpacing": "-0.04em",
                "background": "linear-gradient(102deg, #22e0ff 0%, #7c8bff 30%, #a855f7 56%, #ff3d9a 88%)",
                "backgroundClip": "text",
                "webkitBackgroundClip": "text",
                "webkitTextFillColor": "transparent",
                "color": "#22e0ff"
              },
              "textContent": "${state.heading}"
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "clamp(1.05rem, 1.8vw, 1.3rem)",
                "lineHeight": "1.6",
                "margin": "0 0 1.9rem",
                "color": "var(--color-text-muted)",
                "maxWidth": "48ch"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "div",
              "style": {
                "display": "inline-flex",
                "alignItems": "stretch",
                "borderRadius": "0.85rem",
                "border": "1px solid var(--color-border)",
                "background": "linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01))",
                "overflow": "hidden",
                "marginBottom": "2.1rem",
                "@--sm": { "display": "flex", "width": "100%" }
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "width": "0.4rem",
                    "background": "var(--grad)"
                  }
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "0.7rem 1.15rem",
                    "display": "flex",
                    "flexDirection": "column",
                    "gap": "0.15rem"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": {
                        "fontSize": "0.68rem",
                        "textTransform": "uppercase",
                        "letterSpacing": "0.16em",
                        "color": "var(--color-text-muted)"
                      },
                      "textContent": "Date"
                    },
                    {
                      "tagName": "span",
                      "style": {
                        "fontFamily": "var(--font-heading)",
                        "fontWeight": "700",
                        "fontSize": "0.98rem"
                      },
                      "textContent": "${state.date}"
                    }
                  ]
                },
                {
                  "tagName": "div",
                  "style": {
                    "width": "1px",
                    "background": "repeating-linear-gradient(180deg, var(--color-border) 0 4px, transparent 4px 8px)"
                  }
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "0.7rem 1.15rem",
                    "display": "flex",
                    "flexDirection": "column",
                    "gap": "0.15rem"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": {
                        "fontSize": "0.68rem",
                        "textTransform": "uppercase",
                        "letterSpacing": "0.16em",
                        "color": "var(--color-text-muted)"
                      },
                      "textContent": "Venue"
                    },
                    {
                      "tagName": "span",
                      "style": {
                        "fontFamily": "var(--font-heading)",
                        "fontWeight": "700",
                        "fontSize": "0.98rem"
                      },
                      "textContent": "${state.location}"
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "div",
              "style": { "display": "flex", "gap": "0.75rem", "flexWrap": "wrap" },
              "children": [
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.ctaHref}" },
                  "style": {
                    "display": "inline-block",
                    "background": "var(--grad-btn)",
                    "color": "#ffffff",
                    "padding": "0.95rem 2.25rem",
                    "borderRadius": "999px",
                    "fontSize": "1.05rem",
                    "fontWeight": "700",
                    "textDecoration": "none",
                    "boxShadow": "0 12px 34px -8px var(--glow)",
                    "transition": "transform 0.15s, box-shadow 0.15s",
                    ":hover": {
                      "transform": "translateY(-2px)",
                      "boxShadow": "0 18px 44px -8px var(--glow)"
                    }
                  },
                  "textContent": "${state.cta}"
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.cta2Href}" },
                  "style": {
                    "display": "${state.cta2 ? 'inline-flex' : 'none'}",
                    "alignItems": "center",
                    "gap": "0.5rem",
                    "border": "1px solid var(--color-border)",
                    "backgroundColor": "rgba(255,255,255,0.03)",
                    "color": "var(--color-text-primary)",
                    "padding": "0.95rem 2rem",
                    "borderRadius": "999px",
                    "fontSize": "1.05rem",
                    "fontWeight": "700",
                    "textDecoration": "none",
                    "transition": "background-color 0.15s, border-color 0.15s",
                    ":hover": {
                      "backgroundColor": "rgba(255,255,255,0.07)",
                      "borderColor": "var(--color-text-muted)"
                    }
                  },
                  "textContent": "${state.cta2}"
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "position": "relative",
            "transform": "rotate(2deg)",
            "@--md": {
              "transform": "none",
              "maxWidth": "460px",
              "margin": "0 auto",
              "width": "100%"
