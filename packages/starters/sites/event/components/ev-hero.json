          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "position": "relative",
                "borderRadius": "1.15rem",
                "padding": "0.5rem",
                "background": "linear-gradient(150deg, rgba(34,224,255,0.6), rgba(168,85,247,0.4) 45%, rgba(255,61,154,0.55))",
                "boxShadow": "0 40px 90px -30px rgba(0,0,0,0.85), 0 0 90px -30px var(--glow)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "position": "relative",
                    "borderRadius": "0.85rem",
                    "overflow": "hidden",
                    "aspectRatio": "4 / 5",
                    "backgroundColor": "var(--color-bg-elev)"
                  },
                  "children": [
                    {
                      "tagName": "img",
                      "attributes": {
                        "src": "${state.bg}",
                        "alt": "Horizon Conf main stage",
                        "width": "1600",
                        "height": "1067",
                        "loading": "eager"
                      },
                      "style": {
                        "position": "absolute",
                        "inset": "0",
                        "width": "100%",
                        "height": "100%",
                        "objectFit": "cover",
                        "display": "block"
                      }
                    },
                    {
                      "tagName": "div",
                      "style": {
                        "position": "absolute",
                        "inset": "0",
                        "background": "linear-gradient(160deg, rgba(34,224,255,0.28) 0%, transparent 40%, rgba(10,7,17,0.35) 75%, rgba(255,61,154,0.35) 100%)",
                        "mixBlendMode": "screen"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "position": "absolute",
                "top": "-1rem",
                "left": "-1rem",
                "padding": "0.55rem 1rem",
                "borderRadius": "0.7rem",
                "background": "var(--color-bg-elev2)",
                "border": "1px solid var(--color-border)",
                "boxShadow": "0 12px 30px -10px rgba(0,0,0,0.7)",
                "fontFamily": "var(--font-heading)",
                "fontWeight": "800",
                "fontSize": "0.85rem",
                "letterSpacing": "0.02em",
                "transform": "rotate(-4deg)"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "background": "var(--grad)",
                    "backgroundClip": "text",
                    "webkitBackgroundClip": "text",
                    "webkitTextFillColor": "transparent",
                    "color": "var(--color-accent)"
                  },
                  "textContent": "2 stages · 24 speakers"
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "position": "absolute",
                "bottom": "-1.1rem",
                "right": "-0.6rem",
                "display": "flex",
                "alignItems": "center",
                "gap": "0.5rem",
                "padding": "0.55rem 1rem",
                "borderRadius": "999px",
                "background": "var(--color-bg-elev2)",
                "border": "1px solid var(--color-border)",
                "boxShadow": "0 12px 30px -10px rgba(0,0,0,0.7)",
                "fontWeight": "700",
                "fontSize": "0.82rem",
                "transform": "rotate(3deg)"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "width": "0.5rem",
                    "height": "0.5rem",
                    "borderRadius": "999px",
                    "background": "var(--color-lime)",
                    "boxShadow": "0 0 10px var(--color-lime)"
                  }
                },
                { "tagName": "span", "textContent": "One day only" }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "5",
        "width": "112%",
        "marginLeft": "-6%",
        "transform": "rotate(-2.5deg)",
        "background": "var(--grad)",
        "padding": "0.65rem 0",
        "overflow": "hidden",
        "boxShadow": "0 20px 50px -20px var(--glow)"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.5rem",
            "justifyContent": "center",
            "whiteSpace": "nowrap",
            "fontFamily": "var(--font-heading)",
            "fontWeight": "800",
            "fontSize": "clamp(0.85rem, 1.6vw, 1.05rem)",
            "letterSpacing": "0.12em",
            "textTransform": "uppercase",
            "color": "var(--color-ink)"
          },
          "children": [
            { "tagName": "span", "textContent": "Design" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "Engineering" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "Motion" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "AI" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "Systems" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "Workshops" },
            { "tagName": "span", "textContent": "✦" },
            { "tagName": "span", "textContent": "The hallway track" }
          ]
        }
      ]
    }
  ]
}
