{
  "tagName": "ev-feature",
  "state": {
    "icon": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "padding": "1.9rem",
    "backgroundColor": "var(--color-bg-elev)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "transition": "transform 0.18s, box-shadow 0.18s, border-color 0.18s",
    ":hover": {
      "transform": "translateY(-3px)",
      "borderColor": "rgba(34,224,255,0.4)",
      "boxShadow": "0 18px 44px -20px var(--glow-cyan)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "3rem",
        "height": "3rem",
        "borderRadius": "0.8rem",
        "fontSize": "1.5rem",
        "lineHeight": "1",
        "marginBottom": "1.1rem",
        "background": "linear-gradient(150deg, rgba(34,224,255,0.24), rgba(255,61,154,0.2))",
        "border": "1px solid var(--color-border)"
      },
      "textContent": "${state.icon}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.22rem",
        "fontWeight": "700",
        "letterSpacing": "-0.01em",
        "margin": "0 0 0.5rem",
        "color": "var(--color-text-primary)"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
