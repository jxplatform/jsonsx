{
  "tagName": "ev-feature",
  "state": {
    "icon": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "padding": "1.85rem",
    "backgroundColor": "var(--color-bg-white)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "transition": "transform 0.15s, box-shadow 0.15s",
    ":hover": {
      "transform": "translateY(-3px)",
      "boxShadow": "0 16px 40px rgba(124, 58, 237, 0.12)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "3rem",
        "height": "3rem",
        "borderRadius": "0.85rem",
        "fontSize": "1.5rem",
        "lineHeight": "1",
        "marginBottom": "1rem",
        "background": "linear-gradient(135deg, rgba(124, 58, 237, 0.14), rgba(236, 72, 153, 0.14))"
      },
      "textContent": "${state.icon}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.25rem",
        "fontWeight": "600",
        "margin": "0 0 0.5rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
