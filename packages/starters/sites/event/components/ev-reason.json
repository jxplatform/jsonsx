{
  "tagName": "ev-reason",
  "state": {
    "num": "01",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "grid",
    "gridTemplateColumns": "auto 1fr",
    "gap": "1.5rem",
    "alignItems": "start",
    "padding": "1.9rem 0",
    "borderTop": "1px solid var(--color-border)",
    "@--sm": { "gap": "1rem" }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "clamp(1.9rem, 4vw, 2.6rem)",
        "fontWeight": "800",
        "lineHeight": "1",
        "letterSpacing": "-0.03em",
        "minWidth": "2.8rem",
        "background": "var(--grad)",
        "backgroundClip": "text",
        "webkitBackgroundClip": "text",
        "webkitTextFillColor": "transparent",
        "color": "var(--color-accent)"
      },
      "textContent": "${state.num}"
    },
    {
      "tagName": "div",
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.4rem",
            "fontWeight": "700",
            "letterSpacing": "-0.01em",
            "margin": "0 0 0.5rem",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.title}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0",
            "color": "var(--color-text-muted)",
            "fontSize": "1.02rem",
            "lineHeight": "1.7",
            "maxWidth": "52ch"
          },
          "textContent": "${state.text}"
        }
      ]
    }
  ]
}
