{
  "name": "Horizon Conf 2026",
  "url": "https://example.com",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": { "name": "viewport", "content": "width=device-width, initial-scale=1" }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Horizon Conf 2026 — a one-day tech and design conference. Two stages, hands-on workshops, and the people building what's next. Save the date: June 12, 2026."
      }
    },
    {
      "tagName": "link",
      "attributes": { "rel": "icon", "href": "/favicon.svg" }
    },
    {
      "tagName": "link",
      "attributes": { "rel": "preconnect", "href": "https://fonts.googleapis.com" }
    },
    {
      "tagName": "link",
      "attributes": { "rel": "preconnect", "href": "https://fonts.gstatic.com", "crossorigin": "" }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      }
    }
  ],
  "$media": {
    "--": "1200px",
    "--lg": "(max-width: 1024px)",
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 640px)"
  },
  "style": {
    "--color-primary": "#7c3aed",
    "--color-primary-hover": "#6d28d9",
    "--color-ink": "#17122b",
    "--color-bg-dark": "#140b2e",
    "--color-bg-cream": "#f5f3ff",
    "--color-bg-white": "#ffffff",
    "--color-text-primary": "#17122b",
    "--color-text-white": "#ffffff",
    "--color-text-muted": "#6b7280",
    "--color-border": "#e5e0f5",
    "--color-accent": "#ec4899",
    "--font-heading": "'Space Grotesk', 'Segoe UI', system-ui, sans-serif",
    "--max-width": "1200px",
    "--max-width-narrow": "820px",
    "--radius": "0.75rem",
    "margin": "0",
    "padding": "0",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "lineHeight": "1.6",
    "color": "var(--color-text-primary)",
    "backgroundColor": "var(--color-bg-white)"
  },
  "imports": {
    "Markdown": "@jxsuite/parser/Markdown.class.json",
    "ContentCollection": "@jxsuite/parser/ContentCollection.class.json"
  },
  "images": {
    "optimize": true,
    "widths": [320, 640, 960, 1280, 1920],
    "formats": ["webp", "avif"],
    "quality": { "webp": 80, "avif": 65, "jpeg": 80, "png": 80 },
    "sizes": "(max-width: 768px) 100vw, 50vw",
    "lazyLoad": true
  },
  "contentTypes": {
    "sessions": {
      "source": "./content/sessions/",
      "format": "Markdown",
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "time": { "type": "string" },
          "track": { "type": "string" },
          "speaker": { "type": "string" },
          "order": { "type": "number" }
        },
        "required": ["title", "track"]
      }
    }
  },
  "build": {
    "outDir": "./dist",
    "format": "directory",
    "trailingSlash": "always"
  }
}
