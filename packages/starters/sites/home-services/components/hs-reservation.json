{
  "tagName": "hs-reservation",
  "state": {
    "heading": "Request a free quote"
  },
  "style": {
    "display": "block"
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.6rem",
        "fontWeight": "700",
        "letterSpacing": "-0.02em",
        "margin": "0 0 1.25rem"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem"
          }
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "1rem",
            "@--sm": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "email",
                "name": "email",
                "placeholder": "Email address",
                "required": "true",
                "aria-label": "Email address"
              },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem"
              }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "tel",
                "name": "phone",
                "placeholder": "Phone number",
                "aria-label": "Phone number"
              },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem"
              }
            }
          ]
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "service",
            "placeholder": "What do you need? (e.g. AC repair)",
            "aria-label": "Service needed"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem"
          }
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "4",
            "placeholder": "Describe the problem or project…",
            "aria-label": "Notes"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "inherit"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Request My Free Quote",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.85rem 1.5rem",
            "border": "none",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontWeight": "700",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": { "fontSize": "0.85rem", "color": "var(--color-text-muted)", "margin": "0" },
          "textContent": "This is a demo form. Wire it to your CRM, scheduler, or email in pages/contact.md."
        }
      ]
    }
  ]
}
