{
  "tagName": "hs-reservation",
  "state": {
    "heading": "Request a free quote"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderTop": "4px solid var(--color-primary)",
    "borderRadius": "var(--radius)",
    "boxShadow": "var(--shadow-card)",
    "overflow": "hidden"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "padding": "1.75rem 1.75rem 0" },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.7rem",
            "fontWeight": "600",
            "textTransform": "uppercase",
            "letterSpacing": "0.02em",
            "margin": "0 0 0.35rem"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": { "margin": "0", "color": "var(--color-text-muted)", "fontSize": "0.95rem" },
          "textContent": "Flat-rate pricing · No obligation · Same-day slots available."
        }
      ]
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": {
        "display": "grid",
        "gap": "0.9rem",
        "alignContent": "start",
        "padding": "1.4rem 1.75rem 1.75rem"
      },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.9rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-cream)"
          }
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "0.9rem",
            "@--sm": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "email",
                "name": "email",
                "placeholder": "Email address",
                "required": "true",
                "aria-label": "Email address"
              },
              "style": {
                "width": "100%",
                "padding": "0.8rem 0.9rem",
                "border": "1px solid var(--color-border-strong)",
                "borderRadius": "var(--radius-sm)",
                "fontSize": "1rem",
                "fontFamily": "inherit",
                "backgroundColor": "var(--color-bg-cream)"
              }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "tel",
                "name": "phone",
                "placeholder": "Phone number",
                "aria-label": "Phone number"
              },
              "style": {
                "width": "100%",
                "padding": "0.8rem 0.9rem",
                "border": "1px solid var(--color-border-strong)",
                "borderRadius": "var(--radius-sm)",
                "fontSize": "1rem",
                "fontFamily": "inherit",
                "backgroundColor": "var(--color-bg-cream)"
              }
            }
          ]
        },
        {
          "tagName": "select",
          "attributes": { "name": "service", "aria-label": "Service needed" },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.9rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "fontWeight": "500",
            "color": "var(--color-text-primary)",
            "backgroundColor": "var(--color-bg-cream)",
            "cursor": "pointer"
          },
          "children": [
            {
              "tagName": "option",
              "attributes": { "value": "" },
              "textContent": "What do you need? (e.g. AC repair)"
            },
            {
              "tagName": "option",
              "attributes": { "value": "ac-repair" },
              "textContent": "AC Repair"
            },
            {
              "tagName": "option",
              "attributes": { "value": "ac-install" },
              "textContent": "AC Installation"
            },
            {
              "tagName": "option",
              "attributes": { "value": "furnace-repair" },
              "textContent": "Furnace Repair"
            },
            {
              "tagName": "option",
              "attributes": { "value": "furnace-install" },
              "textContent": "Furnace Installation"
            },
            {
              "tagName": "option",
              "attributes": { "value": "heat-pump" },
              "textContent": "Heat Pumps"
            },
            {
              "tagName": "option",
              "attributes": { "value": "maintenance" },
              "textContent": "Maintenance Plan"
            },
            {
              "tagName": "option",
              "attributes": { "value": "emergency" },
              "textContent": "Emergency — no heat/AC"
            },
            {
              "tagName": "option",
              "attributes": { "value": "other" },
              "textContent": "Something else"
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "4",
            "placeholder": "Describe the problem or project…",
            "aria-label": "Notes"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.9rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-cream)"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Request My Free Quote →",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.95rem 1.5rem",
            "border": "none",
            "borderRadius": "var(--radius-sm)",
            "fontFamily": "var(--font-heading)",
            "textTransform": "uppercase",
            "letterSpacing": "0.05em",
            "fontSize": "1.05rem",
            "fontWeight": "600",
            "cursor": "pointer",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": { "fontSize": "0.85rem", "color": "var(--color-text-muted)", "margin": "0" },
          "textContent": "This is a demo form. Wire it to your CRM, scheduler, or email in pages/contact.md."
        }
      ]
    }
  ]
}
