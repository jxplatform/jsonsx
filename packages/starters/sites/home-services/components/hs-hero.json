              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontWeight": "600",
                    "fontSize": "1.15rem"
                  },
                  "textContent": "Fast, Free Quote"
                },
                {
                  "tagName": "span",
                  "style": {
                    "fontFamily": "var(--font-heading)",
                    "fontSize": "0.68rem",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.1em",
                    "color": "var(--color-primary)",
                    "border": "1px solid var(--color-primary)",
                    "borderRadius": "999px",
                    "padding": "0.15rem 0.6rem"
                  },
                  "textContent": "No obligation"
                }
              ]
            },
            {
              "tagName": "form",
              "attributes": { "action": "/contact/", "method": "post" },
              "style": { "display": "grid", "gap": "0.7rem", "padding": "1.4rem" },
              "children": [
                {
                  "tagName": "input",
                  "attributes": {
                    "type": "text",
                    "name": "name",
                    "placeholder": "Full name",
                    "aria-label": "Full name"
                  },
                  "style": {
                    "width": "100%",
                    "padding": "0.75rem 0.85rem",
                    "border": "1px solid var(--color-border-strong)",
                    "borderRadius": "var(--radius-sm)",
                    "fontSize": "1rem",
                    "fontFamily": "inherit",
                    "backgroundColor": "var(--color-bg-cream)"
                  }
                },
                {
                  "tagName": "input",
                  "attributes": {
                    "type": "tel",
                    "name": "phone",
                    "placeholder": "Phone number",
                    "aria-label": "Phone number"
                  },
                  "style": {
                    "width": "100%",
                    "padding": "0.75rem 0.85rem",
                    "border": "1px solid var(--color-border-strong)",
                    "borderRadius": "var(--radius-sm)",
                    "fontSize": "1rem",
                    "fontFamily": "inherit",
                    "backgroundColor": "var(--color-bg-cream)"
                  }
                },
                {
                  "tagName": "select",
                  "attributes": { "name": "service", "aria-label": "Service needed" },
                  "style": {
                    "width": "100%",
                    "padding": "0.75rem 0.85rem",
                    "border": "1px solid var(--color-border-strong)",
                    "borderRadius": "var(--radius-sm)",
                    "fontSize": "1rem",
                    "fontFamily": "inherit",
                    "fontWeight": "500",
                    "color": "var(--color-text-primary)",
                    "backgroundColor": "var(--color-bg-cream)",
                    "cursor": "pointer"
                  },
                  "children": [
                    {
                      "tagName": "option",
                      "attributes": { "value": "" },
                      "textContent": "What do you need?"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "ac-repair" },
                      "textContent": "AC Repair"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "ac-install" },
                      "textContent": "AC Installation"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "furnace-repair" },
                      "textContent": "Furnace Repair"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "furnace-install" },
                      "textContent": "Furnace Installation"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "heat-pump" },
                      "textContent": "Heat Pumps"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "maintenance" },
                      "textContent": "Maintenance Plan"
                    },
                    {
                      "tagName": "option",
                      "attributes": { "value": "other" },
                      "textContent": "Something else"
                    }
                  ]
                },
                {
                  "tagName": "button",
                  "attributes": { "type": "submit" },
                  "textContent": "Request Service →",
                  "style": {
                    "width": "100%",
                    "backgroundColor": "var(--color-primary)",
                    "color": "var(--color-text-white)",
                    "padding": "0.85rem 1.5rem",
                    "border": "none",
                    "borderRadius": "var(--radius-sm)",
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontSize": "1.02rem",
                    "fontWeight": "600",
                    "cursor": "pointer",
                    "transition": "background-color 0.15s",
                    ":hover": { "backgroundColor": "var(--color-primary-hover)" }
                  }
                },
                {
                  "tagName": "p",
                  "style": {
                    "margin": "0",
                    "fontSize": "0.82rem",
                    "color": "var(--color-text-muted)",
                    "textAlign": "center",
                    "display": "flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "gap": "0.4rem"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": { "color": "var(--color-primary)" },
                      "textContent": "⏱"
                    },
                    { "tagName": "span", "textContent": "We reply within the hour, 7 days a week." }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
