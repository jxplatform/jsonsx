{
  "tagName": "hs-hero",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "cta": "Get a Free Quote",
    "ctaHref": "/contact/",
    "cta2": "",
    "cta2Href": "/services/",
    "phone": "(970) 555-0148",
    "phoneHref": "tel:+19705550148",
    "bg": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "overflow": "hidden",
    "color": "var(--color-text-white)",
    "backgroundColor": "var(--color-bg-dark)",
    "backgroundImage": "linear-gradient(104deg, rgba(14,26,35,0.97) 0%, rgba(14,26,35,0.92) 42%, rgba(14,26,35,0.72) 66%, rgba(14,26,35,0.55) 100%), url('${state.bg}')",
    "backgroundSize": "cover, cover",
    "backgroundPosition": "center, right center",
    "backgroundRepeat": "no-repeat"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "absolute",
        "top": "0",
        "left": "0",
        "right": "0",
        "height": "6px",
        "background": "var(--hazard)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "5",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "clamp(3rem, 6vw, 5rem) 1.5rem clamp(3.5rem, 7vw, 5.5rem)",
        "display": "grid",
        "gridTemplateColumns": "1.08fr 0.92fr",
        "gap": "clamp(2rem, 5vw, 4rem)",
        "alignItems": "center",
        "@--md": { "gridTemplateColumns": "1fr", "gap": "2.5rem" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "p",
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "gap": "0.55rem",
                "padding": "0.35rem 0.85rem 0.35rem 0.7rem",
                "backgroundColor": "var(--color-primary)",
                "color": "var(--color-text-white)",
                "fontFamily": "var(--font-heading)",
                "textTransform": "uppercase",
                "letterSpacing": "0.08em",
                "fontSize": "0.78rem",
                "fontWeight": "600",
                "margin": "0 0 1.5rem",
                "transform": "skewX(-8deg)"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": { "transform": "skewX(8deg)", "display": "inline-block" },
                  "textContent": "${state.eyebrow}"
                }
              ]
            },
            {
              "tagName": "h1",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "clamp(2.7rem, 6.2vw, 4.9rem)",
                "fontWeight": "700",
                "textTransform": "uppercase",
                "lineHeight": "0.98",
                "letterSpacing": "0.005em",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-white)"
              },
              "textContent": "${state.heading}"
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "clamp(1.08rem, 1.9vw, 1.3rem)",
                "lineHeight": "1.6",
                "margin": "0 0 1.75rem",
                "color": "#cdd8e0",
                "maxWidth": "48ch"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "flexWrap": "wrap",
                "gap": "1rem 1.5rem",
                "marginBottom": "2rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "gap": "0.5rem",
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontSize": "0.85rem",
                    "fontWeight": "600",
                    "color": "#e6edf2"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": { "color": "var(--color-primary)", "fontSize": "1.05rem" },
                      "textContent": "✓"
                    },
                    { "tagName": "span", "textContent": "Licensed & Insured" }
                  ]
                },
                {
                  "tagName": "div",
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "gap": "0.5rem",
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontSize": "0.85rem",
                    "fontWeight": "600",
                    "color": "#e6edf2"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": { "color": "var(--color-primary)", "fontSize": "1.05rem" },
                      "textContent": "★"
                    },
                    { "tagName": "span", "textContent": "4.9 · 600+ Reviews" }
                  ]
                },
                {
                  "tagName": "div",
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "gap": "0.5rem",
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontSize": "0.85rem",
                    "fontWeight": "600",
                    "color": "#e6edf2"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": { "color": "var(--color-primary)", "fontSize": "1.05rem" },
                      "textContent": "⚡"
                    },
                    { "tagName": "span", "textContent": "Same-Day Service" }
                  ]
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "gap": "1rem",
                "flexWrap": "wrap",
                "alignItems": "center"
              },
              "children": [
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.ctaHref}" },
                  "style": {
                    "display": "inline-block",
                    "backgroundColor": "var(--color-primary)",
                    "color": "var(--color-text-white)",
                    "padding": "0.95rem 2.1rem",
                    "borderRadius": "var(--radius-sm)",
                    "fontFamily": "var(--font-heading)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em",
                    "fontSize": "1.02rem",
                    "fontWeight": "600",
                    "textDecoration": "none",
                    "boxShadow": "0 14px 30px -12px rgba(244,81,30,0.9)",
                    "transition": "background-color 0.15s, transform 0.15s",
                    ":hover": {
                      "backgroundColor": "var(--color-primary-hover)",
                      "transform": "translateY(-2px)"
                    }
                  },
                  "textContent": "${state.cta}"
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.phoneHref}" },
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "gap": "0.5rem",
                    "color": "var(--color-text-white)",
                    "textDecoration": "none",
                    "fontWeight": "600"
                  },
                  "children": [
                    {
                      "tagName": "span",
                      "style": { "color": "var(--color-primary)", "fontSize": "1.15rem" },
                      "textContent": "☏"
                    },
                    {
                      "tagName": "span",
                      "style": {
                        "fontFamily": "var(--font-heading)",
                        "fontSize": "1.2rem",
                        "fontWeight": "700",
                        "letterSpacing": "0.01em"
                      },
                      "textContent": "${state.phone}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "backgroundColor": "var(--color-bg-white)",
            "color": "var(--color-text-primary)",
            "borderRadius": "var(--radius)",
            "boxShadow": "var(--shadow-float)",
            "overflow": "hidden"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "backgroundColor": "var(--color-steel)",
                "color": "var(--color-text-white)",
                "padding": "1rem 1.4rem",
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "space-between",
                "gap": "0.75rem"
