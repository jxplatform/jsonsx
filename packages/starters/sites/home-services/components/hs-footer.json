{
  "tagName": "hs-footer",
  "state": {
    "brand": "SUMMIT",
    "brandSub": "HEATING & COOLING",
    "tagline": "Reliable heating and cooling for Northern Colorado homes — repairs, installs, and 24/7 emergency service.",
    "address": "1420 Prospect Road, Fort Collins, CO 80525",
    "phone": "(970) 555-0148",
    "phoneHref": "tel:+19705550148",
    "license": "CO HVAC Lic. #C-48219 · Bonded & Insured"
  },
  "style": {
    "display": "block",
    "position": "relative",
    "backgroundColor": "var(--color-bg-dark)",
    "color": "var(--color-text-white)",
    "paddingBottom": "2rem"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "height": "6px", "background": "var(--hazard)" }
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "3.25rem 1.5rem 0",
        "display": "grid",
        "gridTemplateColumns": "2fr 1fr 1fr",
        "gap": "2.5rem",
        "@--md": { "gridTemplateColumns": "1fr" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.6rem",
                "marginBottom": "0.9rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "display": "flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "width": "2.3rem",
                    "height": "2.3rem",
                    "backgroundColor": "var(--color-primary)",
                    "color": "var(--color-text-white)",
                    "borderRadius": "0.3rem",
                    "fontFamily": "var(--font-heading)",
                    "fontWeight": "700",
                    "fontSize": "1.25rem",
                    "clipPath": "polygon(0 0, 100% 0, 100% 78%, 50% 100%, 0 78%)"
                  },
                  "textContent": "▲"
                },
                {
                  "tagName": "span",
                  "style": { "display": "flex", "flexDirection": "column", "lineHeight": "1" },
                  "children": [
                    {
                      "tagName": "span",
                      "style": {
                        "fontFamily": "var(--font-heading)",
                        "fontWeight": "700",
                        "fontSize": "1.25rem",
                        "letterSpacing": "0.06em"
                      },
                      "textContent": "${state.brand}"
                    },
                    {
                      "tagName": "span",
                      "style": {
                        "fontFamily": "var(--font-heading)",
                        "fontWeight": "500",
                        "fontSize": "0.58rem",
                        "letterSpacing": "0.24em",
                        "color": "var(--color-primary)",
                        "marginTop": "0.15rem"
                      },
                      "textContent": "${state.brandSub}"
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0 0 1rem",
                "opacity": "0.72",
                "maxWidth": "42ch",
                "lineHeight": "1.6"
              },
              "textContent": "${state.tagline}"
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "fontFamily": "var(--font-heading)",
                "fontSize": "0.78rem",
                "letterSpacing": "0.05em",
                "textTransform": "uppercase",
                "opacity": "0.55"
              },
              "textContent": "${state.license}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-heading)",
                "textTransform": "uppercase",
                "letterSpacing": "0.1em",
                "fontSize": "0.78rem",
                "color": "var(--color-primary)",
                "marginBottom": "0.9rem",
                "fontWeight": "600"
              },
              "textContent": "Contact"
            },
            {
              "tagName": "a",
              "attributes": { "href": "${state.phoneHref}" },
              "style": {
                "display": "block",
                "fontFamily": "var(--font-heading)",
                "fontSize": "1.35rem",
                "fontWeight": "700",
                "color": "var(--color-text-white)",
                "textDecoration": "none",
                "marginBottom": "0.55rem",
                "letterSpacing": "0.01em"
              },
              "textContent": "${state.phone}"
            },
            {
              "tagName": "p",
              "style": { "margin": "0", "opacity": "0.78", "lineHeight": "1.55" },
              "textContent": "${state.address}"
            }
          ]
        },
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "div",
              "style": {
                "fontFamily": "var(--font-heading)",
                "textTransform": "uppercase",
                "letterSpacing": "0.1em",
                "fontSize": "0.78rem",
                "color": "var(--color-primary)",
                "marginBottom": "0.9rem",
                "fontWeight": "600"
              },
              "textContent": "Explore"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/services/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.82",
                "textDecoration": "none",
                "marginBottom": "0.45rem"
              },
              "textContent": "Services"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.82",
                "textDecoration": "none",
                "marginBottom": "0.45rem"
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "display": "block",
                "color": "var(--color-text-white)",
                "opacity": "0.82",
                "textDecoration": "none"
              },
              "textContent": "Contact"
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "2.5rem auto 0",
        "padding": "1.5rem 1.5rem 0",
        "borderTop": "1px solid var(--color-steel-line)",
        "fontSize": "0.85rem",
        "opacity": "0.55"
      },
      "children": [
        {
          "tagName": "p",
          "style": { "margin": "0" },
          "textContent": "© Summit Heating & Cooling. Built with Jx."
        }
      ]
    }
  ]
