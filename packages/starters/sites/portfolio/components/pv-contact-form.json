{
  "tagName": "pv-contact-form",
  "state": {
    "heading": "Project inquiry"
  },
  "style": {
    "display": "block",
    "& input": {
      "width": "100%",
      "padding": "0.85rem 1rem",
      "border": "1px solid var(--color-line)",
      "backgroundColor": "var(--color-bg-elev)",
      "color": "var(--color-text-primary)",
      "borderRadius": "0",
      "fontSize": "1rem",
      "fontFamily": "inherit",
      "outline": "none"
    },
    "& input:focus": { "borderColor": "var(--color-primary)" },
    "& textarea:focus": { "borderColor": "var(--color-primary)" }
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.9rem",
        "fontWeight": "500",
        "margin": "0 0 1.5rem",
        "color": "var(--color-text-primary)"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Email address",
            "required": "true",
            "aria-label": "Email address"
          }
        },
        {
          "tagName": "div",
          "style": { "display": "grid", "gridTemplateColumns": "1fr 1fr", "gap": "1rem" },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "type",
                "placeholder": "Type of project",
                "aria-label": "Type of project"
              }
            },
            {
              "tagName": "input",
              "attributes": { "type": "date", "name": "date", "aria-label": "Preferred date" }
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "4",
            "placeholder": "Tell us about the shoot…",
            "aria-label": "Project details"
          },
          "style": {
            "width": "100%",
            "padding": "0.85rem 1rem",
            "border": "1px solid var(--color-line)",
            "backgroundColor": "var(--color-bg-elev)",
            "color": "var(--color-text-primary)",
            "borderRadius": "0",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "outline": "none"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Send Inquiry →",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-bg)",
            "padding": "0.9rem 1.75rem",
            "border": "none",
            "borderRadius": "0",
            "fontSize": "0.8rem",
            "fontWeight": "700",
            "letterSpacing": "0.14em",
            "textTransform": "uppercase",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": { "fontSize": "0.85rem", "color": "var(--color-text-muted)", "margin": "0" },
          "textContent": "Demo form — wire it to your booking provider or email in pages/contact.md."
        }
      ]
    }
  ]
}
