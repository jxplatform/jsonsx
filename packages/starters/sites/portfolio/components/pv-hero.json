{
  "tagName": "pv-hero",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "cta": "View the Work",
    "ctaHref": "/work/",
    "cta2": "",
    "cta2Href": "/contact/",
    "bg": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "height": "100vh",
    "minHeight": "620px",
    "color": "var(--color-text-white)",
    "backgroundColor": "var(--color-bg)",
    "backgroundImage": "url('${state.bg}')",
    "backgroundSize": "cover",
    "backgroundPosition": "center"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(180deg, rgba(12,12,13,0.6) 0%, rgba(12,12,13,0.1) 26%, rgba(12,12,13,0.3) 62%, rgba(12,12,13,0.92) 100%)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "10",
        "display": "flex",
        "flexDirection": "column",
        "justifyContent": "flex-end",
        "height": "100%",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "0 clamp(1.5rem, 4vw, 4rem) clamp(3rem, 7vw, 5.5rem)"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1rem",
            "marginBottom": "1.5rem"
          },
          "children": [
            {
              "tagName": "span",
              "style": {
                "width": "3rem",
                "height": "1px",
                "backgroundColor": "var(--color-primary)"
              }
            },
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "textTransform": "uppercase",
                "letterSpacing": "0.28em",
                "fontSize": "0.72rem",
                "fontWeight": "500",
                "color": "var(--color-primary)"
              },
              "textContent": "${state.eyebrow}"
            }
          ]
        },
        {
          "tagName": "h1",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontWeight": "400",
            "fontSize": "clamp(3rem, 8.5vw, 7rem)",
            "lineHeight": "0.98",
            "letterSpacing": "-0.01em",
            "margin": "0 0 1.5rem",
            "maxWidth": "16ch"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "flex-end",
            "justifyContent": "space-between",
            "gap": "2rem",
            "flexWrap": "wrap"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "margin": "0",
                "fontSize": "clamp(1rem, 1.6vw, 1.2rem)",
                "lineHeight": "1.6",
                "color": "var(--color-text-white)",
                "opacity": "0.82",
                "maxWidth": "44ch"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "a",
              "attributes": { "href": "${state.ctaHref}" },
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "gap": "0.6rem",
                "whiteSpace": "nowrap",
                "fontSize": "0.78rem",
                "fontWeight": "600",
                "textTransform": "uppercase",
                "letterSpacing": "0.18em",
                "color": "var(--color-text-white)",
                "textDecoration": "none",
                "borderBottom": "1px solid var(--color-primary)",
                "paddingBottom": "0.5rem",
                "transition": "gap 0.2s, color 0.15s",
                ":hover": { "gap": "1.1rem", "color": "var(--color-primary)" }
              },
              "textContent": "${state.cta} →"
            }
          ]
        }
      ]
    }
  ]
}
