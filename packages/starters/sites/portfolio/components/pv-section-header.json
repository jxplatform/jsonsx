{
  "tagName": "pv-section-header",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "align": "center"
  },
  "style": {
    "display": "block",
    "maxWidth": "var(--max-width-narrow)",
    "margin": "0 auto 3rem",
    "textAlign": "${state.align}"
  },
  "children": [
    {
      "tagName": "p",
      "style": {
        "display": "${state.eyebrow ? 'block' : 'none'}",
        "textTransform": "uppercase",
        "letterSpacing": "0.2em",
        "fontSize": "0.78rem",
        "fontWeight": "600",
        "color": "var(--color-primary)",
        "margin": "0 0 0.85rem"
      },
      "textContent": "${state.eyebrow}"
    },
    {
      "tagName": "h2",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "clamp(2rem, 4.5vw, 3rem)",
        "fontWeight": "600",
        "lineHeight": "1.12",
        "letterSpacing": "-0.01em",
        "margin": "0"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "p",
      "style": {
        "display": "${state.subheading ? 'block' : 'none'}",
        "fontSize": "1.1rem",
        "lineHeight": "1.7",
        "color": "var(--color-text-muted)",
        "margin": "1.1rem 0 0"
      },
      "textContent": "${state.subheading}"
    }
  ]
}
