{
  "tagName": "pv-nav",
  "state": {
    "brand": "Aperture Studio"
  },
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "50",
    "backgroundColor": "rgba(255, 255, 255, 0.85)",
    "backdropFilter": "blur(10px)",
    "borderBottom": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "1.1rem 1.5rem",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "gap": "1.5rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.5rem",
            "fontWeight": "600",
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "letterSpacing": "0.01em"
          },
          "textContent": "${state.brand}"
        },
        {
          "tagName": "nav",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.75rem",
            "@--sm": { "gap": "1.1rem" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/work/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.9rem",
                "letterSpacing": "0.04em",
                "textTransform": "uppercase",
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "Work"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.9rem",
                "letterSpacing": "0.04em",
                "textTransform": "uppercase",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/contact/" },
              "style": {
                "display": "inline-block",
                "border": "1px solid var(--color-ink)",
                "color": "var(--color-text-primary)",
                "padding": "0.5rem 1.15rem",
                "borderRadius": "var(--radius)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.9rem",
                "letterSpacing": "0.04em",
                "textTransform": "uppercase",
                "transition": "background-color 0.15s, color 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-ink)",
                  "color": "var(--color-text-white)"
                }
              },
              "textContent": "Inquire"
            }
          ]
        }
      ]
    }
  ]
}
