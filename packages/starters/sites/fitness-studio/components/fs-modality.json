{
  "tagName": "fs-modality",
  "state": {
    "title": "",
    "text": "",
    "tag": "",
    "color": "#ff2e63",
    "href": "/classes/",
    "image": { "type": "string", "format": "image", "default": "" },
    "imageAlt": ""
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "height": "100%",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "boxShadow": "0 10px 30px -18px rgba(26,15,24,0.3)",
    "transition": "transform 0.18s, box-shadow 0.18s",
    ":hover": {
      "transform": "translateY(-4px)",
      "boxShadow": "0 24px 48px -22px rgba(26,15,24,0.42)"
    }
  },
  "children": [
    {
      "tagName": "a",
      "attributes": { "href": "${state.href}" },
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "height": "100%",
        "textDecoration": "none",
        "color": "var(--color-text-primary)"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "position": "relative",
            "aspectRatio": "5 / 4",
            "overflow": "hidden",
            "backgroundColor": "var(--duo-shadow)"
          },
          "children": [
            {
              "tagName": "img",
              "attributes": {
                "src": "${state.image}",
                "alt": "${state.imageAlt}",
                "width": "800",
                "height": "640",
                "loading": "lazy"
              },
              "style": {
                "position": "absolute",
                "inset": "0",
                "width": "100%",
                "height": "100%",
                "objectFit": "cover",
                "filter": "grayscale(100%) contrast(1.05) brightness(1.14)"
              }
            },
            {
              "tagName": "div",
              "style": {
                "position": "absolute",
                "inset": "0",
                "backgroundColor": "var(--duo-shadow)",
                "mixBlendMode": "lighten"
              }
            },
            {
              "tagName": "div",
              "style": {
                "position": "absolute",
                "inset": "0",
                "backgroundColor": "${state.color}",
                "mixBlendMode": "multiply",
                "opacity": "0.82"
              }
            },
            {
              "tagName": "div",
              "style": {
                "position": "absolute",
                "inset": "0",
                "background": "linear-gradient(180deg, rgba(20,6,16,0.05) 40%, rgba(20,6,16,0.6) 100%)"
              }
            },
            {
              "tagName": "span",
              "style": {
                "position": "absolute",
                "top": "1rem",
                "left": "1rem",
                "padding": "0.35rem 0.85rem",
                "borderRadius": "999px",
                "backgroundColor": "rgba(255,255,255,0.92)",
                "color": "var(--color-ink)",
                "fontFamily": "var(--font-heading)",
                "fontSize": "0.7rem",
                "fontWeight": "800",
                "textTransform": "uppercase",
                "letterSpacing": "0.08em"
              },
              "textContent": "${state.tag}"
            },
            {
              "tagName": "h3",
              "style": {
                "position": "absolute",
                "bottom": "0.9rem",
                "left": "1.15rem",
                "right": "1.15rem",
                "margin": "0",
                "fontFamily": "var(--font-display)",
                "fontSize": "clamp(1.7rem, 3vw, 2.2rem)",
                "fontWeight": "400",
                "lineHeight": "0.95",
                "textTransform": "uppercase",
                "color": "#ffffff",
                "textShadow": "0 4px 18px rgba(20,6,16,0.5)"
              },
              "textContent": "${state.title}"
            }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "flex": "1",
            "display": "flex",
            "flexDirection": "column",
            "padding": "1.4rem 1.5rem 1.6rem"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "margin": "0 0 1.1rem",
                "color": "var(--color-text-muted)",
                "fontSize": "0.98rem",
                "lineHeight": "1.6"
              },
              "textContent": "${state.text}"
            },
            {
              "tagName": "span",
              "style": {
                "marginTop": "auto",
                "display": "inline-flex",
                "alignItems": "center",
                "gap": "0.4rem",
                "fontFamily": "var(--font-heading)",
                "fontSize": "0.8rem",
                "fontWeight": "800",
                "textTransform": "uppercase",
                "letterSpacing": "0.06em",
                "color": "${state.color}"
              },
              "textContent": "Explore classes →"
            }
          ]
        }
      ]
    }
  ]
}
