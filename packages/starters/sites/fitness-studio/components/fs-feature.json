{
  "tagName": "fs-feature",
  "state": {
    "icon": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "height": "100%",
    "padding": "1.9rem",
    "backgroundColor": "var(--color-bg-white)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "boxShadow": "0 10px 30px -22px rgba(26,15,24,0.25)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "3rem",
        "height": "3rem",
        "borderRadius": "0.85rem",
        "fontSize": "1.5rem",
        "lineHeight": "1",
        "marginBottom": "1.1rem",
        "background": "var(--color-bg-peach)"
      },
      "textContent": "${state.icon}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.2rem",
        "fontWeight": "800",
        "letterSpacing": "-0.01em",
        "margin": "0 0 0.5rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
