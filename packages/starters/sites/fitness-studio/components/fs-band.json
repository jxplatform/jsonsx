{
  "tagName": "fs-band",
  "state": {
    "kicker": "",
    "heading": "",
    "text": "",
    "cta": "",
    "ctaHref": "/contact/",
    "image": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "center",
    "position": "relative",
    "overflow": "hidden",
    "minHeight": "clamp(360px, 58vh, 620px)",
    "padding": "clamp(3.5rem, 8vw, 6rem) 1.5rem",
    "textAlign": "center",
    "color": "#ffffff",
    "backgroundColor": "var(--duo-shadow)"
  },
  "children": [
    {
      "tagName": "div",
      "style": { "position": "absolute", "inset": "0", "zIndex": "0" },
      "children": [
        {
          "tagName": "img",
          "attributes": {
            "src": "${state.image}",
            "alt": "",
            "width": "1920",
            "height": "1080",
            "loading": "lazy"
          },
          "style": {
            "position": "absolute",
            "inset": "0",
            "width": "100%",
            "height": "100%",
            "objectFit": "cover",
            "objectPosition": "center 35%",
            "filter": "grayscale(100%) contrast(1.12)"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "backgroundColor": "var(--duo-shadow)",
            "mixBlendMode": "lighten"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "background": "linear-gradient(120deg, #d6157a 0%, #ff2e63 52%, #ff8c42 100%)",
            "mixBlendMode": "multiply",
            "opacity": "0.9"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "background": "radial-gradient(ellipse 70% 70% at 50% 50%, rgba(20,6,16,0.15), rgba(20,6,16,0.55))"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "style": { "position": "relative", "zIndex": "5", "maxWidth": "var(--max-width-narrow)" },
      "children": [
        {
          "tagName": "p",
          "style": {
            "display": "${state.kicker ? 'block' : 'none'}",
            "margin": "0 0 1.1rem",
            "fontFamily": "var(--font-heading)",
            "textTransform": "uppercase",
            "letterSpacing": "0.22em",
            "fontSize": "0.8rem",
            "fontWeight": "700",
            "color": "rgba(255,255,255,0.85)"
          },
          "textContent": "${state.kicker}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0",
            "fontFamily": "var(--font-display)",
            "fontSize": "clamp(2.4rem, 7vw, 5rem)",
            "fontWeight": "400",
            "lineHeight": "0.95",
            "letterSpacing": "0.01em",
            "textTransform": "uppercase",
            "textShadow": "0 14px 40px rgba(20,6,16,0.4)"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": {
            "display": "${state.text ? 'block' : 'none'}",
            "margin": "1.4rem auto 0",
            "maxWidth": "44ch",
            "fontSize": "1.1rem",
            "fontWeight": "500",
            "lineHeight": "1.65",
            "color": "rgba(255,255,255,0.92)"
          },
          "textContent": "${state.text}"
        },
        {
          "tagName": "a",
          "attributes": { "href": "${state.ctaHref}" },
          "style": {
            "display": "${state.cta ? 'inline-block' : 'none'}",
            "marginTop": "2rem",
            "backgroundColor": "#ffffff",
            "color": "var(--color-ink)",
            "padding": "1rem 2.3rem",
            "borderRadius": "999px",
            "fontFamily": "var(--font-heading)",
            "fontSize": "0.9rem",
            "fontWeight": "800",
            "textTransform": "uppercase",
            "letterSpacing": "0.06em",
            "textDecoration": "none",
            "boxShadow": "0 16px 40px -14px rgba(0,0,0,0.5)",
            "transition": "transform 0.15s, box-shadow 0.15s",
            ":hover": {
              "transform": "translateY(-3px)",
              "boxShadow": "0 22px 48px -14px rgba(0,0,0,0.55)"
            }
          },
          "textContent": "${state.cta}"
        }
      ]
    }
  ]
}
