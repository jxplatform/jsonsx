{
  "tagName": "re-section-header",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "align": "left"
  },
  "style": {
    "display": "block",
    "maxWidth": "${state.align === 'center' ? 'var(--max-width-narrow)' : 'var(--max-width)'}",
    "margin": "${state.align === 'center' ? '0 auto 2.75rem' : '0 auto 2.5rem'}",
    "padding": "0 1.5rem",
    "textAlign": "${state.align}"
  },
  "children": [
    {
      "tagName": "p",
      "style": {
        "display": "${state.eyebrow ? 'inline-flex' : 'none'}",
        "alignItems": "center",
        "gap": "0.6rem",
        "textTransform": "uppercase",
        "letterSpacing": "0.14em",
        "fontSize": "0.74rem",
        "fontWeight": "700",
        "color": "var(--color-primary)",
        "margin": "0 0 0.9rem"
      },
      "children": [
        {
          "tagName": "span",
          "style": {
            "width": "1.6rem",
            "height": "2px",
            "backgroundColor": "var(--color-accent)",
            "borderRadius": "2px"
          }
        },
        { "tagName": "span", "textContent": "${state.eyebrow}" }
      ]
    },
    {
      "tagName": "h2",
      "style": {
        "fontFamily": "var(--font-display)",
        "fontSize": "clamp(1.9rem, 3.6vw, 2.8rem)",
        "fontWeight": "500",
        "lineHeight": "1.1",
        "letterSpacing": "-0.015em",
        "margin": "0",
        "color": "var(--color-text-primary)"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "p",
      "style": {
        "display": "${state.subheading ? 'block' : 'none'}",
        "fontSize": "1.08rem",
        "lineHeight": "1.65",
        "color": "var(--color-text-muted)",
        "margin": "${state.align === 'center' ? '1rem auto 0' : '1rem 0 0'}",
        "maxWidth": "56ch"
      },
      "textContent": "${state.subheading}"
    }
  ]
}
