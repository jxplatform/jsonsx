{
  "tagName": "re-neighborhood",
  "state": {
    "name": "",
    "count": "",
    "price": "",
    "href": "/listings/",
    "image": { "type": "string", "format": "image", "default": "" }
  },
  "style": { "display": "block", "minWidth": "0" },
  "children": [
    {
      "tagName": "a",
      "attributes": { "href": "${state.href}" },
      "style": {
        "position": "relative",
        "display": "block",
        "overflow": "hidden",
        "borderRadius": "var(--radius)",
        "textDecoration": "none",
        "color": "var(--color-text-white)",
        "aspectRatio": "4 / 5",
        "backgroundColor": "var(--color-bg-dark)",
        ":hover img": { "transform": "scale(1.07)" },
        ":hover .re-nb-go": { "transform": "translateX(0.2rem)" }
      },
      "children": [
        {
          "tagName": "img",
          "attributes": { "src": "${state.image}", "alt": "${state.name}", "loading": "lazy" },
          "style": {
            "position": "absolute",
            "inset": "0",
            "width": "100%",
            "height": "100%",
            "objectFit": "cover",
            "display": "block",
            "transition": "transform 0.6s cubic-bezier(0.22, 1, 0.36, 1)"
          }
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "inset": "0",
            "background": "linear-gradient(to top, rgba(11,18,32,0.9) 0%, rgba(11,18,32,0.35) 45%, rgba(11,18,32,0.05) 75%)"
          }
        },
        {
          "tagName": "span",
          "style": {
            "position": "absolute",
            "top": "0.85rem",
            "right": "0.85rem",
            "display": "inline-flex",
            "alignItems": "center",
            "gap": "0.3rem",
            "padding": "0.28rem 0.6rem",
            "borderRadius": "999px",
            "backgroundColor": "rgba(255,255,255,0.16)",
            "border": "1px solid rgba(255,255,255,0.25)",
            "backdropFilter": "blur(6px)",
            "fontSize": "0.72rem",
            "fontWeight": "700",
            "fontVariantNumeric": "tabular-nums"
          },
          "textContent": "${state.count} listings"
        },
        {
          "tagName": "div",
          "style": {
            "position": "absolute",
            "left": "0",
            "right": "0",
            "bottom": "0",
            "padding": "1.15rem"
          },
          "children": [
            {
              "tagName": "h3",
              "style": {
                "fontFamily": "var(--font-display)",
                "fontSize": "1.35rem",
                "fontWeight": "500",
                "letterSpacing": "-0.01em",
                "margin": "0 0 0.3rem",
                "color": "var(--color-text-white)"
              },
              "textContent": "${state.name}"
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "space-between",
                "gap": "0.5rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "fontSize": "0.82rem",
                    "fontWeight": "600",
                    "color": "rgba(255,255,255,0.82)",
                    "fontVariantNumeric": "tabular-nums"
                  },
                  "textContent": "Median ${state.price}"
                },
                {
                  "tagName": "span",
                  "attributes": { "class": "re-nb-go" },
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "justifyContent": "center",
                    "width": "1.7rem",
                    "height": "1.7rem",
                    "borderRadius": "999px",
                    "backgroundColor": "var(--color-accent-bright)",
                    "color": "var(--color-ink)",
                    "fontSize": "0.85rem",
                    "fontWeight": "800",
                    "transition": "transform 0.2s"
                  },
                  "textContent": "→"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
