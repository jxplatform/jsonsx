{
  "tagName": "re-feature",
  "state": {
    "icon": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "padding": "1.75rem",
    "backgroundColor": "var(--color-bg-white)",
    "borderRadius": "var(--radius)",
    "border": "1px solid var(--color-border)",
    "transition": "transform 0.2s, box-shadow 0.2s",
    ":hover": { "transform": "translateY(-3px)", "boxShadow": "var(--shadow-card)" }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "3rem",
        "height": "3rem",
        "borderRadius": "0.7rem",
        "backgroundColor": "var(--color-teal-tint)",
        "border": "1px solid var(--color-accent-soft)",
        "fontSize": "1.4rem",
        "marginBottom": "1.1rem",
        "lineHeight": "1"
      },
      "textContent": "${state.icon}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.15rem",
        "fontWeight": "700",
        "letterSpacing": "-0.01em",
        "margin": "0 0 0.5rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
