{
  "tagName": "re-hero",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "cta": "Search homes",
    "ctaHref": "/listings/",
    "bg": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "overflow": "hidden",
    "borderBottom": "1px solid var(--color-border)",
    "backgroundColor": "var(--color-bg-white)",
    "backgroundImage": "linear-gradient(90deg, var(--color-bg-white) 0%, var(--color-bg-white) 38%, rgba(255,255,255,0.72) 52%, rgba(255,255,255,0.18) 72%, rgba(11,18,32,0.04) 100%), url('${state.bg}')",
    "backgroundSize": "cover, cover",
    "backgroundPosition": "center, right center",
    "backgroundRepeat": "no-repeat",
    "@--md": {
      "backgroundImage": "none",
      "backgroundColor": "var(--color-bg-cream)"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "2",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "clamp(3rem, 6vw, 5.5rem) 1.5rem clamp(3.5rem, 7vw, 6rem)",
        "display": "grid",
        "gridTemplateColumns": "1.02fr 0.98fr",
        "gap": "clamp(2rem, 5vw, 4rem)",
        "alignItems": "center",
        "@--md": { "gridTemplateColumns": "1fr", "gap": "2.25rem" }
      },
      "children": [
        {
          "tagName": "div",
          "children": [
            {
              "tagName": "p",
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "gap": "0.55rem",
                "padding": "0.4rem 0.85rem",
                "borderRadius": "999px",
                "border": "1px solid var(--color-border)",
                "backgroundColor": "var(--color-bg-white)",
                "boxShadow": "0 1px 2px rgba(15,23,42,0.04)",
                "fontSize": "0.8rem",
                "fontWeight": "600",
                "color": "var(--color-text-secondary)",
                "margin": "0 0 1.5rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "width": "0.5rem",
                    "height": "0.5rem",
                    "borderRadius": "999px",
                    "backgroundColor": "var(--color-accent-bright)",
                    "boxShadow": "0 0 0 3px var(--color-accent-soft)"
                  }
                },
                { "tagName": "span", "textContent": "${state.eyebrow}" }
              ]
            },
            {
              "tagName": "h1",
              "style": {
                "fontFamily": "var(--font-display)",
                "fontSize": "clamp(2.6rem, 5.4vw, 4.3rem)",
                "fontWeight": "500",
                "lineHeight": "1.04",
                "letterSpacing": "-0.02em",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)",
                "maxWidth": "14ch"
              },
              "textContent": "${state.heading}"
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "clamp(1.05rem, 1.6vw, 1.22rem)",
                "lineHeight": "1.6",
                "color": "var(--color-text-secondary)",
                "margin": "0 0 2rem",
                "maxWidth": "46ch"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "stretch",
                "gap": "0",
                "flexWrap": "wrap"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": { "paddingRight": "1.4rem" },
                  "children": [
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "1.55rem",
                        "fontWeight": "800",
                        "letterSpacing": "-0.02em",
                        "color": "var(--color-text-primary)",
                        "fontVariantNumeric": "tabular-nums"
                      },
                      "textContent": "20 yrs"
                    },
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "0.82rem",
                        "color": "var(--color-text-muted)",
                        "fontWeight": "600"
                      },
                      "textContent": "on the north shore"
                    }
                  ]
                },
                {
                  "tagName": "div",
                  "style": { "padding": "0 1.4rem", "borderLeft": "1px solid var(--color-border)" },
                  "children": [
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "1.55rem",
                        "fontWeight": "800",
                        "letterSpacing": "-0.02em",
                        "color": "var(--color-text-primary)",
                        "fontVariantNumeric": "tabular-nums"
                      },
                      "textContent": "1,400+"
                    },
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "0.82rem",
                        "color": "var(--color-text-muted)",
                        "fontWeight": "600"
                      },
                      "textContent": "homes closed"
                    }
                  ]
                },
                {
                  "tagName": "div",
                  "style": { "padding": "0 1.4rem", "borderLeft": "1px solid var(--color-border)" },
                  "children": [
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "1.55rem",
                        "fontWeight": "800",
                        "letterSpacing": "-0.02em",
                        "color": "var(--color-primary)",
                        "fontVariantNumeric": "tabular-nums"
                      },
                      "textContent": "98%"
                    },
                    {
                      "tagName": "div",
                      "style": {
                        "fontSize": "0.82rem",
                        "color": "var(--color-text-muted)",
                        "fontWeight": "600"
                      },
                      "textContent": "of asking price"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "form",
          "attributes": { "action": "/listings/", "method": "get" },
          "style": {
            "backgroundColor": "var(--color-bg-white)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius-lg)",
            "boxShadow": "var(--shadow-float)",
            "padding": "clamp(1.25rem, 2vw, 1.6rem)"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "gap": "0.35rem",
                "padding": "0.3rem",
                "borderRadius": "999px",
                "backgroundColor": "var(--color-bg-tint)",
                "marginBottom": "1.25rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "flex": "1",
                    "textAlign": "center",
                    "padding": "0.5rem 0.5rem",
                    "borderRadius": "999px",
                    "backgroundColor": "var(--color-bg-white)",
                    "color": "var(--color-text-primary)",
                    "fontWeight": "700",
                    "fontSize": "0.88rem",
                    "boxShadow": "0 1px 3px rgba(15,23,42,0.12)"
                  },
                  "textContent": "For Sale"
                },
                {
                  "tagName": "span",
                  "style": {
                    "flex": "1",
                    "textAlign": "center",
                    "padding": "0.5rem 0.5rem",
                    "borderRadius": "999px",
                    "color": "var(--color-text-muted)",
                    "fontWeight": "600",
                    "fontSize": "0.88rem"
                  },
                  "textContent": "For Rent"
                },
                {
                  "tagName": "span",
                  "style": {
                    "flex": "1",
                    "textAlign": "center",
                    "padding": "0.5rem 0.5rem",
                    "borderRadius": "999px",
                    "color": "var(--color-text-muted)",
                    "fontWeight": "600",
                    "fontSize": "0.88rem"
                  },
                  "textContent": "Sold"
                }
              ]
            },
            {
              "tagName": "label",
              "style": {
                "display": "block",
                "fontSize": "0.72rem",
                "fontWeight": "700",
                "textTransform": "uppercase",
                "letterSpacing": "0.1em",
                "color": "var(--color-text-muted)",
                "marginBottom": "0.5rem"
              },
              "textContent": "Location"
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.5rem",
                "padding": "0 0.85rem",
                "border": "1px solid var(--color-border-strong)",
                "borderRadius": "var(--radius-sm)",
                "backgroundColor": "var(--color-bg-white)",
                "marginBottom": "1rem"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": { "color": "var(--color-primary)", "fontSize": "1rem" },
                  "textContent": "📍"
                },
                {
                  "tagName": "input",
                  "attributes": {
                    "type": "text",
                    "name": "location",
                    "placeholder": "City, neighborhood, or ZIP",
                    "aria-label": "Search by city, neighborhood, or ZIP"
                  },
                  "style": {
                    "flex": "1",
                    "border": "none",
                    "outline": "none",
                    "padding": "0.8rem 0",
                    "fontSize": "0.98rem",
                    "fontFamily": "inherit",
                    "color": "var(--color-text-primary)",
                    "backgroundColor": "transparent",
                    "minWidth": "0"
                  }
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "display": "grid",
                "gridTemplateColumns": "repeat(3, 1fr)",
                "gap": "0.6rem",
                "marginBottom": "1.25rem",
                "@--sm": { "gridTemplateColumns": "1fr" }
              },
              "children": [
                {
                  "tagName": "div",
                  "children": [
                    {
                      "tagName": "label",
                      "style": {
                        "display": "block",
                        "fontSize": "0.72rem",
                        "fontWeight": "700",
                        "textTransform": "uppercase",
                        "letterSpacing": "0.1em",
                        "color": "var(--color-text-muted)",
                        "marginBottom": "0.5rem"
                      },
                      "textContent": "Max price"
                    },
                    {
                      "tagName": "select",
                      "attributes": { "name": "price", "aria-label": "Maximum price" },
                      "style": {
                        "width": "100%",
                        "border": "1px solid var(--color-border-strong)",
                        "borderRadius": "var(--radius-sm)",
                        "padding": "0.72rem 0.7rem",
                        "fontSize": "0.92rem",
                        "fontFamily": "inherit",
                        "fontWeight": "600",
                        "color": "var(--color-text-primary)",
                        "backgroundColor": "var(--color-bg-white)",
                        "cursor": "pointer"
                      },
                      "children": [
                        {
                          "tagName": "option",
                          "attributes": { "value": "" },
                          "textContent": "Any price"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "400000" },
                          "textContent": "$400k"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "700000" },
                          "textContent": "$700k"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "1200000" },
                          "textContent": "$1.2M"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "div",
                  "children": [
                    {
                      "tagName": "label",
                      "style": {
                        "display": "block",
                        "fontSize": "0.72rem",
                        "fontWeight": "700",
                        "textTransform": "uppercase",
                        "letterSpacing": "0.1em",
                        "color": "var(--color-text-muted)",
                        "marginBottom": "0.5rem"
                      },
                      "textContent": "Beds"
                    },
                    {
                      "tagName": "select",
                      "attributes": { "name": "beds", "aria-label": "Minimum bedrooms" },
                      "style": {
                        "width": "100%",
                        "border": "1px solid var(--color-border-strong)",
                        "borderRadius": "var(--radius-sm)",
                        "padding": "0.72rem 0.7rem",
                        "fontSize": "0.92rem",
                        "fontFamily": "inherit",
                        "fontWeight": "600",
                        "color": "var(--color-text-primary)",
                        "backgroundColor": "var(--color-bg-white)",
                        "cursor": "pointer"
                      },
                      "children": [
                        {
                          "tagName": "option",
                          "attributes": { "value": "" },
                          "textContent": "Any"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "2" },
                          "textContent": "2+"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "3" },
                          "textContent": "3+"
                        },
                        { "tagName": "option", "attributes": { "value": "4" }, "textContent": "4+" }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "div",
                  "children": [
                    {
                      "tagName": "label",
                      "style": {
                        "display": "block",
                        "fontSize": "0.72rem",
                        "fontWeight": "700",
                        "textTransform": "uppercase",
                        "letterSpacing": "0.1em",
                        "color": "var(--color-text-muted)",
                        "marginBottom": "0.5rem"
                      },
                      "textContent": "Baths"
                    },
                    {
                      "tagName": "select",
                      "attributes": { "name": "baths", "aria-label": "Minimum bathrooms" },
                      "style": {
                        "width": "100%",
                        "border": "1px solid var(--color-border-strong)",
                        "borderRadius": "var(--radius-sm)",
                        "padding": "0.72rem 0.7rem",
                        "fontSize": "0.92rem",
                        "fontFamily": "inherit",
                        "fontWeight": "600",
                        "color": "var(--color-text-primary)",
                        "backgroundColor": "var(--color-bg-white)",
                        "cursor": "pointer"
                      },
                      "children": [
                        {
                          "tagName": "option",
                          "attributes": { "value": "" },
                          "textContent": "Any"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "1" },
                          "textContent": "1+"
                        },
                        {
                          "tagName": "option",
                          "attributes": { "value": "2" },
                          "textContent": "2+"
                        },
                        { "tagName": "option", "attributes": { "value": "3" }, "textContent": "3+" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "button",
              "attributes": { "type": "submit" },
              "style": {
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "center",
                "gap": "0.55rem",
                "width": "100%",
                "backgroundColor": "var(--color-primary)",
                "color": "var(--color-text-white)",
                "border": "none",
                "padding": "0.95rem 1.5rem",
                "borderRadius": "var(--radius-sm)",
                "fontSize": "1rem",
                "fontFamily": "inherit",
                "fontWeight": "700",
                "cursor": "pointer",
                "boxShadow": "0 12px 28px -12px rgba(15,118,110,0.7)",
                "transition": "background-color 0.15s, transform 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-primary-hover)",
                  "transform": "translateY(-1px)"
                }
              },
              "children": [
                { "tagName": "span", "style": { "fontSize": "1.05rem" }, "textContent": "⌕" },
                { "tagName": "span", "textContent": "${state.cta}" }
              ]
            },
            {
              "tagName": "p",
              "style": {
                "margin": "1.05rem 0 0",
                "fontSize": "0.82rem",
                "color": "var(--color-text-muted)",
                "textAlign": "center"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": { "fontWeight": "700", "color": "var(--color-text-secondary)" },
                  "textContent": "Popular: "
                },
                {
                  "tagName": "span",
                  "textContent": "Bayport · Maplewood · Lakeview · Harbor Hills"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
