{
  "tagName": "re-agent-card",
  "state": {
    "name": "",
    "role": "",
    "phone": "",
    "image": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "transition": "transform 0.2s, box-shadow 0.2s",
    ":hover": { "transform": "translateY(-3px)", "boxShadow": "var(--shadow-card)" },
    ":hover img": { "transform": "scale(1.04)" }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "overflow": "hidden",
        "aspectRatio": "1 / 1",
        "backgroundColor": "var(--color-bg-tint)"
      },
      "children": [
        {
          "tagName": "img",
          "attributes": { "src": "${state.image}", "alt": "${state.name}", "loading": "lazy" },
          "style": {
            "position": "absolute",
            "inset": "0",
            "width": "100%",
            "height": "100%",
            "objectFit": "cover",
            "display": "block",
            "transition": "transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)"
          }
        }
      ]
    },
    {
      "tagName": "div",
      "style": { "padding": "1.25rem" },
      "children": [
        {
          "tagName": "p",
          "style": {
            "margin": "0 0 0.5rem",
            "color": "var(--color-primary)",
            "fontSize": "0.72rem",
            "fontWeight": "700",
            "textTransform": "uppercase",
            "letterSpacing": "0.1em"
          },
          "textContent": "${state.role}"
        },
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.2rem",
            "fontWeight": "700",
            "letterSpacing": "-0.01em",
            "margin": "0 0 0.6rem"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "a",
          "attributes": { "href": "tel:${state.phone}" },
          "style": {
            "display": "inline-flex",
            "alignItems": "center",
            "gap": "0.4rem",
            "color": "var(--color-text-secondary)",
            "fontSize": "0.92rem",
            "fontWeight": "600",
            "textDecoration": "none",
            "fontVariantNumeric": "tabular-nums",
            ":hover": { "color": "var(--color-primary)" }
          },
          "children": [
            { "tagName": "span", "style": { "fontSize": "0.85rem" }, "textContent": "☎" },
            { "tagName": "span", "textContent": "${state.phone}" }
          ]
        }
      ]
    }
  ]
}
