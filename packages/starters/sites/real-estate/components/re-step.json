        "left": "0",
        "top": "0",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "2.5rem",
        "height": "2.5rem",
        "borderRadius": "999px",
        "backgroundColor": "var(--color-primary)",
        "color": "var(--color-text-white)",
        "fontFamily": "var(--font-heading)",
        "fontWeight": "800",
        "fontSize": "1.1rem"
      },
      "textContent": "${state.number}"
