{
  "tagName": "re-contact-form",
  "state": {
    "note": "This is a demo form. Wire it to your CRM or email in pages/contact.md."
  },
  "style": { "display": "block" },
  "children": [
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "0.9rem", "marginTop": "1.5rem" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.95rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-white)",
            "outline": "none",
            "transition": "border-color 0.15s, box-shadow 0.15s",
            ":focus": {
              "borderColor": "var(--color-primary)",
              "boxShadow": "0 0 0 3px var(--color-accent-soft)"
            }
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Email address",
            "required": "true",
            "aria-label": "Email address"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.95rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-white)",
            "outline": "none",
            "transition": "border-color 0.15s, box-shadow 0.15s",
            ":focus": {
              "borderColor": "var(--color-primary)",
              "boxShadow": "0 0 0 3px var(--color-accent-soft)"
            }
          }
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "0.9rem",
            "@--sm": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "intent",
                "placeholder": "Buying or selling?",
                "aria-label": "Buying or selling"
              },
              "style": {
                "width": "100%",
                "padding": "0.8rem 0.95rem",
                "border": "1px solid var(--color-border-strong)",
                "borderRadius": "var(--radius-sm)",
                "fontSize": "1rem",
                "fontFamily": "inherit",
                "backgroundColor": "var(--color-bg-white)",
                "outline": "none",
                "transition": "border-color 0.15s, box-shadow 0.15s",
                ":focus": {
                  "borderColor": "var(--color-primary)",
                  "boxShadow": "0 0 0 3px var(--color-accent-soft)"
                }
              }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "area",
                "placeholder": "Preferred area",
                "aria-label": "Preferred area"
              },
              "style": {
                "width": "100%",
                "padding": "0.8rem 0.95rem",
                "border": "1px solid var(--color-border-strong)",
                "borderRadius": "var(--radius-sm)",
                "fontSize": "1rem",
                "fontFamily": "inherit",
                "backgroundColor": "var(--color-bg-white)",
                "outline": "none",
                "transition": "border-color 0.15s, box-shadow 0.15s",
                ":focus": {
                  "borderColor": "var(--color-primary)",
                  "boxShadow": "0 0 0 3px var(--color-accent-soft)"
                }
              }
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "notes",
            "rows": "4",
            "placeholder": "What are you looking for? Budget, bedrooms, timing…",
            "aria-label": "Notes"
          },
          "style": {
            "width": "100%",
            "padding": "0.8rem 0.95rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-white)",
            "outline": "none",
            "resize": "vertical",
            "transition": "border-color 0.15s, box-shadow 0.15s",
            ":focus": {
              "borderColor": "var(--color-primary)",
              "boxShadow": "0 0 0 3px var(--color-accent-soft)"
            }
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Request a call",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.9rem 1.6rem",
            "border": "none",
            "borderRadius": "999px",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "fontWeight": "700",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s, transform 0.15s",
            ":hover": {
              "backgroundColor": "var(--color-primary-hover)",
              "transform": "translateY(-1px)"
            }
          }
        }
      ]
    },
    {
      "tagName": "p",
      "style": {
        "fontSize": "0.85rem",
        "color": "var(--color-text-muted)",
        "margin": "1rem 0 0"
      },
      "textContent": "${state.note}"
    }
  ]
}
