{
  "tagName": "re-listing-card",
  "state": {
    "heading": "",
    "price": "0",
    "beds": "0",
    "baths": "0",
    "sqft": "0",
    "city": "",
    "image": { "type": "string", "format": "image", "default": "" },
    "href": "#"
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "boxShadow": "0 4px 20px rgba(15,23,42,0.05)",
    "transition": "transform 0.2s, box-shadow 0.2s",
    ":hover": {
      "transform": "translateY(-4px)",
      "boxShadow": "0 14px 34px rgba(15,23,42,0.14)"
    }
  },
  "children": [
    {
      "tagName": "a",
      "attributes": { "href": "${state.href}" },
      "style": { "display": "block", "position": "relative", "textDecoration": "none" },
      "children": [
        {
          "tagName": "img",
          "attributes": { "src": "${state.image}", "alt": "${state.heading}", "loading": "lazy" },
          "style": {
            "width": "100%",
            "height": "230px",
            "objectFit": "cover",
            "display": "block"
          }
        },
        {
          "tagName": "span",
          "style": {
            "position": "absolute",
            "top": "0.9rem",
            "left": "0.9rem",
            "backgroundColor": "var(--color-bg-white)",
            "color": "var(--color-primary)",
            "fontWeight": "800",
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.05rem",
            "padding": "0.35rem 0.75rem",
            "borderRadius": "999px",
            "boxShadow": "0 4px 12px rgba(15,23,42,0.18)"
          },
          "textContent": "$${Number(state.price).toLocaleString('en-US')}"
        }
      ]
    },
    {
      "tagName": "div",
      "style": { "padding": "1.15rem 1.25rem 1.35rem" },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "${state.href}" },
          "style": {
            "textDecoration": "none",
            "color": "var(--color-text-primary)"
          },
          "children": [
            {
              "tagName": "h3",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "1.2rem",
                "fontWeight": "700",
                "margin": "0 0 0.35rem",
                "letterSpacing": "-0.01em"
              },
              "textContent": "${state.heading}"
            }
          ]
        },
        {
          "tagName": "p",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "0.4rem",
            "margin": "0 0 0.85rem",
            "color": "var(--color-text-muted)",
            "fontSize": "0.9rem"
          },
          "children": [
            { "tagName": "span", "textContent": "📍" },
            { "tagName": "span", "textContent": "${state.city}" }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "gap": "1rem",
            "paddingTop": "0.85rem",
            "borderTop": "1px solid var(--color-border)",
            "fontSize": "0.9rem",
            "color": "var(--color-text-primary)",
            "fontWeight": "600"
          },
          "children": [
            { "tagName": "span", "textContent": "${state.beds} bd" },
            { "tagName": "span", "style": { "color": "var(--color-border)" }, "textContent": "|" },
            { "tagName": "span", "textContent": "${state.baths} ba" },
            { "tagName": "span", "style": { "color": "var(--color-border)" }, "textContent": "|" },
            {
              "tagName": "span",
              "textContent": "${Number(state.sqft).toLocaleString('en-US')} sqft"
            }
          ]
        }
      ]
    }
  ]
}
