{
  "tagName": "np-contact-form",
  "state": {
    "heading": "Send us a message"
  },
  "style": {
    "display": "block",
    "padding": "clamp(1.75rem, 4vw, 2.5rem)",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius-lg)",
    "boxShadow": "var(--shadow-card)"
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-display)",
        "fontSize": "1.75rem",
        "fontWeight": "600",
        "color": "var(--color-primary-deep)",
        "margin": "0 0 1.5rem"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.85rem 1rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-cream)"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Email address",
            "required": "true",
            "aria-label": "Email address"
          },
          "style": {
            "width": "100%",
            "padding": "0.85rem 1rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-cream)"
          }
        },
        {
          "tagName": "select",
          "attributes": { "name": "interest", "aria-label": "I'm interested in" },
          "style": {
            "width": "100%",
            "padding": "0.85rem 1rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "backgroundColor": "var(--color-bg-cream)",
            "fontFamily": "inherit"
          },
          "children": [
            {
              "tagName": "option",
              "attributes": { "value": "general" },
              "textContent": "General question"
            },
            {
              "tagName": "option",
              "attributes": { "value": "volunteer" },
              "textContent": "I want to volunteer"
            },
            {
              "tagName": "option",
              "attributes": { "value": "donate" },
              "textContent": "I want to donate or fundraise"
            },
            {
              "tagName": "option",
              "attributes": { "value": "partner" },
              "textContent": "Partnership or sponsorship"
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "message",
            "rows": "4",
            "placeholder": "How can we help?",
            "aria-label": "Message"
          },
          "style": {
            "width": "100%",
            "padding": "0.85rem 1rem",
            "border": "1px solid var(--color-border-strong)",
            "borderRadius": "var(--radius-sm)",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "backgroundColor": "var(--color-bg-cream)"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Send message",
          "style": {
            "display": "inline-flex",
            "alignItems": "center",
            "justifyContent": "center",
            "gap": "0.4rem",
            "backgroundColor": "var(--color-accent)",
            "color": "var(--color-text-white)",
            "padding": "0.95rem 1.75rem",
            "border": "none",
            "borderRadius": "999px",
            "fontSize": "1rem",
            "fontFamily": "inherit",
            "fontWeight": "800",
            "cursor": "pointer",
            "justifySelf": "start",
            "boxShadow": "0 12px 26px -12px rgba(242,106,61,0.8)",
            "transition": "background-color 0.15s, transform 0.15s",
            ":hover": {
              "backgroundColor": "var(--color-accent-hover)",
              "transform": "translateY(-1px)"
            }
          }
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.85rem",
            "fontWeight": "600",
            "color": "var(--color-text-muted)",
            "margin": "0"
          },
          "textContent": "This is a demo form. Wire it to your email or CRM in pages/contact.md."
        }
      ]
    }
  ]
}
