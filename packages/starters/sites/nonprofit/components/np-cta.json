{
  "tagName": "np-cta",
  "state": {
    "eyebrow": "",
    "heading": "",
    "text": "",
    "cta": "Donate Now",
    "ctaHref": "/get-involved/",
    "cta2": "",
    "cta2Href": "/get-involved/",
    "bg": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "backgroundColor": "var(--color-bg-dark)",
    "backgroundImage": "url('${state.bg}')",
    "backgroundSize": "cover",
    "backgroundPosition": "center",
    "color": "var(--color-text-white)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(180deg, rgba(20,49,42,0.86) 0%, rgba(20,49,42,0.92) 100%)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "10",
        "maxWidth": "var(--max-width-narrow)",
        "margin": "0 auto",
        "padding": "clamp(3.5rem, 8vw, 5.5rem) 1.5rem",
        "textAlign": "center"
      },
      "children": [
        {
          "tagName": "p",
          "style": {
            "display": "${state.eyebrow ? 'block' : 'none'}",
            "textTransform": "uppercase",
            "letterSpacing": "0.16em",
            "fontSize": "0.8rem",
            "fontWeight": "600",
            "color": "#bbf7d0",
            "margin": "0 0 0.9rem"
          },
          "textContent": "${state.eyebrow}"
        },
        {
          "tagName": "h2",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "clamp(1.9rem, 4vw, 2.75rem)",
            "fontWeight": "700",
            "lineHeight": "1.15",
            "margin": "0 0 1rem"
          },
          "textContent": "${state.heading}"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "1.1rem",
            "lineHeight": "1.7",
            "opacity": "0.9",
            "margin": "0 0 2rem"
          },
          "textContent": "${state.text}"
        },
        {
          "tagName": "div",
          "style": {
            "display": "flex",
            "gap": "0.75rem",
            "flexWrap": "wrap",
            "justifyContent": "center"
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "${state.ctaHref}" },
              "style": {
                "display": "inline-block",
                "backgroundColor": "var(--color-accent)",
                "color": "var(--color-text-white)",
                "padding": "0.95rem 2.5rem",
                "borderRadius": "999px",
                "fontSize": "1.05rem",
                "fontWeight": "600",
                "textDecoration": "none",
                "boxShadow": "0 8px 24px rgba(234,88,12,0.4)",
                "transition": "background-color 0.15s, transform 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-accent-hover)",
                  "transform": "translateY(-1px)"
                }
              },
              "textContent": "${state.cta}"
            },
            {
              "tagName": "a",
              "attributes": { "href": "${state.cta2Href}" },
              "style": {
                "display": "${state.cta2 ? 'inline-block' : 'none'}",
                "border": "1px solid rgba(255,255,255,0.6)",
                "color": "var(--color-text-white)",
                "padding": "0.95rem 2rem",
                "borderRadius": "999px",
                "fontSize": "1.05rem",
                "fontWeight": "600",
                "textDecoration": "none",
                "transition": "background-color 0.15s",
                ":hover": { "backgroundColor": "rgba(255,255,255,0.14)" }
              },
              "textContent": "${state.cta2}"
            }
          ]
        }
      ]
    }
  ]
}
