{
  "tagName": "np-nav",
  "state": {
    "brand": "Rivertown Foundation"
  },
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "50",
    "backgroundColor": "rgba(255, 255, 255, 0.92)",
    "backdropFilter": "blur(8px)",
    "borderBottom": "1px solid var(--color-border)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "0.9rem 1.5rem",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "gap": "1.5rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "0.6rem",
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.3rem",
            "fontWeight": "700",
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "letterSpacing": "-0.01em"
          },
          "children": [
            {
              "tagName": "span",
              "style": {
                "display": "inline-flex",
                "alignItems": "center",
                "justifyContent": "center",
                "width": "2rem",
                "height": "2rem",
                "borderRadius": "0.5rem",
                "backgroundColor": "var(--color-primary)",
                "color": "var(--color-text-white)",
                "fontSize": "1.1rem"
              },
              "textContent": "♥"
            },
            {
              "tagName": "span",
              "textContent": "${state.brand}"
            }
          ]
        },
        {
          "tagName": "nav",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "1.6rem",
            "@--sm": { "gap": "0.9rem" }
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/programs/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.95rem",
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "Programs"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/about/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.95rem",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "About"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/get-involved/" },
              "style": {
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontWeight": "500",
                "fontSize": "0.95rem",
                "@--sm": { "display": "none" },
                ":hover": { "color": "var(--color-primary)" }
              },
              "textContent": "Get Involved"
            },
            {
              "tagName": "a",
              "attributes": { "href": "/get-involved/" },
              "style": {
                "display": "inline-block",
                "backgroundColor": "var(--color-accent)",
                "color": "var(--color-text-white)",
                "padding": "0.55rem 1.35rem",
                "borderRadius": "999px",
                "textDecoration": "none",
                "fontWeight": "600",
                "fontSize": "0.95rem",
                "boxShadow": "0 4px 14px rgba(234,88,12,0.28)",
                "transition": "background-color 0.15s, transform 0.15s",
                ":hover": {
                  "backgroundColor": "var(--color-accent-hover)",
                  "transform": "translateY(-1px)"
                }
              },
              "textContent": "Donate"
            }
          ]
        }
      ]
    }
  ]
}
