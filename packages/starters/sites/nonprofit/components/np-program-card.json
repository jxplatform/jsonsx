{
  "tagName": "np-program-card",
  "state": {
    "title": "",
    "summary": "",
    "image": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "overflow": "hidden",
    "boxShadow": "0 4px 20px rgba(20,49,42,0.06)",
    "transition": "transform 0.15s, box-shadow 0.15s",
    ":hover": {
      "transform": "translateY(-3px)",
      "boxShadow": "0 12px 32px rgba(20,49,42,0.12)"
    }
  },
  "children": [
    {
      "tagName": "img",
      "attributes": {
        "src": "${state.image}",
        "alt": "${state.title}",
        "loading": "lazy"
      },
      "style": {
        "width": "100%",
        "aspectRatio": "16 / 10",
        "objectFit": "cover",
        "display": "block"
      }
    },
    {
      "tagName": "div",
      "style": {
        "padding": "1.5rem",
        "display": "flex",
        "flexDirection": "column",
        "flex": "1"
      },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontFamily": "var(--font-heading)",
            "fontSize": "1.3rem",
            "fontWeight": "600",
            "margin": "0 0 0.6rem"
          },
          "textContent": "${state.title}"
        },
        {
          "tagName": "p",
          "style": {
            "margin": "0",
            "color": "var(--color-text-muted)",
            "fontSize": "0.98rem",
            "lineHeight": "1.65"
          },
          "textContent": "${state.summary}"
        }
      ]
    }
  ]
}
