{
  "tagName": "np-step",
  "state": {
    "num": "",
    "title": "",
    "text": ""
  },
  "style": {
    "display": "block",
    "padding": "1.75rem",
    "backgroundColor": "var(--color-bg-white)",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "2.75rem",
        "height": "2.75rem",
        "borderRadius": "999px",
        "backgroundColor": "var(--color-primary)",
        "color": "var(--color-text-white)",
        "fontFamily": "var(--font-heading)",
        "fontWeight": "700",
        "fontSize": "1.25rem",
        "marginBottom": "1rem"
      },
      "textContent": "${state.num}"
    },
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.2rem",
        "fontWeight": "600",
        "margin": "0 0 0.5rem"
      },
      "textContent": "${state.title}"
    },
    {
      "tagName": "p",
      "style": {
        "margin": "0",
        "color": "var(--color-text-muted)",
        "fontSize": "0.98rem",
        "lineHeight": "1.65"
      },
      "textContent": "${state.text}"
    }
  ]
}
