{
  "tagName": "np-hero",
  "state": {
    "eyebrow": "",
    "heading": "",
    "subheading": "",
    "cta": "Donate Now",
    "ctaHref": "/get-involved/",
    "cta2": "",
    "cta2Href": "/programs/",
    "bg": { "type": "string", "format": "image", "default": "" }
  },
  "style": {
    "display": "block",
    "position": "relative",
    "minHeight": "76vh",
    "color": "var(--color-text-white)",
    "backgroundImage": "url('${state.bg}')",
    "backgroundSize": "cover",
    "backgroundPosition": "center"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "position": "absolute",
        "inset": "0",
        "background": "linear-gradient(180deg, rgba(20,49,42,0.45) 0%, rgba(20,49,42,0.82) 100%)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "position": "relative",
        "zIndex": "10",
        "display": "flex",
        "alignItems": "center",
        "minHeight": "76vh",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "padding": "4rem 1.5rem"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "660px" },
          "children": [
            {
              "tagName": "p",
              "style": {
                "textTransform": "uppercase",
                "letterSpacing": "0.18em",
                "fontSize": "0.8rem",
                "fontWeight": "600",
                "marginBottom": "1rem",
                "color": "#bbf7d0"
              },
              "textContent": "${state.eyebrow}"
            },
            {
              "tagName": "h1",
              "style": {
                "fontFamily": "var(--font-heading)",
                "fontSize": "clamp(2.5rem, 6vw, 4.25rem)",
                "fontWeight": "700",
                "lineHeight": "1.08",
                "margin": "0 0 1.25rem",
                "letterSpacing": "-0.02em"
              },
              "textContent": "${state.heading}"
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "clamp(1.1rem, 2vw, 1.35rem)",
                "lineHeight": "1.6",
                "margin": "0 0 2rem",
                "opacity": "0.94",
                "maxWidth": "50ch"
              },
              "textContent": "${state.subheading}"
            },
            {
              "tagName": "div",
              "style": { "display": "flex", "gap": "0.75rem", "flexWrap": "wrap" },
              "children": [
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.ctaHref}" },
                  "style": {
                    "display": "inline-block",
                    "backgroundColor": "var(--color-accent)",
                    "color": "var(--color-text-white)",
                    "padding": "0.9rem 2.25rem",
                    "borderRadius": "999px",
                    "fontSize": "1.05rem",
                    "fontWeight": "600",
                    "textDecoration": "none",
                    "boxShadow": "0 8px 24px rgba(234,88,12,0.35)",
                    "transition": "background-color 0.15s, transform 0.15s",
                    ":hover": {
                      "backgroundColor": "var(--color-accent-hover)",
                      "transform": "translateY(-1px)"
                    }
                  },
                  "textContent": "${state.cta}"
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "${state.cta2Href}" },
                  "style": {
                    "display": "${state.cta2 ? 'inline-block' : 'none'}",
                    "border": "1px solid rgba(255,255,255,0.6)",
                    "color": "var(--color-text-white)",
                    "padding": "0.9rem 2rem",
                    "borderRadius": "999px",
                    "fontSize": "1.05rem",
                    "fontWeight": "600",
                    "textDecoration": "none",
                    "transition": "background-color 0.15s",
                    ":hover": { "backgroundColor": "rgba(255,255,255,0.14)" }
                  },
                  "textContent": "${state.cta2}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
