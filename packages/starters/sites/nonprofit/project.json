{
  "$schema": "./project.schema.json",
  "name": "Rivertown Foundation",
  "url": "https://example.com",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Rivertown Foundation is a community nonprofit running local programs in food security, youth mentoring, housing, and job training — powered by neighbors helping neighbors."
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.svg"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.googleapis.com"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.gstatic.com",
        "crossorigin": ""
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Nunito:wght@400;500;600;700;800&display=swap"
      }
    }
  ],
  "$media": {
    "--": "1200px",
    "--lg": "(max-width: 1024px)",
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 560px)"
  },
  "style": {
    "--color-primary": "#2f7d55",
    "--color-primary-hover": "#256845",
    "--color-primary-deep": "#173a2b",
    "--color-primary-soft": "#e3efe6",
    "--color-accent": "#f26a3d",
    "--color-accent-hover": "#e0552b",
    "--color-accent-soft": "#ffe6da",
    "--color-gold": "#e9a63d",
    "--color-gold-soft": "#fbeccf",
    "--color-ink": "#22332a",
    "--color-bg-dark": "#173a2b",
    "--color-bg-cream": "#fbf5ec",
    "--color-bg-cream-deep": "#f6ecda",
    "--color-bg-mint": "#eef6ef",
    "--color-bg-white": "#ffffff",
    "--color-text-primary": "#23342b",
    "--color-text-secondary": "#3f5147",
    "--color-text-muted": "#61715f",
    "--color-text-white": "#ffffff",
    "--color-border": "#eadfce",
    "--color-border-strong": "#dccdb4",
    "--font-display": "'Fraunces', Georgia, 'Times New Roman', serif",
    "--font-heading": "'Fraunces', Georgia, 'Times New Roman', serif",
    "--font-body": "'Nunito', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "--max-width": "1180px",
    "--max-width-wide": "1300px",
    "--max-width-narrow": "760px",
    "--radius": "1.25rem",
    "--radius-sm": "0.75rem",
    "--radius-lg": "2rem",
    "--radius-pill": "999px",
    "--shadow-card": "0 2px 6px rgba(23,58,43,0.05), 0 20px 44px -26px rgba(23,58,43,0.3)",
    "--shadow-float": "0 34px 74px -32px rgba(23,58,43,0.4)",
    "margin": "0",
    "padding": "0",
    "fontFamily": "var(--font-body)",
    "fontSize": "17px",
    "lineHeight": "1.7",
    "color": "var(--color-text-primary)",
    "backgroundColor": "var(--color-bg-white)",
    "WebkitFontSmoothing": "antialiased"
  },
  "images": {
    "optimize": true,
    "widths": [320, 640, 960, 1280, 1920],
    "formats": ["webp", "avif"],
    "quality": {
      "webp": 80,
      "avif": 65,
      "jpeg": 80,
      "png": 80
    },
    "sizes": "(max-width: 768px) 100vw, 50vw",
    "lazyLoad": true
  },
  "content": {
    "programs": {
      "source": "./content/programs/",
      "format": "Markdown",
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "format": "image"
          },
          "order": {
            "type": "number"
          }
        },
        "required": ["title", "summary"]
      }
    }
  },
  "build": {
    "outDir": "./dist",
    "format": "directory",
    "trailingSlash": "always"
  },
  "extensions": ["@jxsuite/parser"]
}
