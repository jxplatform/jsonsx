{
  "tagName": "mu-pagehead",
  "state": {
    "kicker": "",
    "title": "",
    "standfirst": "",
    "metaLabel": "",
    "metaValue": ""
  },
  "style": {
    "display": "block",
    "backgroundColor": "var(--color-card)",
    "paddingBlock": "clamp(2.5rem, 6vw, 4.5rem)",
    "paddingInline": "var(--gutter)"
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "maxWidth": "var(--max-width)",
        "marginInline": "auto",
        "display": "grid",
        "gridTemplateColumns": "var(--label-column) minmax(0, 1fr)",
        "columnGap": "clamp(1.5rem, 4vw, 3.5rem)",
        "@--md": {
          "gridTemplateColumns": "minmax(0, 1fr)",
          "rowGap": "1.25rem"
        }
      },
      "children": [
        {
          "tagName": "p",
          "style": {
            "margin": "0.55rem 0 0",
            "fontFamily": "var(--font-label)",
            "fontSize": "0.68rem",
            "lineHeight": "1.5",
            "letterSpacing": "var(--label-tracking)",
            "textTransform": "var(--label-case)",
            "color": "var(--color-pigment)"
          },
          "textContent": "${state.kicker}"
        },
        {
          "tagName": "div",
          "style": { "minWidth": "0" },
          "children": [
            {
              "tagName": "h1",
              "style": {
                "margin": "0",
                "fontFamily": "var(--font-display)",
                "fontSize": "clamp(2.2rem, 5.2vw, 3.9rem)",
                "fontWeight": "700",
                "lineHeight": "calc(1.02 * var(--leading-scale))",
                "letterSpacing": "var(--display-tracking)",
                "maxWidth": "18ch"
              },
              "textContent": "${state.title}"
            },
            {
              "tagName": "p",
              "style": {
                "display": "${state.standfirst ? 'block' : 'none'}",
                "margin": "1.4rem 0 0",
                "fontSize": "1.12rem",
                "lineHeight": "1.65",
                "color": "var(--color-muted)",
                "maxWidth": "52ch"
              },
              "textContent": "${state.standfirst}"
            },
            {
              "tagName": "div",
              "style": {
                "display": "${state.metaValue ? 'flex' : 'none'}",
                "flexWrap": "wrap",
                "gap": "0.9rem",
                "marginBlockStart": "1.9rem",
                "paddingBlockStart": "1rem",
                "borderBlockStart": "1px solid var(--color-hairline)",
                "fontFamily": "var(--font-label)",
                "fontSize": "0.68rem",
                "letterSpacing": "var(--label-tracking)",
                "textTransform": "var(--label-case)"
              },
              "children": [
                {
                  "tagName": "span",
                  "style": { "color": "var(--color-muted)" },
                  "textContent": "${state.metaLabel}"
                },
                {
                  "tagName": "span",
                  "style": { "color": "var(--color-pigment)" },
                  "textContent": "${state.metaValue}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
