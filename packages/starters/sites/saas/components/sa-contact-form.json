{
  "tagName": "sa-contact-form",
  "state": {
    "heading": "Send us a message",
    "note": "This is a demo form. Wire it to your CRM or email in pages/contact.md."
  },
  "style": {
    "display": "block"
  },
  "children": [
    {
      "tagName": "h3",
      "style": {
        "fontFamily": "var(--font-heading)",
        "fontSize": "1.5rem",
        "fontWeight": "600",
        "letterSpacing": "-0.01em",
        "margin": "0 0 1.25rem"
      },
      "textContent": "${state.heading}"
    },
    {
      "tagName": "form",
      "attributes": { "action": "#", "method": "post" },
      "style": { "display": "grid", "gap": "1rem", "alignContent": "start" },
      "children": [
        {
          "tagName": "input",
          "attributes": {
            "type": "text",
            "name": "name",
            "placeholder": "Your name",
            "required": "true",
            "aria-label": "Your name"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "inherit"
          }
        },
        {
          "tagName": "input",
          "attributes": {
            "type": "email",
            "name": "email",
            "placeholder": "Work email",
            "required": "true",
            "aria-label": "Work email"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "inherit"
          }
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "1rem",
            "@--sm": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "company",
                "placeholder": "Company",
                "aria-label": "Company"
              },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem",
                "fontFamily": "inherit"
              }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "number",
                "name": "team",
                "min": "1",
                "max": "10000",
                "placeholder": "Team size",
                "aria-label": "Team size"
              },
              "style": {
                "width": "100%",
                "padding": "0.75rem 0.9rem",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "fontSize": "1rem",
                "fontFamily": "inherit"
              }
            }
          ]
        },
        {
          "tagName": "textarea",
          "attributes": {
            "name": "message",
            "rows": "4",
            "placeholder": "How can we help?",
            "aria-label": "Message"
          },
          "style": {
            "width": "100%",
            "padding": "0.75rem 0.9rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontFamily": "inherit"
          }
        },
        {
          "tagName": "button",
          "attributes": { "type": "submit" },
          "textContent": "Send message",
          "style": {
            "backgroundColor": "var(--color-primary)",
            "color": "var(--color-text-white)",
            "padding": "0.85rem 1.5rem",
            "border": "none",
            "borderRadius": "var(--radius)",
            "fontSize": "1rem",
            "fontWeight": "600",
            "cursor": "pointer",
            "justifySelf": "start",
            "transition": "background-color 0.15s",
            ":hover": { "backgroundColor": "var(--color-primary-hover)" }
          }
        },
        {
          "tagName": "p",
          "style": { "fontSize": "0.85rem", "color": "var(--color-text-muted)", "margin": "0" },
          "textContent": "${state.note}"
        }
      ]
    }
  ]
}
