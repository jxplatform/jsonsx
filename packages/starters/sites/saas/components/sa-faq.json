          "tagName": "div",
          "style": {
            "display": "${state.open === 0 ? 'block' : 'none'}",
            "padding": "0 0.25rem 1.4rem",
            "color": "var(--color-text-muted)",
            "fontSize": "1rem",
            "lineHeight": "1.7",
            "maxWidth": "60ch"
          },
          "textContent": "Absolutely. Upgrade, downgrade, or cancel from your billing settings whenever you like. Changes are prorated automatically, so you only ever pay for what you use."
