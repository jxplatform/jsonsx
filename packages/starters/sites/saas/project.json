{
  "$schema": "./project.schema.json",
  "name": "Flowlark",
  "url": "https://example.com",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Flowlark is the modern product platform that helps teams plan, ship, and scale — with pricing that flexes from your first project to your thousandth."
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.svg"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.googleapis.com"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preconnect",
        "href": "https://fonts.gstatic.com",
        "crossorigin": ""
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      }
    }
  ],
  "$media": {
    "--": "1200px",
    "--lg": "(max-width: 1024px)",
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 640px)"
  },
  "style": {
    "--color-primary": "#7c74ff",
    "--color-primary-hover": "#948dff",
    "--color-ink": "#050509",
    "--color-bg-dark": "#0a0a14",
    "--color-bg-cream": "#14141f",
    "--color-bg-surface": "#14141f",
    "--color-bg-white": "#0a0a14",
    "--color-bg": "#0a0a14",
    "--color-bg-elev": "#14141f",
    "--color-bg-elev2": "#1c1c2b",
    "--color-text-primary": "#edecf5",
    "--color-text-white": "#ffffff",
    "--color-text-muted": "#9494ac",
    "--color-border": "#262636",
    "--color-line": "#262636",
    "--color-accent": "#7c74ff",
    "--color-accent-soft": "rgba(124, 116, 255, 0.14)",
    "--grad": "linear-gradient(120deg, #8b7bff 0%, #22d3ee 55%, #f472b6 100%)",
    "--grad-btn": "linear-gradient(120deg, #7c74ff, #a06bff)",
    "--glow": "rgba(124, 116, 255, 0.45)",
    "--font-heading": "'Space Grotesk', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "--font-body": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "--max-width": "1200px",
    "--max-width-narrow": "820px",
    "--radius": "0.9rem",
    "margin": "0",
    "padding": "0",
    "fontFamily": "var(--font-body)",
    "lineHeight": "1.6",
    "color": "var(--color-text-primary)",
    "backgroundColor": "var(--color-bg)",
    "table": {
      "width": "100%",
      "borderCollapse": "collapse",
      "fontSize": "0.95rem",
      "textAlign": "left",
      "backgroundColor": "var(--color-bg-white)",
      "thead": {
        "borderBottom": "1px solid var(--color-border)",
        "th": {
          "padding": "1rem 1.1rem",
          "fontFamily": "var(--font-heading)",
          "fontSize": "0.9rem",
          "fontWeight": "600",
          "color": "var(--color-text-primary)"
        }
      },
      "tbody": {
        "tr": {
          "borderBottom": "1px solid var(--color-border)"
        },
        "td": {
          "padding": "0.9rem 1.1rem",
          "color": "var(--color-text-muted)",
          ":first-child": {
            "color": "var(--color-text-primary)",
            "fontWeight": "600"
          }
        }
      }
    }
  },
  "images": {
    "optimize": true,
    "widths": [320, 640, 960, 1280, 1920],
    "formats": ["webp", "avif"],
    "quality": {
      "webp": 80,
      "avif": 65,
      "jpeg": 80,
      "png": 80
    },
    "sizes": "(max-width: 768px) 100vw, 50vw",
    "lazyLoad": true
  },
  "content": {
    "testimonials": {
      "source": "./content/testimonials/",
      "format": "Markdown",
      "schema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": ["quote", "author"]
      }
    }
  },
  "build": {
    "outDir": "./dist",
    "format": "directory",
    "trailingSlash": "always"
  },
  "extensions": ["@jxsuite/parser"]
}
