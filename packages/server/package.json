{
  "name": "@jxsuite/server",
  "version": "0.33.0",
  "description": "Jx development server with live reload, server-side proxy, and studio integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/server"
  },
  "files": [
    "src/"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./ai-api": "./src/ai-api.ts",
    "./packages": "./src/packages.ts",
    "./refactor": "./src/refactor/index.ts",
    "./resolve": "./src/resolve.ts",
    "./types": "./src/types.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "upgrade": "bunx npm-check-updates -u && bun install",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage"
  },
  "dependencies": {
    "@jxsuite/compiler": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/parser": "workspace:^",
    "@jxsuite/runtime": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "chokidar": "^5.0.0",
    "zod": "^4.4.3"
  }
}
