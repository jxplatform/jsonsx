{
  "name": "@jxsuite/server",
  "version": "1.1.0",
  "description": "Jx development server with live reload, server-side proxy, and studio integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git",
    "directory": "packages/server"
  },
  "files": [
    "src/"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./dev": "./src/dev.ts",
    "./ai-api": "./src/ai-api.ts",
    "./data": "./src/data-api.ts",
    "./import-api": "./src/import-api.ts",
    "./packages": "./src/packages.ts",
    "./project-server": "./src/project-server.ts",
    "./refactor": "./src/refactor/index.ts",
    "./resolve": "./src/resolve.ts",
    "./types": "./src/types.ts",
    "./jx-mounts": "./src/jx-mounts.ts",
    "./dev-vars": "./src/dev-vars.ts"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "upgrade": "bunx npm-check-updates -u && bun install",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage"
  },
  "dependencies": {
    "@jxsuite/collab": "workspace:^",
    "@jxsuite/compiler": "workspace:^",
    "@jxsuite/create": "workspace:^",
    "@jxsuite/import": "workspace:^",
    "@jxsuite/protocol": "workspace:^",
    "@jxsuite/runtime": "workspace:^",
    "@jxsuite/schema": "workspace:^",
    "@jxsuite/starters": "workspace:^",
    "chokidar": "^5.0.0",
    "kysely": "^0.29.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jxsuite/auth": "workspace:^",
    "@jxsuite/connector": "workspace:^",
    "@jxsuite/parser": "workspace:^"
  }
}
