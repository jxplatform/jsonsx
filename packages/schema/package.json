{
  "dependencies": {
    "@webref/css": "^8.7.3",
    "@webref/elements": "^2.8.0",
    "@webref/idl": "^3.83.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "description": "JSON Schema 2020-12 meta-schema generator for Jx documents",
  "exports": {
    ".": "./src/schema.ts",
    "./asset-paths": "./src/asset-paths.ts",
    "./component-meta": "./src/component-meta.ts",
    "./extension-registry": "./src/extension-registry.ts",
    "./format-registry": "./src/format-registry.ts",
    "./project-schemas": "./src/project-schemas.ts",
    "./validate-project": "./src/validate-project.ts",
    "./types": "./types.ts",
    "./guards": "./src/guards.ts",
    "./locale": "./src/locale.ts",
    "./intl": "./src/intl.ts",
    "./media-type": "./src/media-type.ts",
    "./overlays": "./src/overlays.ts",
    "./ijson": "./src/ijson.ts",
    "./parse": "./src/parse.ts",
    "./defs": "./defs/index.ts",
    "./schema.json": "./schema.json",
    "./project-schema.json": "./project-schema.json",
    "./extension-manifest.schema.json": "./extension-manifest.schema.json",
    "./schemas/project.core.schema.json": "./schemas/project.core.schema.json",
    "./schemas/project.fields.schema.json": "./schemas/project.fields.schema.json",
    "./schemas/document.paths.schema.json": "./schemas/document.paths.schema.json"
  },
  "files": [
    "src/",
    "defs/",
    "schemas/",
    "types.ts",
    "*.json",
    "!package.json"
  ],
  "license": "MIT",
  "name": "@jxsuite/schema",
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "directory": "packages/schema",
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git"
  },
  "scripts": {
    "schema": "bun run src/schema.ts",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bun update --latest && bun install"
  },
  "type": "module",
  "version": "2.2.0",
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1"
  }
}
