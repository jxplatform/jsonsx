{
  "dependencies": {
    "@webref/css": "^8.5.7",
    "@webref/elements": "^2.7.1",
    "@webref/idl": "^3.79.0"
  },
  "description": "JSON Schema 2020-12 meta-schema generator for Jx documents",
  "exports": {
    ".": "./src/schema.ts",
    "./types": "./types.ts",
    "./defs": "./defs/index.ts",
    "./schema.json": "./schema.json",
    "./project-schema.json": "./project-schema.json"
  },
  "files": [
    "src/",
    "defs/",
    "types.ts",
    "*.json",
    "!package.json"
  ],
  "license": "MIT",
  "name": "@jxsuite/schema",
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "directory": "packages/schema",
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git"
  },
  "scripts": {
    "schema": "bun run src/schema.ts",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "upgrade": "bunx npm-check-updates -u && bun install"
  },
  "type": "module",
  "version": "0.25.4",
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1"
  }
}
