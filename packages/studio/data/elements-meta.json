{
  "$id": "elements-meta",
  "title": "HTML Element Metadata",
  "description": "Inline scoping and inline toolbar action metadata for HTML elements.",
  "$convertGroups": {
    "text": ["p", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote"],
    "container": [
      "div",
      "section",
      "article",
      "aside",
      "main",
      "header",
      "footer",
      "nav",
      "search"
    ],
    "list": ["ul", "ol"]
  },
  "$defs": {
    "p": {
      "$convertTo": "text",
      "$convertToWhenEmpty": ["text", "container"],
      "$inlineChildren": [
        "em",
        "strong",
        "del",
        "code",
        "a",
        "span",
        "br",
        "img",
        "b",
        "i",
        "u",
        "sub",
        "sup",
        "s"
      ],
      "$inlineActions": [
        {
          "tag": "strong",
          "label": "Bold",
          "icon": "sp-icon-text-bold",
          "command": "bold"
        },
        {
          "tag": "em",
          "label": "Italic",
          "icon": "sp-icon-text-italic",
          "command": "italic"
        },
        {
          "tag": "u",
          "label": "Underline",
          "icon": "sp-icon-text-underline",
          "command": "underline"
        },
        {
          "tag": "del",
          "label": "Strikethrough",
          "icon": "sp-icon-text-strikethrough",
          "command": "strikethrough"
        },
        {
          "tag": "sup",
          "label": "Superscript",
          "icon": "sp-icon-text-superscript",
          "command": "superscript"
        },
        {
          "tag": "sub",
          "label": "Subscript",
          "icon": "sp-icon-text-subscript",
          "command": "subscript"
        },
        { "tag": "code", "label": "Code", "icon": "sp-icon-code", "command": "code" },
        { "tag": "a", "label": "Link", "icon": "sp-icon-link", "command": "link" }
      ]
    },
    "h1": {
      "$convertTo": "text",
      "$inlineChildren": ["em", "strong", "code", "a", "span", "br", "b", "i", "u", "sub", "sup"],
      "$inlineActions": [
        {
          "tag": "strong",
          "label": "Bold",
          "icon": "sp-icon-text-bold",
          "command": "bold"
        },
        {
          "tag": "em",
          "label": "Italic",
          "icon": "sp-icon-text-italic",
          "command": "italic"
        },
        { "tag": "code", "label": "Code", "icon": "sp-icon-code", "command": "code" },
        { "tag": "a", "label": "Link", "icon": "sp-icon-link", "command": "link" }
      ]
    },
    "h2": {
      "$convertTo": "text",
      "$inlineChildren": ["em", "strong", "code", "a", "span", "br", "b", "i", "u", "sub", "sup"],
      "$inlineActions": "h1"
    },
    "h3": {
      "$convertTo": "text",
      "$inlineChildren": ["em", "strong", "code", "a", "span", "br", "b", "i", "u", "sub", "sup"],
      "$inlineActions": "h1"
    },
    "h4": {
      "$convertTo": "text",
      "$inlineChildren": ["em", "strong", "code", "a", "span", "br", "b", "i", "u", "sub", "sup"],
      "$inlineActions": "h1"
    },
    "h5": {
      "$convertTo": "text",
      "$inlineChildren": ["em", "strong", "code", "a", "span", "br", "b", "i", "u", "sub", "sup"],
