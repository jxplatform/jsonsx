        "del",
        "code",
        "a",
        "span",
        "br",
        "img",
        "b",
        "i",
        "u",
        "sub",
        "sup",
        "s"
      ],
      "$inlineActions": "p"
    },
    "td": {
      "$inlineChildren": [
        "em",
        "strong",
        "del",
        "code",
        "a",
