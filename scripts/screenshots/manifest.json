{
  "outDir": "sites/jxsuite.com/public/screenshots",
  "server": {
    "url": "http://localhost:3000",
    "studioPath": "/packages/studio/index.html"
  },
  "defaults": {
    "project": "examples",
    "viewport": { "width": 1920, "height": 1000 },
    "deviceScaleFactor": 2,
    "theme": "dark",
    "clip": { "selector": "#app" },
    "waitFor": [{ "type": "canvasReady" }, { "type": "fonts" }, { "type": "settle", "frames": 2 }]
  },
  "shots": [
    {
      "name": "hero",
      "project": "sites/jxsuite.com",
      "file": "pages/index.md",
      "viewport": { "width": 1920, "height": 1200 },
      "canvasMode": "preview",
      "actions": [
        { "do": "setActivity", "value": "layers" },
        { "do": "select", "path": ["children", 0, "children", 0, "children", 1] },
        { "do": "setRightTab", "value": "properties" },
        { "do": "setStatus", "value": "Ready" }
      ]
    },
    {
      "name": "mode-manage",
      "file": "pages/index.json",
      "canvasMode": "preview",
      "actions": [
        { "do": "setActivity", "value": "files" },
        { "do": "setStatus", "value": "Ready" },
        { "do": "openBrowse" }
      ],
      "waitFor": [
        { "type": "selector", "selector": ".browse-modal" },
        { "type": "fonts" },
        { "type": "settle", "frames": 4 }
      ]
    },
    {
      "name": "mode-edit",
      "file": "content/posts/getting-started.md",
      "canvasMode": "edit",
      "actions": [
        { "do": "setActivity", "value": "files" },
        { "do": "setStatus", "value": "Ready" }
      ]
    },
    {
      "name": "mode-design",
      "file": "components/responsive-card.json",
      "canvasMode": "design",
      "actions": [
        { "do": "setActivity", "value": "layers" },
        { "do": "setZoom", "value": 0.45 },
        { "do": "select", "path": ["children", 0] },
        { "do": "setRightTab", "value": "style" },
        { "do": "setStatus", "value": "Ready" }
      ]
    },
    {
      "name": "mode-script",
      "file": "components/todo-app.json",
      "canvasMode": "design",
      "actions": [
        { "do": "setActivity", "value": "state" },
        { "do": "editDef", "defName": "addItem" },
        { "do": "setStatus", "value": "Ready" }
      ],
      "waitFor": [
        { "type": "selector", "selector": ".monaco-editor .view-lines" },
        { "type": "fonts" },
        { "type": "settle", "frames": 2 }
      ]
    },
    {
      "name": "new-project",
      "file": "pages/index.json",
      "canvasMode": "preview",
      "actions": [{ "do": "openNewProject" }, { "do": "setStatus", "value": "Ready" }],
      "waitFor": [
        { "type": "selector", "selector": ".new-project-modal" },
        { "type": "fonts" },
        { "type": "timeout", "ms": 400 },
        { "type": "settle", "frames": 3 }
      ],
      "regions": [{ "name": "new-project-modal", "selector": ".new-project-modal", "padding": 24 }]
    },
    {
      "name": "git-panel",
      "file": "components/todo-app.json",
      "canvasMode": "design",
      "actions": [
        { "do": "setActivity", "value": "git" },
        { "do": "setStatus", "value": "Ready" }
      ],
      "waitFor": [
        { "type": "selector", "selector": ".git-panel" },
        { "type": "fonts" },
        { "type": "timeout", "ms": 1500 },
        { "type": "settle", "frames": 3 }
      ],
      "clip": "none",
      "regions": [
        { "name": "git-panel", "selector": "#left-panel", "padding": 0 },
        { "name": "git-commit", "selector": ".git-commit-area", "padding": 16 }
      ]
    },
    {
      "name": "state-panel",
      "file": "components/todo-app.json",
      "canvasMode": "design",
      "actions": [
        { "do": "setActivity", "value": "state" },
        { "do": "setStatus", "value": "Ready" }
      ]
    },
    {
      "name": "design-inspector",
      "file": "components/responsive-card.json",
      "canvasMode": "design",
      "actions": [
        { "do": "setActivity", "value": "layers" },
        { "do": "select", "path": ["children", 0] },
        { "do": "setRightTab", "value": "style" },
        { "do": "setStatus", "value": "Ready" }
      ],
      "waitFor": [
        { "type": "canvasReady" },
        { "type": "selector", "selector": "#right-panel" },
        { "type": "fonts" },
        { "type": "settle", "frames": 3 }
      ],
      "clip": "none",
      "regions": [{ "name": "design-inspector", "selector": "#right-panel", "padding": 0 }]
    },
    {
      "name": "stylebook",
      "project": "sites/jxsuite.com",
      "file": "components/feature-card.json",
      "canvasMode": "stylebook",
      "actions": [
        { "do": "setZoom", "value": 0.6 },
        { "do": "setStatus", "value": "Ready" }
      ],
      "waitFor": [
        { "type": "canvasReady" },
        { "type": "fonts" },
        { "type": "timeout", "ms": 5000 },
        { "type": "settle", "frames": 4 }
      ]
    }
  ]
}
