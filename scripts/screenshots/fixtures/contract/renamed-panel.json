{
  "contract": 1,
  "outDir": "docs/images",
  "server": { "studioPath": "packages/studio", "url": "http://127.0.0.1:3000" },
  "defaults": {},
  "shots": [
    {
      "name": "properties-bar",
      "docs": ["studio/interface/inspector"],
      "clip": "none",
