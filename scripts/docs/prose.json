{
  "$comment": "Rules for scripts/docs/check-prose.ts. A `ban` is wrong every time it appears and an exception needs an allow entry stating the fact that makes it one. A `budget` is per-file DEBT that may only fall: above the entry fails, below it also fails, and `--ratchet` prints the corrected map. Each rewrite deletes its files' entries; when the map empties, the rule becomes a ban and the map goes away. Cadence measures the style guide leaves to a person (sentence length, `rather than`, bold labels, forced triples) are deliberately absent and printed by --report instead.",
  "rules": [
    {
      "id": "em-dash",
      "tier": "budget",
      "regex": "[\\u2014\\u2015]",
      "hint": "Rewrite it away: move a list behind a colon, split the sentence, or use a comma or parentheses. See docs/extending/contributing/docs.md.",
      "$note": "A bare em dash alone in a table cell is the value 'none' and is skipped in code, not here."
    },
    {
      "id": "en-dash",
      "tier": "ban",
      "regex": "\\u2013",
      "hint": "An en dash between numbers or key names is a range and is allowed. Anywhere else, rewrite it."
    },
    {
      "id": "curly-quote",
      "tier": "ban",
      "regex": "[\\u2018\\u2019\\u201C\\u201D]",
      "hint": "Use straight quotes. Curly ones arrive from a word processor, not from this repo."
    },
    {
      "id": "emoji",
      "tier": "ban",
      "regex": "\\p{Extended_Pictographic}\\uFE0F?",
      "flags": "u",
      "hint": "No decorative emoji. A glyph the app itself draws is a UI label and needs an allow entry saying so."
    },
    {
      "id": "chatbot-residue",
      "tier": "ban",
      "regex": "I hope this helps|Let me know if|Would you like me to|Certainly!|Great question|You're absolutely right|without further ado|Here's what you need to know",
      "flags": "i",
      "hint": "Chatbot framing left in the page. Delete it."
    },
    {
      "id": "neg-parallel",
      "tier": "ban",
      "regex": "[Ii]t's not (just|only|merely)|[Nn]ot only\\b[^.]{0,60},\\s*but\\b|isn't (just )?about[^.]{0,40}\\.\\s*It's about|^No \\w+\\.\\s*No \\w+\\.",
      "hint": "Negative parallelism (\"it's not just X, it's Y\") is the most-cited AI structure there is. State the claim directly."
    },
    {
      "id": "stock-heading",
      "tier": "ban",
      "regex": "^(Conclusion|Summary|In summary|Key takeaways|Takeaways|Challenges|Future outlook|Final thoughts|TL;DR)\\b",
      "contexts": ["heading"],
      "hint": "An essay-shaped section heading. Say what the section is about instead."
    },
    {
      "id": "ai-vocab",
      "tier": "ban",
      "regex": "\\b(delve|delves|delving|seamless|seamlessly|comprehensive|holistic|intricate|intricacies|cutting-edge|groundbreaking|transformative|tapestry|testament|pivotal|crucial|vital|realm|landscape|underscore|underscores|underscoring|showcase|showcases|showcasing)\\b|(?<![-\\w])robust\\b|\\bshed light\\b|\\bpave the way\\b|\\bat its core\\b|\\bworth noting\\b|\\bin order to\\b|\\bdue to the fact\\b|\\bhas the ability to\\b|\\bwhen it comes to\\b|\\blet's (dive|explore|break)\\b|\\bleverag(e|es|ing|ed)\\s|\\bfoster(s|ing|ed)?\\s+(a|an|the)\\b",
      "flags": "i",
      "hint": "A word AI writing reaches for far more often than people do. Say the plain thing."
    }
  ],
