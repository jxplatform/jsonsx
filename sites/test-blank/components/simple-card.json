{
  "$id": "SimpleCard",
  "tagName": "simple-card",
  "state": {
    "title": "Card Title",
    "description": "A short description goes here.",
    "buttonLabel": "Learn More",
    "href": "/"
  },
  "style": {
    "display": "block",
    "padding": "1.5rem",
    "border": "1px solid var(--color-border)",
    "borderRadius": "var(--radius)",
    "backgroundColor": "var(--color-bg-surface)",
    "maxWidth": "24rem"
  },
  "children": [
    {
      "tagName": "h3",
      "textContent": "${state.title}",
      "style": {
        "margin": "0 0 0.75rem",
        "fontSize": "1.5rem",
        "fontWeight": "600",
        "color": "var(--color-text-primary)"
      }
    },
    {
      "tagName": "p",
      "textContent": "${state.description}",
      "style": {
        "margin": "0 0 1.5rem",
        "fontSize": "1rem",
        "lineHeight": "1.6",
        "color": "var(--color-text-secondary)"
      }
    },
    {
      "tagName": "a",
      "textContent": "${state.buttonLabel}",
      "attributes": {
        "href": "${state.href}"
      },
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "padding": "0.75rem 1.5rem",
        "borderRadius": "var(--radius)",
        "backgroundColor": "var(--color-accent)",
        "color": "var(--color-text-primary)",
        "textDecoration": "none",
        "fontWeight": "600"
      }
    }
  ]
}
