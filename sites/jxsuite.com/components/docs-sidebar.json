{
  "tagName": "docs-sidebar",
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "gap": "0.25rem",
    "padding": "1.5rem 0",
    "interpolateSize": "allow-keywords",
    "& .nav-section": { "marginBottom": "0.75rem" },
    "& .nav-group": { "marginTop": "0.125rem" },
    "& .nav-section-label": {
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between",
      "gap": "0.5rem",
      "cursor": "pointer",
      "listStyle": "none",
      "userSelect": "none",
      "borderRadius": "6px",
      "fontSize": "0.6875rem",
      "fontWeight": "600",
      "color": "var(--color-text-muted)",
      "textTransform": "uppercase",
      "letterSpacing": "0.08em",
      "fontFamily": "var(--font-mono)",
      "padding": "0.375rem 0.75rem",
      "marginBottom": "0.25rem"
    },
    "& .nav-section-label:hover": { "color": "var(--color-text-primary)" },
    "& .nav-section-label::-webkit-details-marker": { "display": "none" },
    "& .nav-section-label::after": {
      "content": "''",
      "flex": "none",
      "width": "0.4rem",
      "height": "0.4rem",
      "marginRight": "0.15rem",
      "borderRight": "1.5px solid currentColor",
      "borderBottom": "1.5px solid currentColor",
      "transform": "rotate(-45deg)",
      "transition": "transform 0.2s ease",
      "opacity": "0.55"
    },
    "& .nav-group-label": {
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between",
      "gap": "0.5rem",
      "cursor": "pointer",
      "listStyle": "none",
      "userSelect": "none",
      "borderRadius": "6px",
      "fontSize": "0.875rem",
      "color": "var(--color-text-secondary)",
      "padding": "0.375rem 0.75rem"
    },
    "& .nav-group-label:hover": {
      "color": "var(--color-text-primary)",
      "backgroundColor": "var(--color-bg-surface)"
    },
    "& .nav-group-label::-webkit-details-marker": { "display": "none" },
    "& .nav-group-label::after": {
      "content": "''",
      "flex": "none",
      "width": "0.4rem",
      "height": "0.4rem",
      "marginRight": "0.15rem",
      "borderRight": "1.5px solid currentColor",
      "borderBottom": "1.5px solid currentColor",
      "transform": "rotate(-45deg)",
      "transition": "transform 0.2s ease",
      "opacity": "0.55"
    },
    "& details[open] > .nav-section-label::after": { "transform": "rotate(45deg)" },
    "& details[open] > .nav-group-label::after": { "transform": "rotate(45deg)" },
    "& .nav-link": {
      "display": "block",
      "color": "var(--color-text-secondary)",
      "textDecoration": "none",
      "fontSize": "0.875rem",
      "padding": "0.375rem 0.75rem",
      "borderRadius": "6px",
      "transition": "color 0.15s, background-color 0.15s"
    },
    "& .nav-link:hover": {
      "color": "var(--color-text-primary)",
      "backgroundColor": "var(--color-bg-surface)"
    },
    "& .nav-group .nav-link": { "paddingLeft": "1.5rem" },
    "& .nav-link[aria-current='page']": {
      "color": "var(--color-text-primary)",
      "backgroundColor": "var(--color-bg-surface)",
      "fontWeight": "500"
    },
    "& details::details-content": {
      "blockSize": "0",
      "overflow": "hidden",
      "transition": "block-size 0.25s ease, content-visibility 0.25s allow-discrete"
    },
    "& details[open]::details-content": { "blockSize": "auto" },
    "@(prefers-reduced-motion: reduce)": {
      "& details::details-content": { "transition": "none" },
      "& .nav-section-label::after": { "transition": "none" },
      "& .nav-group-label::after": { "transition": "none" },
      "& .nav-link": { "transition": "none" }
    }
  },
  "children": [{ "tagName": "slot" }]
}
