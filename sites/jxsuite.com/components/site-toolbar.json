{
  "tagName": "site-toolbar",
  "style": {
    "display": "block",
    "position": "sticky",
    "top": "0",
    "zIndex": "100",
    "backgroundColor": "var(--color-backdrop)",
    "backdropFilter": "blur(12px)",
    "borderBottom": "1px solid var(--color-border)",
    "padding": "0 clamp(1rem, 3vw, 2rem)"
  },
  "children": [
    {
      "tagName": "nav",
      "attributes": { "aria-label": "Main" },
      "style": {
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "space-between",
        "height": "3.5rem"
      },
      "children": [
        {
          "tagName": "a",
          "attributes": { "href": "/" },
          "style": {
            "color": "var(--color-text-primary)",
            "textDecoration": "none",
            "fontWeight": "700",
            "fontSize": "1.0625rem",
            "letterSpacing": "-0.02em",
            "display": "flex",
            "alignItems": "center",
            "gap": "0.5rem"
          },
          "children": [
            {
              "tagName": "img",
              "attributes": {
                "src": "/favicon.svg",
                "alt": "Jx Suite",
                "width": "20",
                "height": "20"
              }
            },
            "Suite"
          ]
        },
        {
          "$title": "Toolbar End",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "clamp(0.75rem, 2vw, 1.25rem)"
          },
          "children": [
            { "tagName": "site-search" },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "clamp(1rem, 3vw, 1.75rem)",
                "@--md": { "display": "none" }
              },
              "children": [
                {
                  "tagName": "a",
                  "attributes": { "href": "/studio" },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["Studio"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/features" },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["Features"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/templates" },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["Templates"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/compare" },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["Compare"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/docs/start/first-project" },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["Docs"]
                },
                { "tagName": "theme-toggle" },
                {
                  "tagName": "a",
                  "attributes": {
                    "href": "https://github.com/jxsuite/jx",
                    "target": "_blank",
                    "rel": "noopener noreferrer"
                  },
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "500",
                    "transition": "color 0.15s",
                    ":hover": { "color": "var(--color-text-primary)" }
                  },
                  "children": ["GitHub"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/download" },
                  "style": {
                    "display": "inline-flex",
                    "alignItems": "center",
                    "backgroundColor": "var(--color-accent-solid)",
                    "color": "white",
                    "textDecoration": "none",
                    "fontSize": "0.875rem",
                    "fontWeight": "600",
                    "padding": "0.4rem 1rem",
                    "borderRadius": "var(--radius)",
                    "transition": "background-color 0.15s"
                  },
                  "children": ["Download"]
                }
              ]
            },
            {
              "$title": "Hamburger Button",
              "tagName": "button",
              "attributes": {
                "popovertarget": "site-mobile-menu",
                "aria-label": "Open menu"
              },
              "style": {
                "display": "none",
                "flexDirection": "column",
                "justifyContent": "space-between",
                "width": "28px",
                "height": "20px",
                "background": "none",
                "border": "none",
                "cursor": "pointer",
                "padding": "0",
                "@--md": { "display": "flex" }
              },
              "children": [
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                },
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                },
                {
                  "tagName": "span",
                  "style": {
                    "display": "block",
                    "height": "2px",
                    "width": "100%",
                    "backgroundColor": "var(--color-text-primary)",
                    "borderRadius": "2px"
                  }
                }
              ]
            }
          ]
        },
        {
          "$title": "Mobile Menu Popover",
          "tagName": "nav",
          "id": "site-mobile-menu",
          "attributes": { "popover": "auto", "aria-label": "Site menu" },
          "style": {
            "inset": "0 0 0 auto",
            "width": "min(300px, 80vw)",
            "height": "100vh",
            "backgroundColor": "var(--color-bg-secondary)",
            "borderLeft": "1px solid var(--color-border)",
            "border": "none",
            "margin": "0",
            "padding": "4.5rem 0 2rem",
            "boxShadow": "-8px 0 24px var(--color-shadow)",
            "flexDirection": "column",
            "transform": "translateX(100%)",
            "transition": "transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), display 0.3s allow-discrete, overlay 0.3s allow-discrete",
            ":popover-open": { "display": "flex", "transform": "translateX(0)" },
            "::backdrop": {
              "backgroundColor": "rgba(0, 0, 0, 0.5)",
              "opacity": "0",
              "transition": "opacity 0.3s ease, display 0.3s allow-discrete, overlay 0.3s allow-discrete"
            },
            "&:popover-open::backdrop": { "opacity": "1" },
            "@starting-style": {
              ":popover-open": { "transform": "translateX(100%)" },
              "&:popover-open::backdrop": { "opacity": "0" }
            },
            "@(prefers-reduced-motion: reduce)": {
              "transition": "none",
              "transform": "none",
              ":popover-open": { "transform": "none" },
              "::backdrop": { "transition": "none" }
            }
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "justifyContent": "flex-end",
                "padding": "0 1.25rem 0.5rem"
              },
              "children": [
                {
                  "tagName": "button",
                  "attributes": {
                    "popovertarget": "site-mobile-menu",
                    "popovertargetaction": "hide",
                    "aria-label": "Close menu"
                  },
                  "style": {
                    "background": "none",
                    "border": "none",
                    "cursor": "pointer",
                    "padding": "0.5rem",
                    "fontSize": "1.25rem",
                    "lineHeight": "1",
                    "color": "var(--color-text-secondary)"
                  },
                  "textContent": "✕"
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/studio"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Studio"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/features"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Features"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/templates"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Templates"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/compare"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Compare"]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/docs/start/first-project"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Docs"]
            },
            {
              "$title": "GitHub link — opens a new tab, so the drawer stays open behind it",
              "tagName": "a",
              "attributes": {
                "href": "https://github.com/jxsuite/jx",
                "target": "_blank",
                "rel": "noopener noreferrer"
              },
              "style": {
                "display": "block",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["GitHub"]
            },
            {
              "$title": "Mobile Scheme Row",
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "justifyContent": "space-between",
                "padding": "0.9rem 1.5rem",
                "color": "var(--color-text-primary)",
                "fontSize": "1rem",
                "fontWeight": "500",
                "borderBottom": "1px solid var(--color-border-subtle)"
              },
              "children": ["Color scheme", { "tagName": "theme-toggle" }]
            },
            {
              "tagName": "a",
              "attributes": {
                "href": "/download"
              },
              "style": {
                "display": "block",
                "margin": "1.25rem 1.5rem 0",
                "padding": "0.75rem 1.5rem",
                "backgroundColor": "var(--color-accent-solid)",
                "color": "white",
                "textDecoration": "none",
                "fontSize": "1rem",
                "fontWeight": "600",
                "borderRadius": "var(--radius)",
                "textAlign": "center"
              },
              "children": ["Download"]
            }
          ]
        }
      ]
    }
  ]
}
