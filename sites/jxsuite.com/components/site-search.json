{
  "$schema": "../document.schema.json",
  "$id": "SiteSearch",
  "$description": "Docs search palette: a toolbar trigger opening a native-popover modal over the headless @jxsuite/search client (Cmd+K / Ctrl+K / '/'). Flat ranked rows carry a breadcrumb, a highlighted title, and a highlighted body excerpt, and deep-link to heading anchors.",

  "state": {
    "searchQuery": "",
    "searchResults": [],
    "searchCount": 0,
    "searchReady": false,
    "searchActive": 0,
    "searchInit": {
      "$prototype": "Function",
      "$src": "npm:@jxsuite/search/client",
      "$lazy": true,
      "parameters": ["state"]
    },
    "runSearch": {
      "$prototype": "Function",
      "$src": "npm:@jxsuite/search/client",
      "$lazy": true,
      "parameters": ["state", "e"]
    },
    "onMount": {
      "$prototype": "Function",
      "arguments": ["state"],
      "body": "const host = this; const boot = () => state.searchInit(state); const pop = host.querySelector('#site-search-modal'); if (pop) { pop.addEventListener('toggle', (ev) => { const inp = pop.querySelector('input'); if (ev.newState === 'open') { boot(); if (inp) { inp.focus(); inp.select(); } } else { if (inp) { inp.value = ''; } state.searchQuery = ''; state.searchResults = []; state.searchCount = 0; state.searchActive = 0; } }); } if (!document.__jxSearchHotkeys) { document.__jxSearchHotkeys = true; document.addEventListener('keydown', (ev) => { const t = ev.target; const tag = t && t.tagName; const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (t && t.isContentEditable); if (((ev.metaKey || ev.ctrlKey) && ev.key === 'k') || (ev.key === '/' && !typing)) { const p = document.getElementById('site-search-modal'); if (p && !p.matches(':popover-open')) { ev.preventDefault(); p.showPopover(); } } }); }"
    }
  },

  "tagName": "site-search",
  "style": {
    "display": "inline-flex",

    "& .mag": {
      "position": "relative",
      "display": "inline-block",
      "flex": "none",
      "width": "0.72rem",
      "height": "0.72rem",
      "border": "1.5px solid currentColor",
      "borderRadius": "50%",
      "opacity": "0.85"
    },
    "& .mag::after": {
      "content": "''",
      "position": "absolute",
      "top": "100%",
      "left": "100%",
      "width": "1.5px",
      "height": "0.38rem",
      "background": "currentColor",
      "borderRadius": "1px",
      "transform": "translate(-1.5px, -1.5px) rotate(-45deg)",
      "transformOrigin": "top center"
    },
    "& .mag-lg": {
      "width": "0.92rem",
      "height": "0.92rem",
      "borderWidth": "1.75px"
    },
    "& .mag-lg::after": {
      "width": "1.75px",
      "height": "0.5rem"
    },

    "& .search-row": {
      "display": "flex",
      "alignItems": "flex-start",
      "gap": "0.7rem",
      "padding": "0.55rem 0.7rem",
      "borderRadius": "8px",
      "textDecoration": "none",
      "color": "var(--color-text-primary)",
      "scrollMarginBlock": "0.4rem"
    },
    "& .search-row:hover": {
      "backgroundColor": "var(--color-bg-surface)"
    },
    "& .search-row.is-active": {
      "backgroundColor": "var(--color-bg-surface)",
      "boxShadow": "inset 0 0 0 1px var(--color-border-subtle)"
    },
    "& .row-icon": {
      "flex": "none",
      "width": "1.1rem",
      "marginTop": "0.55rem",
      "textAlign": "center",
      "fontSize": "0.8rem",
      "lineHeight": "1",
      "color": "var(--color-text-muted)"
    },
    "& .row-body": {
      "flex": "1",
      "minWidth": "0"
    },
    "& .row-crumbs": {
      "fontSize": "0.6875rem",
      "color": "var(--color-text-muted)",
      "whiteSpace": "nowrap",
      "overflow": "hidden",
      "textOverflow": "ellipsis"
    },
    "& .row-title": {
      "fontSize": "0.875rem",
      "fontWeight": "600",
      "lineHeight": "1.35",
      "whiteSpace": "nowrap",
      "overflow": "hidden",
      "textOverflow": "ellipsis"
    },
    "& .row-excerpt": {
      "marginTop": "0.15rem",
      "fontSize": "0.78rem",
      "lineHeight": "1.45",
      "color": "var(--color-text-secondary)",
      "display": "-webkit-box",
      "WebkitLineClamp": "2",
      "WebkitBoxOrient": "vertical",
      "overflow": "hidden"
    },
    "& .hl": {
      "backgroundColor": "color-mix(in srgb, var(--color-accent) 22%, transparent)",
      "color": "inherit",
      "borderRadius": "3px",
      "padding": "0 0.1em",
      "fontWeight": "600"
    },
    "& .row-enter": {
      "flex": "none",
      "alignSelf": "center",
      "fontSize": "0.8rem",
      "color": "var(--color-text-muted)",
      "opacity": "0",
      "transition": "opacity 0.12s"
    },
    "& .search-row.is-active .row-enter": {
      "opacity": "1"
    },

    "& .quick-link": {
      "display": "block",
      "padding": "0.4rem 0.7rem",
      "borderRadius": "6px",
      "fontSize": "0.8125rem",
      "color": "var(--color-text-secondary)",
      "textDecoration": "none"
    },
    "& .quick-link:hover": {
      "backgroundColor": "var(--color-bg-surface)",
      "color": "var(--color-text-primary)"
    },

    "& .foot-key": {
      "fontFamily": "inherit",
      "fontSize": "0.6875rem",
      "border": "1px solid var(--color-border)",
      "borderRadius": "4px",
      "padding": "0.05rem 0.3rem",
      "marginRight": "0.3rem",
      "color": "var(--color-text-secondary)"
    }
  },

  "children": [
    {
      "$title": "Search Trigger",
      "tagName": "button",
      "attributes": {
        "type": "button",
        "popovertarget": "site-search-modal",
        "aria-label": "Search the docs"
      },
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "gap": "0.5rem",
        "background": "var(--color-bg-surface)",
        "border": "1px solid var(--color-border)",
        "borderRadius": "var(--radius)",
        "color": "var(--color-text-secondary)",
        "cursor": "pointer",
        "fontSize": "0.8125rem",
        "padding": "0.35rem 0.65rem",
        "transition": "color 0.15s, border-color 0.15s",
        ":hover": {
          "color": "var(--color-text-primary)",
          "borderColor": "var(--color-text-secondary)"
        },
        "@--md": {
          "padding": "0.4rem",
          "height": "2rem",
          "width": "2rem",
          "justifyContent": "center"
        }
      },
      "children": [
        {
          "tagName": "span",
          "attributes": { "class": "mag", "aria-hidden": "true" }
        },
        {
          "tagName": "span",
          "textContent": "Search",
          "style": { "@--md": { "display": "none" } }
        },
        {
          "tagName": "kbd",
          "attributes": { "aria-hidden": "true" },
          "textContent": "⌘K",
          "style": {
            "fontFamily": "inherit",
            "fontSize": "0.6875rem",
            "border": "1px solid var(--color-border)",
            "borderRadius": "4px",
            "padding": "0.05rem 0.3rem",
            "color": "var(--color-text-secondary)",
            "@--md": { "display": "none" }
          }
        }
      ]
    },
    {
      "$title": "Search Modal",
      "tagName": "div",
      "id": "site-search-modal",
      "attributes": { "popover": "auto" },
      "style": {
        "width": "min(640px, 94vw)",
        "margin": "10vh auto auto",
        "padding": "0",
        "overflow": "hidden",
        "backgroundColor": "var(--color-bg-primary)",
        "border": "1px solid var(--color-border)",
        "borderRadius": "var(--radius-lg)",
        "boxShadow": "0 24px 64px var(--color-shadow-strong)",
        "opacity": "0",
        "transform": "translateY(-8px)",
        "transition": "opacity 0.15s ease, transform 0.15s ease, display 0.15s allow-discrete, overlay 0.15s allow-discrete",
        ":popover-open": { "opacity": "1", "transform": "translateY(0)" },
        "::backdrop": {
          "backgroundColor": "rgba(0, 0, 0, 0.45)",
          "backdropFilter": "blur(2px)",
          "opacity": "0",
          "transition": "opacity 0.15s ease, display 0.15s allow-discrete, overlay 0.15s allow-discrete"
        },
        "&:popover-open::backdrop": { "opacity": "1" },
        "@starting-style": {
          ":popover-open": { "opacity": "0", "transform": "translateY(-8px)" },
          "&:popover-open::backdrop": { "opacity": "0" }
        },
        "@(prefers-reduced-motion: reduce)": {
          "transition": "none",
          "transform": "none",
          ":popover-open": { "transform": "none" },
          "::backdrop": { "transition": "none" }
        }
      },
      "children": [
        {
          "$title": "Search Header",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "0.7rem",
            "padding": "0 0.9rem",
            "borderBottom": "1px solid var(--color-border)",
            "color": "var(--color-text-muted)"
          },
          "children": [
            {
              "tagName": "span",
              "attributes": { "class": "mag mag-lg", "aria-hidden": "true" }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "site-search-query",
                "placeholder": "Search the docs…",
                "aria-label": "Search the docs",
                "autocomplete": "off",
                "autocorrect": "off",
                "spellcheck": "false",
                "role": "combobox",
                "aria-autocomplete": "list",
                "aria-controls": "site-search-listbox",
                "aria-expanded": "${state.searchResults.length > 0 ? 'true' : 'false'}",
                "aria-activedescendant": "${state.searchResults.length > 0 ? 'jx-sr-' + state.searchActive : ''}"
              },
              "oninput": { "$ref": "#/state/runSearch" },
              "onkeydown": {
                "$prototype": "Function",
                "arguments": ["state", "e"],
                "body": "const r = state.searchResults || []; const n = r.length; const go = (i) => { state.searchActive = i; requestAnimationFrame(() => { const el = document.getElementById('jx-sr-' + i); if (el) { el.scrollIntoView({ block: 'nearest' }); } }); }; if (e.key === 'ArrowDown') { e.preventDefault(); if (n) { go((state.searchActive + 1) % n); } } else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) { go((state.searchActive - 1 + n) % n); } } else if (e.key === 'Home' && n) { e.preventDefault(); go(0); } else if (e.key === 'End' && n) { e.preventDefault(); go(n - 1); } else if (e.key === 'Enter') { const hit = r[state.searchActive]; if (hit) { e.preventDefault(); if (e.metaKey || e.ctrlKey) { window.open(hit.url, '_blank', 'noopener'); } else { location.href = hit.url; } } }"
              },
              "style": {
                "flex": "1",
                "minWidth": "0",
                "background": "transparent",
                "border": "none",
                "outline": "none",
                "color": "var(--color-text-primary)",
                "fontSize": "1rem",
                "padding": "0.95rem 0",
                ":focus-visible": { "outline": "none" }
              }
            },
            {
              "tagName": "button",
              "attributes": {
                "type": "button",
                "popovertarget": "site-search-modal",
                "popovertargetaction": "hide",
                "aria-label": "Close search"
              },
              "style": {
                "flex": "none",
                "background": "transparent",
                "border": "1px solid var(--color-border)",
                "borderRadius": "5px",
                "color": "var(--color-text-muted)",
                "cursor": "pointer",
                "fontFamily": "inherit",
                "fontSize": "0.6875rem",
                "letterSpacing": "0.04em",
                "padding": "0.15rem 0.4rem",
                "transition": "color 0.15s, border-color 0.15s",
                ":hover": {
                  "color": "var(--color-text-primary)",
                  "borderColor": "var(--color-text-secondary)"
                }
              },
              "children": ["ESC"]
            }
          ]
        },
        {
          "$title": "Results",
          "tagName": "div",
          "id": "site-search-listbox",
          "attributes": {
            "role": "listbox",
            "aria-label": "Search results"
          },
          "style": {
            "maxHeight": "min(60vh, 26rem)",
            "overflowY": "auto",
            "overscrollBehavior": "contain",
            "padding": "0.4rem"
          },
          "children": [
            {
              "$prototype": "Array",
              "items": { "$ref": "#/state/searchResults" },
              "map": {
                "tagName": "a",
                "id": "jx-sr-${index}",
                "attributes": {
                  "href": "${item.url}",
                  "role": "option",
                  "aria-selected": "${index === state.searchActive ? 'true' : 'false'}",
                  "class": "search-row ${index === state.searchActive ? 'is-active' : ''}"
                },
                "children": [
                  {
                    "tagName": "span",
                    "attributes": { "class": "row-icon", "aria-hidden": "true" },
                    "textContent": "${item.heading ? '#' : '▤'}"
                  },
                  {
                    "tagName": "span",
                    "attributes": { "class": "row-body" },
                    "children": [
                      {
                        "tagName": "span",
                        "attributes": { "class": "row-crumbs" },
                        "style": { "display": "${item.crumbs.length ? 'block' : 'none'}" },
                        "textContent": "${item.crumbs.join(' › ')}"
                      },
                      {
                        "tagName": "span",
                        "attributes": { "class": "row-title" },
                        "children": [
                          {
                            "$prototype": "Array",
                            "items": { "$ref": "$map/item/titleTokens" },
                            "map": {
                              "tagName": "span",
                              "attributes": { "class": "${item.m ? 'hl' : ''}" },
                              "textContent": "${item.t}"
                            }
                          }
                        ]
                      },
                      {
                        "tagName": "span",
                        "attributes": { "class": "row-excerpt" },
                        "children": [
                          {
                            "$prototype": "Array",
                            "items": { "$ref": "$map/item/excerptTokens" },
                            "map": {
                              "tagName": "span",
                              "attributes": { "class": "${item.m ? 'hl' : ''}" },
                              "textContent": "${item.t}"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "tagName": "span",
                    "attributes": { "class": "row-enter", "aria-hidden": "true" },
                    "textContent": "↵"
                  }
                ]
              }
            },
            {
              "$title": "Empty State",
              "tagName": "div",
              "attributes": { "role": "status" },
              "textContent": "${!state.searchQuery ? '' : state.searchResults.length ? '' : state.searchReady ? 'No results for “' + state.searchQuery + '”' : 'Loading the search index…'}",
              "style": {
                "color": "var(--color-text-secondary)",
                "fontSize": "0.85rem",
                "textAlign": "center",
                "padding": "${state.searchQuery && !state.searchResults.length ? '1.6rem 1rem' : '0'}"
              }
            },
            {
              "$title": "Idle Quick Links",
              "tagName": "div",
              "style": {
                "display": "${state.searchQuery ? 'none' : 'block'}",
                "padding": "0.3rem 0 0.2rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "textContent": "Jump to",
                  "style": {
                    "padding": "0.25rem 0.7rem 0.35rem",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase",
                    "color": "var(--color-text-muted)"
                  }
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/docs/start/install", "class": "quick-link" },
                  "children": ["Install Jx Studio"]
                },
                {
                  "tagName": "a",
                  "attributes": { "href": "/docs/start/first-project", "class": "quick-link" },
                  "children": ["Build your first project"]
                },
                {
                  "tagName": "a",
                  "attributes": {
                    "href": "/docs/framework/concepts/documents",
                    "class": "quick-link"
                  },
                  "children": ["Document format"]
                },
                {
                  "tagName": "a",
                  "attributes": {
                    "href": "/docs/framework/reference/formulas",
                    "class": "quick-link"
                  },
                  "children": ["Formula catalog"]
                }
              ]
            }
          ]
        },
        {
          "$title": "Search Footer",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "space-between",
            "gap": "1rem",
            "padding": "0.5rem 0.9rem",
            "borderTop": "1px solid var(--color-border)",
            "backgroundColor": "var(--color-bg-secondary)",
            "fontSize": "0.75rem",
            "color": "var(--color-text-muted)"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.9rem",
                "@--sm": { "gap": "0.6rem" }
              },
              "children": [
                {
                  "tagName": "span",
                  "children": [
                    { "tagName": "kbd", "attributes": { "class": "foot-key" }, "textContent": "↵" },
                    "select"
                  ]
                },
                {
                  "tagName": "span",
                  "children": [
                    {
                      "tagName": "kbd",
                      "attributes": { "class": "foot-key" },
                      "textContent": "↑↓"
                    },
                    "navigate"
                  ]
                },
                {
                  "tagName": "span",
                  "style": { "@--sm": { "display": "none" } },
                  "children": [
                    {
                      "tagName": "kbd",
                      "attributes": { "class": "foot-key" },
                      "textContent": "esc"
                    },
                    "close"
                  ]
                }
              ]
            },
            {
              "tagName": "span",
              "textContent": "${state.searchQuery ? state.searchCount + (state.searchCount === 1 ? ' result' : ' results') : 'Search the docs'}"
            }
          ]
        }
      ]
    }
  ]
}
