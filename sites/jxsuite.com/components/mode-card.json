{
  "tagName": "mode-card",
  "state": {
    "name": "Mode",
    "description": "Description",
    "image": "",
    "imageAlt": ""
  },
  "style": {
    "display": "flex",
    "flexDirection": "column",
    "borderRadius": "var(--radius-lg)",
    "border": "1px solid var(--color-border)",
    "backgroundColor": "var(--color-bg-surface)",
    "overflow": "hidden"
  },
  "children": [
    {
      "tagName": "img",
      "attributes": {
        "src": "${state.image}",
        "alt": "${state.imageAlt}",
        "width": "3840",
        "height": "2000",
        "loading": "lazy",
        "decoding": "async"
      },
      "style": {
        "display": "block",
        "width": "100%",
        "height": "auto",
        "borderBottom": "1px solid var(--color-border)"
      }
    },
    {
      "tagName": "div",
      "style": {
        "display": "flex",
        "flexDirection": "column",
        "gap": "0.75rem",
        "padding": "1.5rem"
      },
      "children": [
        {
          "tagName": "h3",
          "style": {
            "fontSize": "1.125rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0",
            "color": "var(--color-text-primary)"
          },
          "textContent": "${state.name}"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.875rem",
            "lineHeight": "1.6",
            "color": "var(--color-text-secondary)",
            "margin": "0"
          },
          "textContent": "${state.description}"
        }
      ]
    }
  ]
}
