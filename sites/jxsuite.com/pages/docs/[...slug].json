{
  "$layout": "./layouts/docs.json",
  "$paths": {
    "contentType": "docs",
    "param": "slug",
    "field": "id"
  },
  "title": "${state.page.data.title} — Jx Suite",
  "$head": [
    {
      "tagName": "meta",
      "attributes": { "name": "description", "content": "${state.page.data.description}" }
    }
  ],
  "state": {
    "page": {
      "$prototype": "ContentEntry",
      "contentType": "docs",
      "id": { "$ref": "#/$params/slug" }
    }
  },
  "children": [
    {
      "tagName": "article",
      "style": {
        "maxWidth": "720px",
        "& img": {
          "display": "block",
          "maxWidth": "100%",
          "maxHeight": "900px",
          "width": "auto",
          "height": "auto",
          "borderRadius": "8px",
          "border": "1px solid var(--color-border)",
          "margin": "1.75rem auto"
        },
        "& kbd": {
          "display": "inline-block",
          "padding": "0.125rem 0.375rem",
          "fontSize": "0.8125rem",
          "fontFamily": "var(--font-mono)",
          "color": "var(--color-text-primary)",
          "backgroundColor": "var(--color-bg-surface)",
          "border": "1px solid var(--color-border)",
          "borderBottomWidth": "2px",
          "borderRadius": "4px"
        }
      },
      "children": "${state.page.$children ?? []}"
    }
  ]
}
