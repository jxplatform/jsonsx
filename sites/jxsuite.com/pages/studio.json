{
  "title": "Jx Studio — A visual IDE for the web.",
  "$layout": "./layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Jx Studio is a visual IDE for designing, editing, and shipping websites. Create a project, design on a canvas, wire up logic, and commit to git — all in one app. Saves as plain files. No lock-in."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/mode-card.json" },
    { "$ref": "../components/check-item.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(5rem, 10vw, 8rem) clamp(1rem, 3vw, 2rem) clamp(3rem, 6vw, 4rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.12), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "960px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "Jx Studio" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2.25rem, 5vw, 3.75rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.5rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "A visual IDE for the people who build websites."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "clamp(1.0625rem, 2vw, 1.25rem)",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto 2.5rem",
                "maxWidth": "640px"
              },
              "textContent": "Create a project, design on a canvas, edit content inline, and wire up interactivity — then commit to git without leaving the app. Everything saves to plain JSON and Markdown: the same files your compiler reads, your git tracks, and your team reviews."
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "gap": "0.75rem",
                "justifyContent": "center",
                "flexWrap": "wrap",
                "marginBottom": "3rem"
              },
              "children": [
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/download",
                    "props.label": "Download Studio",
                    "props.variant": "primary"
                  }
                },
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/docs/start/first-project",
                    "props.label": "Install via CLI",
                    "props.variant": "secondary"
                  }
                }
              ]
            },
            {
              "tagName": "img",
              "attributes": {
                "src": "/screenshots/hero.png",
                "alt": "Jx Studio editing a website — layers panel, live canvas, and element inspector",
                "width": "3840",
                "height": "2400",
                "loading": "eager",
                "decoding": "async"
              },
              "style": {
                "display": "block",
                "width": "100%",
                "height": "auto",
                "maxWidth": "960px",
                "margin": "0 auto",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius-lg)",
                "boxShadow": "0 24px 64px rgba(0, 0, 0, 0.45)"
              }
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(4rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "var(--max-width)", "margin": "0 auto" },
          "children": [
            {
              "tagName": "div",
              "style": { "textAlign": "center", "marginBottom": "3rem" },
              "children": [
                {
                  "tagName": "section-label",
                  "attributes": { "props.text": "What you do in Studio" }
                },
                {
                  "tagName": "h2",
                  "style": {
                    "fontSize": "clamp(1.75rem, 4vw, 2.5rem)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.03em",
                    "margin": "0 0 1rem"
                  },
                  "textContent": "The right surface for every part of the build."
                },
                {
                  "tagName": "p",
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "maxWidth": "560px",
                    "margin": "0 auto",
                    "fontSize": "1.0625rem"
                  },
                  "textContent": "Move between surfaces as the work changes — from file management to content authoring to visual design to scripting."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "display": "grid",
                "gridTemplateColumns": "repeat(auto-fit, minmax(min(420px, 100%), 1fr))",
                "gap": "1.5rem"
              },
              "children": [
                {
                  "tagName": "mode-card",
                  "attributes": {
                    "props.name": "Manage",
                    "props.image": "/screenshots/mode-manage.png",
                    "props.imageAlt": "Jx Studio Manage Files modal with live previews of every project file",
                    "props.description": "Project explorer, content collections, and file operations with live previews. Create pages, upload media, and build content models — the CMS layer, without the CMS."
                  }
                },
                {
                  "tagName": "mode-card",
                  "attributes": {
                    "props.name": "Edit",
                    "props.image": "/screenshots/mode-edit.png",
                    "props.imageAlt": "Jx Studio editing markdown content inline with a WYSIWYG editor",
                    "props.description": "Click any text and type. Slash commands for blocks, frontmatter forms on the side. WYSIWYG content authoring that feels like Notion — saves as clean Markdown."
                  }
                },
                {
                  "tagName": "mode-card",
                  "attributes": {
                    "props.name": "Design",
                    "props.image": "/screenshots/mode-design.png",
                    "props.imageAlt": "Jx Studio design canvas showing one component across four responsive breakpoints with a style inspector",
                    "props.description": "A live canvas for every breakpoint and a full CSS inspector — spacing, type, color, layout, hover states, and design tokens. Everything you'd do in DevTools, but persistent."
                  }
                },
                {
                  "tagName": "mode-card",
                  "attributes": {
                    "props.name": "Script",
                    "props.image": "/screenshots/mode-script.png",
                    "props.imageAlt": "Jx Studio editing a component state function in the Monaco code editor",
                    "props.description": "State, data, and events in structured panels, plus a Monaco editor for functions and integrations. When a client asks for 'one little interactive thing,' you stop saying no."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(4rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "maxWidth": "var(--max-width)",
            "margin": "0 auto",
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "clamp(3rem, 6vw, 5rem)",
            "alignItems": "center",
            "@--md": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "div",
              "children": [
                {
                  "tagName": "section-label",
                  "attributes": { "props.text": "Start a project" }
                },
                {
                  "tagName": "h2",
                  "style": {
                    "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1.2",
                    "margin": "0 0 1rem"
                  },
                  "textContent": "From zero to editing in a minute."
                },
                {
                  "tagName": "p",
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "fontSize": "1.0625rem",
                    "lineHeight": "1.7",
                    "margin": "0 0 2rem"
                  },
                  "textContent": "Name a project, pick where it lives, choose how it deploys, and Studio scaffolds a clean starter you can build on. Already have a project? Open it from disk or clone it straight from git."
                },
                {
                  "tagName": "div",
                  "style": { "display": "flex", "flexDirection": "column", "gap": "0.75rem" },
                  "children": [
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Guided setup — name, directory, and production URL"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Pick a deploy target: Static, Cloudflare, Node, or Bun"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Open any Jx project from disk, or clone from git"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": { "props.text": "Jump back into recent projects and files" }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "img",
              "attributes": {
                "src": "/screenshots/new-project.png",
                "alt": "Jx Studio New Project dialog — name, directory, production URL, and deployment adapter picker",
                "width": "3840",
                "height": "2000",
                "loading": "lazy",
                "decoding": "async"
              },
              "style": {
                "display": "block",
                "width": "100%",
                "height": "auto",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius-lg)"
              }
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(4rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "maxWidth": "var(--max-width)",
            "margin": "0 auto",
            "display": "grid",
            "gridTemplateColumns": "1fr 1fr",
            "gap": "clamp(3rem, 6vw, 5rem)",
            "alignItems": "center",
            "@--md": { "gridTemplateColumns": "1fr" }
          },
          "children": [
            {
              "tagName": "img",
              "attributes": {
                "src": "/screenshots/git-panel.png",
                "alt": "Jx Studio Source Control panel — branch, commit-and-sync, and a tree of changed files",
                "width": "480",
                "height": "1880",
                "loading": "lazy",
                "decoding": "async"
              },
              "style": {
                "display": "block",
                "width": "100%",
                "maxWidth": "320px",
                "height": "auto",
                "margin": "0 auto",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius-lg)",
                "@--md": { "order": "2" }
              }
            },
            {
              "tagName": "div",
              "children": [
                {
                  "tagName": "section-label",
                  "attributes": { "props.text": "Ship code, not deploys" }
                },
                {
                  "tagName": "h2",
                  "style": {
                    "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1.2",
                    "margin": "0 0 1rem"
                  },
                  "textContent": "Git is built in. Deploys just happen."
                },
                {
                  "tagName": "p",
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "fontSize": "1.0625rem",
                    "lineHeight": "1.7",
                    "margin": "0 0 2rem"
                  },
                  "textContent": "Review changes, write a message, and commit-and-sync — right from Studio. Starting fresh? Publish to GitHub in a click and Studio creates the repo for you. From there, your host builds the static site on every push."
                },
                {
                  "tagName": "div",
                  "style": { "display": "flex", "flexDirection": "column", "gap": "0.75rem" },
                  "children": [
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Stage, diff, commit, branch, and push — all in-app"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Publish to GitHub with one click (creates the repo)"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Your host builds on push — no deploy scripts to babysit"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": { "props.text": "Every change is a clean, reviewable git diff" }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(4rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "720px", "margin": "0 auto", "textAlign": "center" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "No lock-in" }
            },
            {
              "tagName": "h2",
              "style": {
                "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.02em",
                "lineHeight": "1.2",
                "margin": "0 0 1rem"
              },
              "textContent": "The visual builder that doesn't own your files."
            },
            {
              "tagName": "p",
              "style": {
                "color": "var(--color-text-secondary)",
                "fontSize": "1.0625rem",
                "lineHeight": "1.7",
                "margin": "0 auto 2rem",
                "maxWidth": "560px"
              },
              "textContent": "Most visual builders trap your work in a proprietary format you can't read, can't version, and can't leave. Jx Studio reads and writes the same JSON and Markdown you'd write by hand. Close the app — your site is still there, still readable, still yours."
            },
            {
              "tagName": "div",
              "style": {
                "display": "grid",
                "gridTemplateColumns": "1fr 1fr",
                "gap": "0.75rem",
                "textAlign": "left",
                "maxWidth": "560px",
                "margin": "0 auto",
                "@--sm": { "gridTemplateColumns": "1fr" }
              },
              "children": [
                {
                  "tagName": "check-item",
                  "attributes": { "props.text": "Opens any Jx project from disk — no import step" }
                },
                {
                  "tagName": "check-item",
                  "attributes": { "props.text": "Saves standard JSON and Markdown" }
                },
                {
                  "tagName": "check-item",
                  "attributes": { "props.text": "Works offline — no cloud, no account" }
                },
                {
                  "tagName": "check-item",
                  "attributes": { "props.text": "Git-friendly output — clean diffs, no blobs" }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(5rem, 10vw, 8rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 60% 50% at 50% 100%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "560px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "h2",
              "style": {
                "fontSize": "clamp(1.75rem, 4vw, 2.5rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.03em",
                "margin": "0 0 1rem"
              },
              "textContent": "Download and start building."
            },
            {
              "tagName": "p",
              "style": {
                "color": "var(--color-text-secondary)",
                "margin": "0 0 2rem",
                "fontSize": "1.0625rem",
                "lineHeight": "1.7"
              },
              "textContent": "Free, open source, and yours to keep. No accounts, no subscriptions, no vendor approval."
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "gap": "0.75rem",
                "justifyContent": "center",
                "flexWrap": "wrap"
              },
              "children": [
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/download",
                    "props.label": "Download Studio",
                    "props.variant": "primary"
                  }
                },
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/features",
                    "props.label": "See all features",
                    "props.variant": "secondary"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
