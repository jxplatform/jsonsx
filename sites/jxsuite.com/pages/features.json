                        "props.text": "Automatic image optimization (WebP, AVIF)"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Static HTML with zero JS by default"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Deploy to GitHub Pages, Cloudflare, Vercel, anywhere"
                      }
                    },
                    {
                      "tagName": "check-item",
