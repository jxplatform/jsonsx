          "children": [
            {
              "tagName": "div",
              "children": [
                {
                  "tagName": "section-label",
                  "attributes": {
                    "props.text": "The engine · Accounts & data"
                  }
                },
                {
                  "tagName": "h2",
                  "style": {
                    "fontSize": "clamp(1.5rem, 3vw, 2.25rem)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em",
                    "lineHeight": "1.2",
                    "margin": "0 0 1rem"
                  },
                  "textContent": "Add a login. Add a database."
                },
                {
                  "tagName": "p",
                  "style": {
                    "color": "var(--color-text-secondary)",
                    "fontSize": "1.0625rem",
                    "lineHeight": "1.7",
                    "margin": "0 0 2rem"
                  },
                  "textContent": "Some sites are more than pages. The auth extension serves sessions and sign-in at /_jx/auth; the connector extension serves your tables at /_jx/data, where the roles you declare in project.json become per-table permission rules. Declare both in project.json, pick a server adapter, and the build emits the worker that runs them. Pages stay prerendered either way: every visitor is served the same logged-out HTML, and the logged-in view renders in the browser once the session resolves."
                },
                {
                  "tagName": "div",
                  "style": {
                    "display": "flex",
                    "flexDirection": "column",
                    "gap": "0.75rem"
                  },
                  "children": [
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Email + password and social sign-in, via Better Auth"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Per-table rules: public, authenticated, owner, or by role"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Connect Cloudflare D1, Supabase, or SQLite"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Read and write rows with filter, sort, and pagination"
                      }
                    },
                    {
                      "tagName": "check-item",
                      "attributes": {
                        "props.text": "Server functions keep API keys and secrets off the client"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "backgroundColor": "var(--color-bg-secondary)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius-lg)",
                "padding": "2rem",
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.75rem",
                "lineHeight": "1.8",
                "color": "var(--color-text-secondary)",
                "whiteSpace": "pre-wrap"
              },
              "textContent": "// project.json\n{\n  \"extensions\": [\"@jxsuite/connector\", \"@jxsuite/auth\"],\n  \"connections\": {\n    \"main\": { \"provider\": \"d1\", \"binding\": \"DB\" }\n  },\n  \"auth\": {\n    \"connection\": \"main\",\n    \"providers\": { \"github\": {} },\n    \"roles\": [\"admin\"]\n  },\n  \"data\": {\n    \"comments\": {\n      \"connection\": \"main\",\n      \"ownerField\": \"author_id\",\n      \"permissions\": {\n        \"read\": \"public\",\n        \"insert\": \"authenticated\",\n        \"update\": \"owner\"\n      },\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": { \"message\": { \"type\": \"string\" } }\n      }\n    }\n  },\n  \"build\": { \"adapter\": \"cloudflare-workers\" }\n}"
            }
          ]
        }
