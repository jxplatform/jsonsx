              "tagName": "h2",
              "style": {
                "fontSize": "clamp(1.75rem, 4vw, 2.5rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.03em",
                "margin": "0 0 3rem"
              },
              "textContent": "From brochure sites to interactive applications."
            },
            {
              "tagName": "div",
              "style": {
                "display": "grid",
                "gridTemplateColumns": "repeat(auto-fit, minmax(200px, 1fr))",
                "gap": "1px",
                "backgroundColor": "var(--color-border)",
                "borderRadius": "var(--radius-lg)",
                "overflow": "hidden",
                "border": "1px solid var(--color-border)",
                "textAlign": "left"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Marketing sites"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Documentation"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Blogs & portfolios"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "E-commerce catalogs"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Interactive dashboards"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Multi-language sites"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Calculators & tools"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Landing pages"
                },
                {
                  "tagName": "div",
                  "style": {
                    "padding": "1.25rem",
                    "backgroundColor": "var(--color-bg-secondary)",
                    "fontSize": "0.9375rem"
                  },
                  "textContent": "Component libraries"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(5rem, 10vw, 8rem) clamp(1rem, 3vw, 2rem)",
        "borderTop": "1px solid var(--color-border)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 60% 50% at 50% 100%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "560px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "h2",
              "style": {
                "fontSize": "clamp(1.75rem, 4vw, 2.5rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.03em",
                "margin": "0 0 1rem"
              },
              "textContent": "Ready to build?"
            },
            {
              "tagName": "p",
              "style": {
                "color": "var(--color-text-secondary)",
                "margin": "0 0 2rem",
                "fontSize": "1.0625rem",
                "lineHeight": "1.7"
              },
              "textContent": "Start your first project in under a minute. No accounts. No credit card. Just code."
            },
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "gap": "0.75rem",
                "justifyContent": "center",
                "flexWrap": "wrap"
              },
              "children": [
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/docs/getting-started",
                    "props.label": "Get Started",
                    "props.variant": "primary"
                  }
                },
                {
                  "tagName": "cta-button",
                  "attributes": {
                    "props.href": "/compare",
                    "props.label": "See the Comparison",
                    "props.variant": "secondary"
                  }
                }
              ]
            }
          ]
