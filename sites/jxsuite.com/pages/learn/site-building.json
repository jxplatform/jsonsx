{
  "title": "Site Building in JX Studio",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Learn how to build complete sites in JX Studio: project structure, pages, layouts, slots, content collections, and the file-tree explorer."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "800px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "Site Building" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2rem, 5vw, 3.25rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "Assemble pages into sites."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "1.125rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto",
                "maxWidth": "600px"
              },
              "textContent": "A JX site is a collection of pages, layouts, components, and content — all stored as plain files in a git-tracked directory. Studio's file explorer and site tools make it easy to manage."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Project Structure"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "Every JX site follows this directory structure. Each folder has a specific purpose:"
        },
        {
          "tagName": "div",
          "style": {
            "backgroundColor": "var(--color-bg-secondary)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius-lg)",
            "padding": "2rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": { "overflowX": "auto" },
              "children": [
                {
                  "tagName": "pre",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "lineHeight": "1.7",
                    "color": "var(--color-text-secondary)",
                    "margin": "0"
                  },
                  "textContent": "my-site/\n├── project.json       ← Site config: name, URL, design tokens, $media, $head\n├── package.json        ← Dependencies (@jxsuite/compiler, @jxsuite/parser)\n├── pages/              ← Site pages (*.json, *.md)\n│   ├── index.json      ← Homepage\n│   └── about.json      ← About page\n├── layouts/            ← Page layouts (shell, docs layout, etc.)\n│   ├── base.json       ← Default layout with toolbar + footer + slot\n│   └── docs.json       ← Documentation layout with sidebar\n├── components/         ← Reusable components\n│   ├── header.json     ← Site header/navbar\n│   ├── footer.json     ← Site footer\n│   └── card.json       ← Content card component\n├── content/            ← Content collections\n│   ├── posts/          ← Blog posts (Markdown files)\n│   └── products/       ← Product entries\n└── public/             ← Static assets\n    ├── favicon.svg\n    └── images/"
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "project.json — Site Configuration"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "The project.json file is the central configuration for your entire site. It defines the site name, URL, design tokens, breakpoints, head elements, and more."
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(250px, 1fr))",
            "gap": "0.75rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "name & url"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Site name and production URL. Used by the compiler for SEO metadata, sitemaps, and canonical URLs. The URL is the base for all generated links."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "style (Design Tokens)"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "CSS custom properties that apply globally. Every component and page inherits these tokens. Also supports table styles, nested selectors, and pseudo-classes."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "$media"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Responsive breakpoints used across the site. The -- breakpoint is the default viewport width. Named breakpoints define media queries for responsive overrides."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "$head"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Elements injected into every page's head: meta tags, link tags (favicon, fonts), viewport, generator tag. Each page can add its own $head entries that merge with these."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "defaults"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Default layout for pages, default language (en), and other site-wide defaults. Pages can override these with their own $layout or lang fields."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "imports"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Register format classes and plugins. Common imports: Markdown (for .md pages), MarkdownCollection (for content collections). Classes are discovered automatically."
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Layouts & Slots"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "Layouts are reusable page shells. They define the outer structure (header, footer, sidebar) and a slot element where the page content is inserted."
        },
        {
          "tagName": "div",
          "style": {
            "backgroundColor": "var(--color-bg-secondary)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius-lg)",
            "padding": "2rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": { "overflowX": "auto" },
              "children": [
                {
                  "tagName": "pre",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "lineHeight": "1.7",
                    "color": "var(--color-text-secondary)",
                    "margin": "0"
                  },
                  "textContent": "// layouts/base.json\n{\n  \"tagName\": \"div\",\n  \"$elements\": [\n    { \"$ref\": \"../components/header.json\" },\n    { \"$ref\": \"../components/footer.json\" }\n  ],\n  \"children\": [\n    { \"tagName\": \"site-header\" },\n    {\n      \"tagName\": \"main\",\n      \"style\": { \"flex\": \"1\" },\n      \"children\": [{ \"tagName\": \"slot\" }]\n    },\n    { \"tagName\": \"site-footer\" }\n  ]\n}\n\n// Any page using this layout:\n{\n  \"title\": \"My Page\",\n  \"$layout\": \"./layouts/base.json\",\n  \"tagName\": \"div\",\n  \"children\": [ ... ]  ← replaces the slot element\n}"
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Content Collections"
        },
        {
          "tagName": "div",
          "style": {
            "padding": "1.5rem",
            "backgroundColor": "var(--color-bg-surface)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "fontSize": "0.9375rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "margin": "0 0 1rem"
              },
              "textContent": "Content collections are folders of Markdown files that the compiler processes into pages. Each file in a collection becomes a route on your site. Frontmatter fields become page data."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "0.9375rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "margin": "0"
              },
              "textContent": "Use content collections for blog posts, documentation articles, product listings, or any content that follows a repeating pattern. The MarkdownCollection class handles discovery, parsing, and routing automatically."
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Files Panel & Project Explorer"
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(250px, 1fr))",
            "gap": "0.75rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Open Files"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Click any .json or .md file to open it in the canvas. The file's content renders live. Make changes and save with Ctrl+S. The tab strip shows all open files."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Create Files & Folders"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Right-click any folder → New File or New Folder. Name your file with the appropriate extension. Components auto-register when placed in the components/ folder."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Site Context Inheritance"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "When a project is open, all files inherit the site context: design tokens, breakpoints, global styles. The canvas shows exactly how each component renders within the full site."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "Next: Keyboard Shortcuts"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.25rem"
          },
          "textContent": "Speed up your workflow with the complete keyboard shortcuts reference — every shortcut in Studio, organized by category."
        },
        {
          "tagName": "cta-button",
          "attributes": {
            "props.href": "/learn/shortcuts",
            "props.label": "Keyboard Shortcuts →",
            "props.variant": "primary"
          }
        }
      ]
    }
  ]
}
