{
  "title": "AI Assistant — Build with Natural Language",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Learn how to use the JX Studio AI Assistant to build and edit components with natural language. The AI reads, creates, and modifies JX documents on the live canvas."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "800px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "AI Assistant" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2rem, 5vw, 3.25rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "Build with natural language."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "1.125rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto",
                "maxWidth": "600px"
              },
              "textContent": "The AI Assistant lets you describe what you want in plain English and builds it directly on the live canvas. Every change is undoable. Every edit is visible. You're always in control."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Getting Started"
        },
        {
          "tagName": "div",
          "style": { "marginBottom": "2.5rem" },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "1rem"
              },
              "children": [
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1rem",
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "margin": "0 0 0.5rem"
                  },
                  "textContent": "1. Set up your API key"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Click the 🔑 button in the AI Assistant toolbar. Enter an OpenAI-compatible API key (any provider works: OpenAI, Anthropic via compatible endpoint, local models via Ollama). Choose your model. The key is stored locally in your browser — never sent anywhere except to your chosen endpoint through the Studio proxy."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "1rem"
              },
              "children": [
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1rem",
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "margin": "0 0 0.5rem"
                  },
                  "textContent": "2. Open the AI Assistant"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "The AI Assistant lives in the right panel as a tab. Click the AI icon in the inspector tabs, or press Ctrl+L. Make sure the mode toggle is set to \"Assistant\" (not \"Dev Agent\")."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "1rem"
              },
              "children": [
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1rem",
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "margin": "0 0 0.5rem"
                  },
                  "textContent": "3. Start building"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Type what you want to build. The AI reads your current document, plans the changes, and applies them directly to the canvas. You can see every change happen in real-time."
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "What the AI Can Do"
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
            "gap": "0.75rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Read Document"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI can read any part of your document — the whole thing, a subtree at a specific path, or individual properties. It discovers what's there before making changes."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Set Properties"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Change tagName, textContent, className, style properties, attributes, event handlers — any property on any element. Can also remove properties by setting them to null."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Add & Remove Elements"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Add new child elements at any position in the tree. Remove existing elements. The AI handles nesting, void element rules, and hyphen requirements automatically."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Schema Validation"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "After every change, the AI validates against the JX schema. If it introduces errors, it reports them and self-corrects. You'll never see invalid JSON on the canvas."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Token-First Styling"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI knows your project's design tokens and preferentially uses var(--token) references. It warns when you use hardcoded values that have token equivalents."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "color": "var(--color-accent)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Undo Everything"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Every AI change goes through transactDoc() — the same undo system as manual edits. Press Ctrl+Z to undo any AI change. All changes from one message are batched into a single undo step."
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Example Prompts"
        },
        {
          "tagName": "div",
          "style": { "marginBottom": "2.5rem" },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "0.75rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "color": "var(--color-accent)",
                    "marginBottom": "0.25rem"
                  },
                  "textContent": "\"Build a hero section with a heading, subtitle, and two CTA buttons\""
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-muted)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI creates a styled section with an h1, paragraph, and button group — using your project's design tokens and responsive breakpoints."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "0.75rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "color": "var(--color-accent)",
                    "marginBottom": "0.25rem"
                  },
                  "textContent": "\"Make this card responsive — 3 columns on desktop, 2 on tablet, 1 on mobile\""
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-muted)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI adds @--md and @--sm responsive overrides to the grid layout, using your project's existing breakpoint names."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "0.75rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "color": "var(--color-accent)",
                    "marginBottom": "0.25rem"
                  },
                  "textContent": "\"Add a counter with increment and decrement buttons\""
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-muted)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI creates state with count, a computed label, two button event handlers, and a span bound to ${state.count}."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "marginBottom": "0.75rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "color": "var(--color-accent)",
                    "marginBottom": "0.25rem"
                  },
                  "textContent": "\"Change all colors to use design tokens instead of hardcoded hex values\""
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-muted)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI reads your project's token palette and replaces hardcoded colors with the closest var(--token) equivalents."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "color": "var(--color-accent)",
                    "marginBottom": "0.25rem"
                  },
                  "textContent": "\"Create a nav component with logo, links, and a mobile hamburger menu\""
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-muted)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The AI builds a full nav component with state for mobile menu toggle, responsive styles, and proper semantic HTML structure."
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "How It Works"
        },
        {
          "tagName": "div",
          "style": {
            "padding": "1.5rem",
            "backgroundColor": "var(--color-bg-surface)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "fontSize": "0.9375rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "margin": "0 0 1rem"
              },
              "textContent": "The AI Assistant uses a tool-calling architecture:"
            },
            {
              "tagName": "ol",
              "style": {
                "fontSize": "0.875rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "paddingLeft": "1.5rem",
                "margin": "0"
              },
              "children": [
                {
                  "tagName": "li",
                  "style": { "marginBottom": "0.5rem" },
                  "children": [
                    {
                      "tagName": "strong",
                      "style": { "color": "var(--color-text-primary)" },
                      "textContent": "You send a message"
                    },
                    {
                      "tagName": "span",
                      "textContent": " — The AI receives your message along with a system prompt containing the JX schema reference, your project's design tokens, and a structural summary of your current document."
                    }
                  ]
                },
                {
                  "tagName": "li",
                  "style": { "marginBottom": "0.5rem" },
                  "children": [
                    {
                      "tagName": "strong",
                      "style": { "color": "var(--color-text-primary)" },
                      "textContent": "The AI plans"
                    },
                    {
                      "tagName": "span",
                      "textContent": " — It reads the relevant parts of your document, then calls tools (read_document, set_property, add_child, remove_node) to make changes."
                    }
                  ]
                },
                {
                  "tagName": "li",
                  "style": { "marginBottom": "0.5rem" },
                  "children": [
                    {
                      "tagName": "strong",
                      "style": { "color": "var(--color-text-primary)" },
                      "textContent": "Changes apply live"
                    },
                    {
                      "tagName": "span",
                      "textContent": " — Each tool call modifies the document through transactDoc(). The canvas re-renders immediately via Vue reactivity."
                    }
                  ]
                },
                {
                  "tagName": "li",
                  "style": { "marginBottom": "0.5rem" },
                  "children": [
                    {
                      "tagName": "strong",
                      "style": { "color": "var(--color-text-primary)" },
                      "textContent": "Validation runs"
                    },
                    {
                      "tagName": "span",
                      "textContent": " — After each change, the JX schema validator checks the document. New errors are reported back to the AI for self-correction."
                    }
                  ]
                },
                {
                  "tagName": "li",
                  "style": { "marginBottom": "0" },
                  "children": [
                    {
                      "tagName": "strong",
                      "style": { "color": "var(--color-text-primary)" },
                      "textContent": "The AI responds"
                    },
                    {
                      "tagName": "span",
                      "textContent": " — It tells you what it did, what changed, and any issues it encountered. If something failed, it tries again (up to 5 rounds of self-correction)."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "Back to Learn Hub"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.25rem"
          },
          "textContent": "Explore all the learning resources for JX Studio."
        },
        {
          "tagName": "cta-button",
          "attributes": {
            "props.href": "/learn",
            "props.label": "← Back to Learn Hub",
            "props.variant": "secondary"
          }
        }
      ]
    }
  ]
}
