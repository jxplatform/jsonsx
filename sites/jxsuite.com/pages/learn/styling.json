      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "Next: State & Reactivity"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.25rem"
          },
          "textContent": "Learn how state works in JX — reactive values, computed properties, event handlers, $ref bindings, and data sources."
        },
        {
          "tagName": "cta-button",
          "attributes": {
            "props.href": "/learn/state",
            "props.label": "State & Reactivity →",
            "props.variant": "primary"
          }
        }
      ]
    }
  ]
}
