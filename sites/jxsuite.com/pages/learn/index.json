{
  "title": "Learn JX Studio — The Complete Guide",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "A comprehensive guide to JX Studio — the visual IDE for building websites with JX. Learn the interface, build components, style with design tokens, manage state, and more."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" },
    { "$ref": "../components/feature-card.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(4rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.1), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "800px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "Learn JX Studio" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2.25rem, 5vw, 3.5rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "Everything you need to build with JX Studio."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "1.125rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto",
                "maxWidth": "600px"
              },
              "textContent": "From your first component to a full site — visual guides, step-by-step walkthroughs, and reference material for every part of JX Studio."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto"
      },
      "children": [
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
            "gap": "1rem"
          },
          "children": [
            {
              "tagName": "a",
              "attributes": { "href": "/learn/overview" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🏗️"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Overview & Architecture"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Design principles, three-column layout, data flow, and how Studio fits into the JX ecosystem."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/interface" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🖥️"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Interface Walkthrough"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Panel-by-panel visual guide: activity bar, layers, canvas, inspector, toolbar, and status bar."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/building-components" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🧩"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Building Components"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Create your first component: tagName, state, props, children, and the component lifecycle."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/styling" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🎨"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Styling & Design Tokens"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "CSS custom properties, $media breakpoints, stylebook, responsive patterns, and the token-first approach."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/state" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "⚡"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "State & Reactivity"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Reactive state, computed values, event handlers, $ref bindings, data sources, and the signals panel."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/site-building" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🌐"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Site Building"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Pages, layouts, slots, content collections, project structure, and the file-tree explorer."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/shortcuts" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "⌨️"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "Keyboard Shortcuts"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Complete reference of every keyboard shortcut in Studio — editing, navigation, canvas, and panels."
                }
              ]
            },
            {
              "tagName": "a",
              "attributes": { "href": "/learn/ai-assistant" },
              "style": {
                "textDecoration": "none",
                "color": "inherit",
                "display": "block",
                "padding": "1.5rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)",
                "transition": "border-color 0.15s, background-color 0.15s"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontSize": "1.5rem",
                    "marginBottom": "0.75rem"
                  },
                  "textContent": "🤖"
                },
                {
                  "tagName": "h3",
                  "style": {
                    "fontSize": "1.125rem",
                    "fontWeight": "600",
                    "margin": "0 0 0.5rem",
                    "color": "var(--color-text-primary)"
                  },
                  "textContent": "AI Assistant"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.875rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.6",
                    "margin": "0"
                  },
                  "textContent": "Use natural language to build and edit components. The AI assistant reads, creates, and modifies JX documents on the live canvas."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
