{
  "title": "Building Components in JX Studio — Complete Guide",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Learn how to build components in JX Studio: tagName, state, props, children, styling, event handlers, and the full component lifecycle."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "800px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "Building Components" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2rem, 5vw, 3.25rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "From tagName to full component."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "1.125rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto",
                "maxWidth": "600px"
              },
              "textContent": "Every JX component is a JSON object. Learn the structure, add state, wire up events, compose children — and see it all render live on the canvas."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
