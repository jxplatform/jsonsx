          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "A JX component is a JSON object with a standard structure. Here are the key fields:"
