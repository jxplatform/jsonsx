                  "textContent": "The component's name. Custom elements MUST contain a hyphen (e.g. \"my-counter\", \"feature-card\"). Standard HTML elements use their exact tag name."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
