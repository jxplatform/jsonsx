        {
          "tagName": "div",
          "style": {
            "backgroundColor": "var(--color-bg-secondary)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius-lg)",
            "padding": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": { "overflowX": "auto" },
              "children": [
                {
                  "tagName": "pre",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "lineHeight": "1.7",
                    "color": "var(--color-text-secondary)",
                    "margin": "0"
                  },
                  "textContent": "{\n  \"$id\": \"Counter\",          // Component name (must have hyphen)\n  \"tagName\": \"my-counter\",    // Root HTML tag\n  \"state\": { ... },            // Reactive variables\n  \"children\": [ ... ],         // Child elements\n  \"style\": { ... },            // CSS properties (camelCase)\n  \"$elements\": [ ... ],        // Imported components\n  \"$media\": { ... }            // Responsive breakpoints\n}"
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
            "gap": "0.75rem",
            "marginTop": "1.5rem",
            "marginBottom": "2.5rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
