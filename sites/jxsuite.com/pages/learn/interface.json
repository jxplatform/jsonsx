{
  "title": "JX Studio Interface — Panel-by-Panel Walkthrough",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "A detailed visual walkthrough of every panel in JX Studio: activity bar, layers, files, canvas, toolbar, inspector, and status bar."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
