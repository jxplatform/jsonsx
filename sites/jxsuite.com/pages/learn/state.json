{
  "title": "State & Reactivity in JX Studio",
  "$layout": "../layouts/base.json",
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "Master JX state and reactivity: reactive values, computed properties, event handlers, $ref bindings, data sources, and the signals panel."
      }
    }
  ],
  "$elements": [
    { "$ref": "../components/section-label.json" },
    { "$ref": "../components/cta-button.json" }
  ],
  "tagName": "div",
  "children": [
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem)",
        "textAlign": "center",
        "background": "radial-gradient(ellipse 80% 50% at 50% -20%, rgba(59, 130, 246, 0.08), transparent)"
      },
      "children": [
        {
          "tagName": "div",
          "style": { "maxWidth": "800px", "margin": "0 auto" },
          "children": [
            {
              "tagName": "section-label",
              "attributes": { "props.text": "State & Reactivity" }
            },
            {
              "tagName": "h1",
              "style": {
                "fontSize": "clamp(2rem, 5vw, 3.25rem)",
                "fontWeight": "700",
                "letterSpacing": "-0.04em",
                "lineHeight": "1.1",
                "margin": "0 0 1.25rem",
                "color": "var(--color-text-primary)"
              },
              "textContent": "State drives the UI."
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "1.125rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.7",
                "margin": "0 auto",
                "maxWidth": "600px"
              },
              "textContent": "JX state is reactive by default — powered by @vue/reactivity. Change a value, and every template expression that references it updates automatically. No manual DOM manipulation."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "State Shape Decision Tree"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "The shape of a state entry determines its behavior. No flags needed — JX detects the type from the value's structure:"
        },
        {
          "tagName": "div",
          "style": {
            "overflowX": "auto",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "table",
              "style": {
                "width": "100%",
                "borderCollapse": "collapse",
                "fontSize": "0.875rem"
              },
              "children": [
                {
                  "tagName": "thead",
                  "children": [
                    {
                      "tagName": "tr",
                      "children": [
                        {
                          "tagName": "th",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "textAlign": "left",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.6875rem",
                            "fontWeight": "600",
                            "color": "var(--color-text-muted)",
                            "textTransform": "uppercase",
                            "letterSpacing": "0.1em",
                            "borderBottom": "1px solid var(--color-border)"
                          },
                          "textContent": "Shape"
                        },
                        {
                          "tagName": "th",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "textAlign": "left",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.6875rem",
                            "fontWeight": "600",
                            "color": "var(--color-text-muted)",
                            "textTransform": "uppercase",
                            "letterSpacing": "0.1em",
                            "borderBottom": "1px solid var(--color-border)"
                          },
                          "textContent": "Detected By"
                        },
                        {
                          "tagName": "th",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "textAlign": "left",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.6875rem",
                            "fontWeight": "600",
                            "color": "var(--color-text-muted)",
                            "textTransform": "uppercase",
                            "letterSpacing": "0.1em",
                            "borderBottom": "1px solid var(--color-border)"
                          },
                          "textContent": "Becomes"
                        },
                        {
                          "tagName": "th",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "textAlign": "left",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.6875rem",
                            "fontWeight": "600",
                            "color": "var(--color-text-muted)",
                            "textTransform": "uppercase",
                            "letterSpacing": "0.1em",
                            "borderBottom": "1px solid var(--color-border)"
                          },
                          "textContent": "Example"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "tbody",
                  "children": [
                    {
                      "tagName": "tr",
                      "style": { "borderBottom": "1px solid var(--color-border-subtle)" },
                      "children": [
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-accent)"
                          },
                          "textContent": "Naked value"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-muted)"
                          },
                          "textContent": "Scalar, array, or plain object"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "ref() — reactive value"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.75rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "\"count\": 0"
                        }
                      ]
                    },
                    {
                      "tagName": "tr",
                      "style": { "borderBottom": "1px solid var(--color-border-subtle)" },
                      "children": [
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-accent)"
                          },
                          "textContent": "Typed value"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-muted)"
                          },
                          "textContent": "{ type, default }"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "ref() — typed reactive"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.75rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "\"name\": { \"type\": \"string\", \"default\": \"\" }"
                        }
                      ]
                    },
                    {
                      "tagName": "tr",
                      "style": { "borderBottom": "1px solid var(--color-border-subtle)" },
                      "children": [
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-accent)"
                          },
                          "textContent": "Computed"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-muted)"
                          },
                          "textContent": "String containing ${}"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "computed() — derived value"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.75rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "\"label\": \"${state.count} items\""
                        }
                      ]
                    },
                    {
                      "tagName": "tr",
                      "style": { "borderBottom": "1px solid var(--color-border-subtle)" },
                      "children": [
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-accent)"
                          },
                          "textContent": "Function"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-muted)"
                          },
                          "textContent": "$prototype: \"Function\""
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "Event handler or computed"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.75rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "\"increment\": { \"$prototype\": \"Function\", \"body\": \"state.count++\" }"
                        }
                      ]
                    },
                    {
                      "tagName": "tr",
                      "style": { "borderBottom": "1px solid var(--color-border-subtle)" },
                      "children": [
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-accent)"
                          },
                          "textContent": "Data source"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-muted)"
                          },
                          "textContent": "$prototype with URL"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontSize": "0.8125rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "Reactive async value"
                        },
                        {
                          "tagName": "td",
                          "style": {
                            "padding": "0.75rem 1rem",
                            "fontFamily": "var(--font-mono)",
                            "fontSize": "0.75rem",
                            "color": "var(--color-text-secondary)"
                          },
                          "textContent": "\"posts\": { \"$prototype\": \"Data\", \"$src\": \"./posts.json\" }"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Template Expressions"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.5rem"
          },
          "textContent": "Template expressions ${...} work anywhere a string value appears — textContent, style properties, attributes. Dependencies are tracked automatically."
        },
        {
          "tagName": "div",
          "style": {
            "backgroundColor": "var(--color-bg-secondary)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius-lg)",
            "padding": "2rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": { "overflowX": "auto" },
              "children": [
                {
                  "tagName": "pre",
                  "style": {
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.8125rem",
                    "lineHeight": "1.7",
                    "color": "var(--color-text-secondary)",
                    "margin": "0"
                  },
                  "textContent": "// In textContent\n\"textContent\": \"${state.count} items\"\n\n// In style properties\n\"backgroundColor\": \"${state.isActive ? 'var(--color-accent)' : 'transparent'}\"\n\n// In attributes\n\"attributes\": { \"href\": \"${state.url}\" }\n\n// Computed state entries\n\"greeting\": \"${state.name}, you clicked ${state.count} times\""
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Event Handlers & $ref"
        },
        {
          "tagName": "div",
          "style": {
            "display": "grid",
            "gridTemplateColumns": "repeat(auto-fill, minmax(280px, 1fr))",
            "gap": "0.75rem",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Defining Handlers"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Define a function in state with $prototype: \"Function\" and a body string. The body has access to state and event (the DOM event object)."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Binding with $ref"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "Bind a handler to an event: \"onclick\": { \"$ref\": \"#/state/handleClick\" }. The #/state/ prefix points to the document's state object."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Events Panel"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The Events tab in the inspector shows all event handlers for the selected element. Edit function bodies inline with Monaco. See which state functions are bound to which events."
                }
              ]
            },
            {
              "tagName": "div",
              "style": {
                "padding": "1.25rem",
                "backgroundColor": "var(--color-bg-surface)",
                "border": "1px solid var(--color-border)",
                "borderRadius": "var(--radius)"
              },
              "children": [
                {
                  "tagName": "div",
                  "style": {
                    "fontWeight": "600",
                    "color": "var(--color-text-primary)",
                    "fontSize": "0.875rem",
                    "marginBottom": "0.5rem"
                  },
                  "textContent": "Signals Panel"
                },
                {
                  "tagName": "p",
                  "style": {
                    "fontSize": "0.8125rem",
                    "color": "var(--color-text-secondary)",
                    "lineHeight": "1.5",
                    "margin": "0"
                  },
                  "textContent": "The Signals tab shows all state entries. Add, edit, or remove signals. Change types. See computed dependencies. Each entry shows its detected type with a badge."
                }
              ]
            }
          ]
        },
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1.5rem",
            "paddingBottom": "0.5rem",
            "borderBottom": "1px solid var(--color-border)"
          },
          "textContent": "Data Sources"
        },
        {
          "tagName": "div",
          "style": {
            "padding": "1.5rem",
            "backgroundColor": "var(--color-bg-surface)",
            "border": "1px solid var(--color-border)",
            "borderRadius": "var(--radius)",
            "marginBottom": "2rem"
          },
          "children": [
            {
              "tagName": "p",
              "style": {
                "fontSize": "0.9375rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "margin": "0 0 1rem"
              },
              "textContent": "Data sources fetch external data and make it available as reactive state. They're defined with $prototype and a URL:"
            },
            {
              "tagName": "div",
              "style": {
                "backgroundColor": "var(--color-bg-secondary)",
                "border": "1px solid var(--color-border-subtle)",
                "borderRadius": "var(--radius)",
                "padding": "1rem",
                "fontFamily": "var(--font-mono)",
                "fontSize": "0.75rem",
                "lineHeight": "1.7",
                "color": "var(--color-text-secondary)"
              },
              "children": [
                {
                  "tagName": "pre",
                  "style": {
                    "margin": "0",
                    "fontFamily": "var(--font-mono)",
                    "fontSize": "0.75rem",
                    "color": "var(--color-text-secondary)"
                  },
                  "textContent": "\"state\": {\n  \"posts\": {\n    \"$prototype\": \"Data\",\n    \"$src\": \"./posts.json\"\n  },\n  \"user\": {\n    \"$prototype\": \"Request\",\n    \"url\": \"/api/user\",\n    \"method\": \"GET\"\n  }\n}"
                }
              ]
            },
            {
              "tagName": "p",
              "style": {
                "fontSize": "0.875rem",
                "color": "var(--color-text-secondary)",
                "lineHeight": "1.6",
                "margin": "1rem 0 0"
              },
              "textContent": "Use data sources for content collections (blog posts, products), API data, or any external data that drives your UI. The data is reactive — when it loads or changes, the UI updates."
            }
          ]
        }
      ]
    },
    {
      "tagName": "section",
      "style": {
        "padding": "clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2rem)",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "borderTop": "1px solid var(--color-border)"
      },
      "children": [
        {
          "tagName": "h2",
          "style": {
            "fontSize": "1.5rem",
            "fontWeight": "700",
            "letterSpacing": "-0.02em",
            "margin": "0 0 1rem"
          },
          "textContent": "Next: Site Building"
        },
        {
          "tagName": "p",
          "style": {
            "fontSize": "0.9375rem",
            "color": "var(--color-text-secondary)",
            "lineHeight": "1.6",
            "margin": "0 0 1.25rem"
          },
          "textContent": "Learn how to assemble components into pages, pages into sites — layouts, slots, content collections, and the full site structure."
        },
        {
          "tagName": "cta-button",
          "attributes": {
            "props.href": "/learn/site-building",
            "props.label": "Site Building →",
            "props.variant": "primary"
          }
        }
      ]
    }
  ]
}
