{
  "$schema": "./project.schema.json",
  "name": "Jx Suite",
  "url": "https://jxsuite.com",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "images": {
    "optimize": true,
    "widths": [320, 640, 960, 1280, 1920],
    "formats": ["webp", "avif"],
    "quality": {
      "webp": 80,
      "avif": 65,
      "jpeg": 80,
      "png": 80
    },
    "sizes": "(max-width: 768px) 100vw, 50vw",
    "lazyLoad": true
  },
  "$head": [
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.svg"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "generator",
        "content": "Jx Suite"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      }
    }
  ],
  "$media": {
    "--": "1280px",
    "--lg": "(max-width: 1024px)",
    "--md": "(max-width: 768px)",
    "--sm": "(max-width: 640px)",
    "--dark": "(prefers-color-scheme: dark)"
  },
  "style": {
    "--color-bg-primary": "#ffffff",
    "--color-bg-secondary": "#fafafa",
    "--color-bg-surface": "#f4f4f5",
    "--color-bg-surface-hover": "#e4e4e7",
    "--color-border": "#d4d4d8",
    "--color-border-subtle": "#e4e4e7",
    "--color-text-primary": "#18181b",
    "--color-text-secondary": "#52525b",
    "--color-text-muted": "#5f5f68",
    "--color-brand": "#1a1a2e",
    "--color-accent": "#2563eb",
    "--color-accent-hover": "#1d4ed8",
    "--color-accent-solid": "#2563eb",
    "--color-backdrop": "rgba(255, 255, 255, 0.85)",
    "--color-backdrop-strong": "rgba(255, 255, 255, 0.92)",
    "--color-shadow": "rgba(0, 0, 0, 0.12)",
    "--color-shadow-strong": "rgba(0, 0, 0, 0.18)",
    "--color-success": "#047857",
    "--color-warning": "#b45309",
    "--color-highlight-bg": "#eef2ff",
    "--color-highlight-text": "#1e1b4b",
    "--color-highlight-border": "#c7d2fe",
    "--font-mono": "'JetBrains Mono', 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace",
    "--radius": "8px",
    "--radius-lg": "12px",
    "--max-width": "1200px",
    "@--dark": {
      "--color-bg-primary": "#0a0a0a",
      "--color-bg-secondary": "#111111",
      "--color-bg-surface": "#1a1a1a",
      "--color-bg-surface-hover": "#222222",
      "--color-border": "#222222",
      "--color-border-subtle": "#1a1a1a",
      "--color-text-primary": "#fafafa",
      "--color-text-secondary": "#a1a1aa",
      "--color-text-muted": "#8b8b94",
      "--color-accent": "#3b82f6",
      "--color-accent-hover": "#60a5fa",
      "--color-backdrop": "rgba(10, 10, 10, 0.8)",
      "--color-backdrop-strong": "rgba(10, 10, 10, 0.9)",
      "--color-shadow": "rgba(0, 0, 0, 0.4)",
      "--color-shadow-strong": "rgba(0, 0, 0, 0.5)",
      "--color-success": "#059669",
      "--color-warning": "#d97706",
      "--color-highlight-bg": "rgba(255, 255, 255, 0.97)",
      "--color-highlight-text": "#1a1a2e",
      "--color-highlight-border": "rgba(0, 0, 0, 0.08)"
    },
    ":focus-visible": {
      "outline": "2px solid var(--color-accent)",
      "outlineOffset": "2px"
    },
    "margin": "0",
    "maxWidth": "100vw",
    "overflowX": "clip",
    "padding": "0",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "backgroundColor": "var(--color-bg-primary)",
    "color": "var(--color-text-primary)",
    "table": {
      "width": "100%",
      "borderCollapse": "collapse",
      "fontSize": "0.9375rem",
      "textAlign": "left",
      "borderTop": "1px solid var(--color-border)",
      "thead": {
        "padding": "1rem 1.25rem",
        "fontFamily": "var(--font-mono)",
        "fontSize": "0.6875rem",
        "fontWeight": "600",
        "color": "var(--color-text-muted)",
        "textTransform": "uppercase",
        "letterSpacing": "0.1em",
        "borderBottom": "1px solid var(--color-border)"
      },
      "tbody": {
        "tr": {
          "borderBottom": "1px solid var(--color-border-subtle)",
          ":hover": {
            "backgroundColor": "var(--color-bg-surface)"
          },
          ":first-child": {
            "color": "var(--color-accent)",
            "fontWeight": "700",
            "fontStyle": "italic"
          },
          ":last-child": {
            "color": "var(--color-accent)",
            "fontWeight": "700",
            "fontStyle": "italic"
          }
        },
        "td": {
          "padding": "1rem 1.25rem",
          "color": "var(--color-text-secondary)",
          "borderLeft": "1px solid var(--color-border-subtle)",
          ":first-child": {
            "color": "var(--color-text-primary)",
            "fontWeight": "600",
            "borderLeft": "none"
          },
          ":last-child": {
            "color": "var(--color-highlight-text)",
            "fontWeight": "600",
            "borderLeftColor": "var(--color-highlight-border)",
            "backgroundColor": "var(--color-highlight-bg)"
          }
        },
        "th": {
          "padding": "1rem 1.25rem",
          "color": "var(--color-text-secondary)",
          "borderLeft": "1px solid var(--color-border-subtle)",
          ":first-child": {
            "color": "var(--color-text-primary)",
            "fontWeight": "600",
            "borderLeft": "none"
          },
          ":last-child": {
            "color": "var(--color-highlight-text)",
            "fontWeight": "600",
            "borderLeftColor": "var(--color-highlight-border)",
            "backgroundColor": "var(--color-highlight-bg)"
          }
        }
      }
    }
  },
  "content": {
    "docs": {
      "source": "../../docs",
      "format": "Markdown",
      "$elements": [
        { "$ref": "./components/doc-note.json" },
        { "$ref": "./components/doc-warning.json" },
        { "$ref": "./components/doc-tip.json" }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "spec": {
            "type": "array",
            "items": { "type": "string" }
          },
          "code": {
            "type": "array",
            "items": { "type": "string" }
          },
          "generated": {
            "type": "boolean"
          }
        },
        "required": ["title"]
      }
    },
    "docsNav": {
      "source": "../../docs/nav.json",
      "format": "json"
    }
  },
  "search": {
    "output": "/search-index.json",
    "collections": {
      "docs": {
        "basePath": "/docs/",
        "boost": { "title": 4, "heading": 2 }
      }
    }
  },
  "redirects": {
    "/docs/get-studio": "/docs/start/install/",
    "/docs/getting-started": "/docs/start/first-project/",
    "/docs/manage": "/docs/studio/projects/browse/",
    "/docs/edit": "/docs/studio/editing/",
    "/docs/design": "/docs/studio/design/",
    "/docs/logic": "/docs/studio/logic/",
    "/docs/git-publish": "/docs/studio/publish/",
    "/docs/components": "/docs/framework/concepts/components/",
    "/docs/reactivity": "/docs/framework/concepts/reactivity/",
    "/docs/styling": "/docs/framework/concepts/styling/",
    "/docs/site-architecture": "/docs/framework/site/",
    "/docs/spec": "/docs/framework/"
  },
  "copy": {
    "../../packages/schema/schema.json": "schema/v1/index.json",
    "../../packages/schema/project-schema.json": "schema/project/v1/index.json",
    "../../packages/schema/class-schema.json": "schema/class/v1/index.json"
  },
  "build": {
    "outDir": "./dist",
    "trailingSlash": "always"
  },
  "extensions": ["@jxsuite/parser", "@jxsuite/search"]
}
