{
  "tagName": "div",
  "style": {
    "margin": "0",
    "padding": "0",
    "color": "var(--color-text-primary)",
    "lineHeight": "1.6",
    "minHeight": "100vh",
    "display": "flex",
    "flexDirection": "column"
  },
  "$elements": [
    { "$ref": "../components/site-toolbar.json" },
    { "$ref": "../components/site-footer.json" },
    { "$ref": "../components/docs-sidebar.json" }
  ],
  "state": {
    "nav": {
      "$prototype": "ContentEntry",
      "contentType": "docsNav",
      "id": "nav"
    }
  },
  "children": [
    { "tagName": "site-toolbar" },
    {
      "tagName": "div",
      "style": {
        "flex": "1",
        "display": "flex",
        "maxWidth": "var(--max-width)",
        "margin": "0 auto",
        "width": "100%"
      },
      "children": [
        {
          "tagName": "aside",
          "style": {
            "width": "260px",
            "flexShrink": "0",
            "borderRight": "1px solid var(--color-border)",
            "position": "sticky",
            "top": "3.5rem",
            "height": "calc(100vh - 3.5rem)",
            "overflowY": "auto",
            "paddingRight": "0.5rem",
            "@--md": { "display": "none" }
          },
          "children": [
            {
              "tagName": "docs-sidebar",
              "children": [
                {
                  "$prototype": "Array",
                  "items": { "$ref": "#/state/nav/data/sections" },
                  "map": {
                    "tagName": "div",
                    "attributes": { "class": "nav-section" },
                    "children": [
                      {
                        "tagName": "a",
                        "attributes": {
                          "class": "nav-section-label",
                          "href": "/docs/${item.path}/"
                        },
                        "textContent": "${item.label}"
                      },
                      {
                        "$prototype": "Array",
                        "items": { "$ref": "$map/item/children" },
                        "map": {
                          "tagName": "a",
                          "attributes": {
                            "class": "nav-link",
                            "href": "/docs/${item.path}/",
                            "aria-current": "${(state.$page.url.endsWith('/') ? state.$page.url.slice(0, -1) : state.$page.url) === '/docs/' + item.path ? 'page' : 'false'}"
                          },
                          "textContent": "${item.label}"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "main",
          "style": {
            "flex": "1",
            "minWidth": "0",
            "padding": "clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem)"
          },
          "children": [{ "tagName": "slot" }]
        }
      ]
    },
    { "tagName": "site-footer" }
  ]
}
