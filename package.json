{
  "name": "jxsuite",
  "version": "0.34.0",
  "private": true,
  "license": "MIT",
  "author": "Kevin Shenk <kevin@avu.nu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxsuite/jx.git"
  },
  "workspaces": [
    "packages/*",
    "extensions/*",
    "examples",
    "sites/*"
  ],
  "type": "module",
  "scripts": {
    "all-the-things": "bun run build && bun run test:workspaces && bun run lint && bun run typecheck",
    "build": "bun run build:parser && bun run build:search && bun run build:compiler && bun run build:runtime && bun run build:studio && bun run generate:schema",
    "build:compiler": "bun run --cwd packages/compiler build",
    "build:parser": "bun run --cwd extensions/parser build",
    "build:search": "bun run --cwd extensions/search build",
    "build:runtime": "bun run --cwd packages/runtime build",
    "build:studio": "bun run --cwd packages/studio build",
    "desktop": "bun run --cwd packages/desktop dev",
    "desktop:build": "bun run --cwd packages/desktop build",
    "desktop:chromium": "bun run --cwd packages/desktop chromium",
    "desktop:msix": "bun run --cwd packages/desktop build:msix",
    "desktop:release": "bun run --cwd packages/desktop build:release",
    "desktop:stable": "bun run --cwd packages/desktop build:stable",
    "dev": "bun run server.js",
    "docs:check": "bun scripts/docs/check-doc-refs.ts",
    "docs:images:check": "bun scripts/check-image-lock.ts",
    "docs:claims": "bun scripts/docs/check-site-claims.ts",
    "docs:status": "bun scripts/docs/check-spec-status.ts",
    "docs:spec-release": "bun scripts/docs/check-spec-release.ts",
    "docs:standards": "bun scripts/docs/check-standards.ts",
    "docs:generate": "bun scripts/docs/generate-reference.ts",
    "docs:sync": "bun scripts/docs/check-doc-sync.ts",
    "docs:verify": "bun run docs:generate && git diff --exit-code -- docs && bun run docs:check && bun run docs:images:check",
    "eval": "bun run --cwd packages/studio eval",
    "eval:headless": "bun run --cwd packages/studio eval:headless",
    "format": "bun scripts/normalize-markdown.ts && oxfmt .",
    "format:md": "bun scripts/normalize-markdown.ts",
    "docs:markdown": "bun scripts/normalize-markdown.ts --check",
    "generate:schema": "bun run --cwd packages/schema schema",
    "schema:verify": "bun run generate:schema && git diff --exit-code -- packages/schema/schema.json && bun run schema:generate-all && git diff --exit-code -- '**/project.schema.json' '**/document.schema.json'",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:typecheck": "oxlint --type-aware -c .oxlintrc.typecheck.json .",
    "pack": "bun run --workspaces bun pm pack",
    "postinstall": "node -e \"if(!process.env.CI)require('child_process').execSync('bun2nix -o bun.nix',{stdio:'ignore'})\" || true",
    "prepare": "husky",
    "screenshots": "bun scripts/screenshots/run.ts",
    "screenshots:thumbnails": "bun scripts/screenshots/thumbnails.ts",
    "spec:bump": "bun scripts/docs/spec-bump.ts",
    "test": "bun test --isolate",
    "test:workspaces": "bun run --workspaces test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:coverage:workspaces": "bun run --workspaces test:coverage",
    "typecheck": "tsc",
    "upgrade": "bunx npm-check-updates -u && bun install && bun run --workspaces --if-present upgrade",
    "schema:clean-roots": "bun scripts/check-shadowed-core.ts --fix",
    "schema:generate-all": "bun run schema:clean-roots && bun scripts/generate-schemas.ts",
    "schema:validate-all": "bun scripts/validate-schemas.ts"
  },
  "dependencies": {
    "@jxsuite/server": "workspace:^"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ttsc/graph": "^0.27.0",
    "bun-types": "^1.3.14",
    "bun2nix": "^2.1.2",
    "chrome-devtools-mcp": "^1.7.0",
    "husky": "^9.1.7",
    "metafile-codecov-bundle": "^0.1.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "puppeteer-core": "^25.8.0",
    "release-please": "^17.11.1",
    "ts-migrate": "^0.1.35",
    "ts-migrate-plugins": "^0.1.35",
    "ttsc": "^0.27.0",
    "typescript": "^7.0.2"
  },
  "nano-staged": {
    "*.md": [
      "bun scripts/normalize-markdown.ts"
    ],
    "*.{ts,json,css,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts}": [
      "oxlint --fix"
    ]
  }
}
