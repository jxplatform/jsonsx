{
  "title": "Shoelace — Jx Examples",
  "$layout": "../../layouts/example.json",
  "$head": [
    {
      "tagName": "link",
      "attributes": {
        "rel": "stylesheet",
        "href": "@shoelace-style/shoelace/dist/themes/light.css"
      }
    }
  ],
  "$elements": [
    "@shoelace-style/shoelace/components/alert/alert.js",
    "@shoelace-style/shoelace/components/button/button.js",
    "@shoelace-style/shoelace/components/card/card.js",
    "@shoelace-style/shoelace/components/icon/icon.js",
    "@shoelace-style/shoelace/components/input/input.js",
    "@shoelace-style/shoelace/components/textarea/textarea.js",
    "@shoelace-style/shoelace/components/switch/switch.js"
  ],
  "children": [
    {
      "tagName": "div",
      "style": { "maxWidth": "640px" },
      "children": [
        {
          "tagName": "h1",
          "textContent": "Shoelace Components Demo"
        },
        {
          "tagName": "sl-card",
          "style": { "marginBottom": "1rem" },
          "children": [
            {
              "tagName": "div",
              "attributes": { "slot": "header" },
              "children": [{ "tagName": "strong", "textContent": "Welcome" }]
            },
            {
              "tagName": "p",
              "textContent": "This page demonstrates Shoelace web components imported via $elements."
            },
            {
              "tagName": "div",
              "style": { "display": "flex", "gap": "0.5rem", "marginTop": "1rem" },
              "children": [
                {
                  "tagName": "sl-button",
                  "attributes": { "variant": "primary" },
                  "textContent": "Primary"
                },
                {
                  "tagName": "sl-button",
                  "attributes": { "variant": "success" },
                  "textContent": "Success"
                },
                {
                  "tagName": "sl-button",
                  "attributes": { "variant": "neutral", "outline": "" },
                  "textContent": "Outline"
                }
              ]
            }
          ]
        },
        {
          "tagName": "sl-card",
          "style": { "marginBottom": "1rem" },
          "children": [
            {
              "tagName": "div",
              "attributes": { "slot": "header" },
              "children": [{ "tagName": "strong", "textContent": "Form Elements" }]
            },
            {
              "tagName": "div",
              "style": { "display": "flex", "flexDirection": "column", "gap": "1rem" },
              "children": [
                {
                  "tagName": "sl-input",
                  "attributes": { "label": "Name", "placeholder": "Enter your name" }
                },
                {
                  "tagName": "sl-textarea",
                  "attributes": {
                    "label": "Message",
                    "placeholder": "Type a message…",
                    "rows": "3"
                  }
                },
                { "tagName": "sl-switch", "textContent": "Enable notifications" },
                {
                  "tagName": "sl-button",
                  "attributes": { "variant": "primary", "type": "submit" },
                  "textContent": "Submit"
                }
              ]
            }
          ]
        },
        {
          "tagName": "sl-alert",
          "attributes": { "variant": "primary", "open": "" },
          "children": [
            { "tagName": "sl-icon", "attributes": { "slot": "icon", "name": "info-circle" } },
            {
              "tagName": "span",
              "textContent": "This is a Shoelace alert component rendered by the Jx runtime."
            }
          ]
        }
      ]
    }
  ]
}
