{
  "title": "Markdown Blog — Jx Examples",
  "$layout": "./layouts/example.json",
  "imports": {
    "MarkdownCollection": "@jxsuite/parser/MarkdownCollection.class.json",
    "Markdown": "@jxsuite/parser/Markdown.class.json"
  },
  "state": {
    "posts": {
      "$prototype": "MarkdownCollection",
      "src": "../../content/posts/*.md",
      "sortBy": "frontmatter.date",
      "sortOrder": "desc"
    },
    "post": {
      "$prototype": "Markdown",
      "src": "../../content/posts/getting-started.md"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "grid",
        "gridTemplateColumns": "250px 1fr",
        "gap": "2rem"
      },
      "children": [
        {
          "tagName": "aside",
          "style": {
            "borderRight": "1px solid #e0e0e0",
            "paddingRight": "1.5rem"
          },
          "children": [
            {
              "tagName": "h2",
              "textContent": "Posts",
              "style": {
                "marginTop": "0",
                "fontSize": "1.25rem"
              }
            },
            {
              "tagName": "ul",
              "style": {
                "listStyle": "none",
                "padding": "0",
                "margin": "0"
              },
              "children": [
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/posts"
                  },
                  "map": {
                    "tagName": "li",
                    "style": {
                      "marginBottom": "1rem"
                    },
                    "children": [
                      {
                        "tagName": "span",
                        "style": {
                          "color": "#0066cc",
                          "fontWeight": "600"
                        },
                        "textContent": "${$map.item?.frontmatter?.title ?? ''}"
                      },
                      {
                        "tagName": "time",
                        "style": {
                          "display": "block",
                          "fontSize": "0.8rem",
                          "color": "#888"
                        },
                        "textContent": "${$map.item?.frontmatter?.date ?? ''}"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "main",
          "children": [
            {
              "tagName": "h1",
              "style": {
                "marginTop": "0"
              },
              "textContent": "${state.post?.frontmatter?.title ?? ''}"
            },
            {
              "tagName": "article",
              "children": "${state.post.$children}"
            }
          ]
        }
      ]
    }
  ]
}
