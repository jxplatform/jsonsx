{
  "title": "Markdown Blog — Jx Examples",
  "$layout": "./layouts/example.json",
  "imports": {
    "MarkdownCollection": "@jxsuite/parser/MarkdownCollection.class.json",
    "Markdown": "@jxsuite/parser/Markdown.class.json"
  },
  "state": {
    "posts": {
      "$prototype": "MarkdownCollection",
      "src": "../../content/posts/*.md",
      "sortBy": "frontmatter.date",
      "sortOrder": "desc"
    },
    "currentSlug": {
      "type": "string",
      "default": "getting-started"
    },
    "currentPost": {
      "$prototype": "Markdown",
      "src": "../../content/posts/${state.currentSlug}.md"
    },
    "selectPost": {
      "$prototype": "Function",
      "parameters": ["event"],
      "body": "event.preventDefault(); const slug = event.currentTarget.dataset?.slug; if (slug) state.currentSlug = slug;"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "grid",
        "gridTemplateColumns": "250px 1fr",
        "gap": "2rem"
      },
      "children": [
        {
          "tagName": "aside",
          "style": {
            "borderRight": "1px solid #e0e0e0",
            "paddingRight": "1.5rem"
          },
          "children": [
            {
              "tagName": "h2",
              "textContent": "Posts",
              "style": {
                "marginTop": "0",
                "fontSize": "1.25rem"
              }
            },
            {
              "tagName": "ul",
              "style": {
                "listStyle": "none",
                "padding": "0",
                "margin": "0"
              },
              "children": [
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/posts"
                  },
                  "map": {
                    "tagName": "li",
                    "style": {
                      "marginBottom": "1rem"
                    },
                    "children": [
                      {
                        "tagName": "a",
                        "style": {
                          "textDecoration": "none",
                          "color": "#0066cc",
                          "fontWeight": "600",
                          "cursor": "pointer",
                          ":hover": {
                            "textDecoration": "underline"
                          }
                        },
                        "textContent": "${$map.item?.frontmatter?.title ?? ''}",
                        "attributes": {
                          "data-slug": "${$map.item?.slug ?? ''}"
                        },
                        "onclick": {
                          "$ref": "#/state/selectPost"
                        }
                      },
                      {
                        "tagName": "time",
                        "style": {
                          "display": "block",
                          "fontSize": "0.8rem",
                          "color": "#888"
                        },
                        "textContent": "${$map.item?.frontmatter?.date ?? ''}"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "main",
          "children": [
            {
              "tagName": "h1",
              "style": {
                "marginTop": "0"
              },
              "textContent": "${state.currentPost?.frontmatter?.title ?? 'Loading…'}"
            },
            {
              "tagName": "article",
              "children": "${state.currentPost?.$children ?? []}"
            }
          ]
        }
      ]
    }
  ]
}
