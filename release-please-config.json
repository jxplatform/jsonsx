    "packages/runtime": {
      "release-type": "node",
      "component": "runtime",
      "extra-files": [
        {
          "type": "json",
          "glob": true,
          "path": "/packages/starters/sites/*/package.json",
          "jsonpath": "$.devDependencies[?(@property === '@jxsuite/runtime')]"
        },
        {
          "type": "json",
          "path": "/packages/create/template-versions.json",
          "jsonpath": "$.runtime"
        }
      ]
    },
