{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "types.d.ts",
    "packages/**/src/**/*",
    "packages/**/tests/**/*",
    "packages/schema/types.ts",
    "packages/schema/defs/**/*"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/assets"]
}
