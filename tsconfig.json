{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["types.d.ts", "packages/**/src/**/*", "packages/**/tests/**/*"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/assets"]
}
